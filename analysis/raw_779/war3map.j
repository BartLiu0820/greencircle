function BN7 takes nothing returns nothing
if MQ<1 then
if GetHeroStatBJ(bj_HEROSTAT_STR,Y7,false)>=1000 then
set MQ=1
else
if GetHeroStatBJ(bj_HEROSTAT_AGI,Y7,false)>=1000 then
set MQ=2
else
if GetHeroStatBJ(bj_HEROSTAT_INT,Y7,false)>=1000 then
set MQ=3
else
call DoNothing()
endif
endif
endif
else
endif
if Gz>=1. then
if MQ==1 then
call ModifyHeroStat(bj_HEROSTAT_STR,GetKillingUnitBJ(),bj_MODIFYMETHOD_ADD,2)
else
call ModifyHeroStat(bj_HEROSTAT_STR,GetKillingUnitBJ(),bj_MODIFYMETHOD_ADD,1)
endif
set Gz=Gz-1
else
set Gz=Gz+(I2R(GetUnitAbilityLevelSwapped($41304948,GetKillingUnitBJ()))*.15+.2)
endif
if G1>=1. then
if MQ==2 then
call ModifyHeroStat(bj_HEROSTAT_AGI,GetKillingUnitBJ(),bj_MODIFYMETHOD_ADD,2)
else
call ModifyHeroStat(bj_HEROSTAT_AGI,GetKillingUnitBJ(),bj_MODIFYMETHOD_ADD,1)
endif
set G1=G1-1
else
set G1=G1+(I2R(GetUnitAbilityLevelSwapped($41304949,GetKillingUnitBJ()))*.15+G3[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))])
endif
if G0>=2. then
if MQ==3 then
call ModifyHeroStat(bj_HEROSTAT_INT,GetKillingUnitBJ(),bj_MODIFYMETHOD_ADD,4)
else
call ModifyHeroStat(bj_HEROSTAT_INT,GetKillingUnitBJ(),bj_MODIFYMETHOD_ADD,2)
endif
set G0=G0-1
else
set G0=G0+(I2R(GetUnitAbilityLevelSwapped($41304947,GetKillingUnitBJ()))*.25+G3[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))])
endif
endfunction
