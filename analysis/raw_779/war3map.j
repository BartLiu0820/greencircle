if GetRandomInt(1,8)==1 and GetUnitAbilityLevelSwapped($41305044,J3)>=1 then
call IssuePointOrderLoc(J6[5],"silence",ZE)
set KB=KB+1
else
endif
if GetRandomInt(1,10)<=2 and GetUnitAbilityLevelSwapped($41305045,J3)>=1 and GetAttacker()==J3 then
call IssueTargetOrder(J6[1],"innerfire",J3)
call IssueImmediateOrder(J6[5],"lavamonster")
else
