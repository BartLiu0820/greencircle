call UnitRemoveAbilityBJ($41305455,GetTriggerUnit())
call UnitRemoveAbilityBJ($41305458,GetTriggerUnit())
call UnitRemoveAbilityBJ($4130545A,GetTriggerUnit())
if Ml==1 then
call UnitAddAbilityBJ($41305456,GetTriggerUnit())
if GetRandomInt(1,4)==2 then
call SetUnitAbilityLevelSwapped($41305456,GetTriggerUnit(),2)
else
call DoNothing()
endif
else
call DoNothing()
endif
if Ml==2 then
call UnitAddAbilityBJ($41305455,GetTriggerUnit())
if GetRandomInt(1,4)==2 then
call SetUnitAbilityLevelSwapped($41305455,GetTriggerUnit(),2)
else
call DoNothing()
endif
else
call DoNothing()
endif
if Ml==3 then
call UnitAddAbilityBJ($41305458,GetTriggerUnit())
if GetRandomInt(1,4)==2 then
call SetUnitAbilityLevelSwapped($41305458,GetTriggerUnit(),2)
else
call DoNothing()
endif
else
call DoNothing()
endif
if Ml==4 then
call UnitAddAbilityBJ($41305449,GetTriggerUnit())
if GetRandomInt(1,4)==2 then
call SetUnitAbilityLevelSwapped($41305449,GetTriggerUnit(),2)
else
call DoNothing()
endif
else
call DoNothing()
endif
if Ml==5 then
call UnitAddAbilityBJ($4130545A,GetTriggerUnit())
if GetRandomInt(1,4)==2 then
call SetUnitAbilityLevelSwapped($4130545A,GetTriggerUnit(),2)
else
call DoNothing()
endif
else
call DoNothing()
endif
if Ml==6 then
call UnitAddAbilityBJ($41305530,GetTriggerUnit())
else
call DoNothing()
endif
else
call DisplayTimedTextToPlayer(GetOwningPlayer(GetTriggerUnit()),0,0,5.,"|cffff0303魔法不足|r")
