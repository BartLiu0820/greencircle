if GetUnitAbilityLevelSwapped($41304757,GetAttacker())>=1 and GetPlayerTechCountSimple($52303039,GetOwningPlayer(GetAttacker()))!=GetHeroStatBJ(bj_HEROSTAT_STR,GetAttacker(),false)/50 then
