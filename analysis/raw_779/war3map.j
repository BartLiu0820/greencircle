if GetRandomInt(1,10)<=2 and GetUnitAbilityLevelSwapped($41305045,J3)>=1 and GetAttacker()==J5[1] then
call IssueTargetOrder(J6[1],"innerfire",J3)
call IssueImmediateOrder(J6[5],"lavamonster")
else
endif
