function BPM takes nothing returns nothing
call IssueImmediateOrder(GetAttacker(),"thunderclap")
call IssueImmediateOrder(GetAttacker(),"howlofterror")
call IssuePointOrderLoc(GetAttacker(),"silence",GetUnitLoc(GetAttacker()))
if jp($68646877,GetOwningPlayer(GetAttacker()))<=2 and GetUnitAbilityLevelSwapped($41304B4E,GetAttacker())==1 then
set PW=GetUnitLoc(GetAttackedUnitBJ())
if GetHeroStatBJ(bj_HEROSTAT_AGI,Y9,false)>=900 and DU[GetConvertedPlayerId(GetTriggerPlayer())]>=4 then
call UnitDamagePointLoc(GetAttacker(),.1,220.,PW,I2R(GetHeroStatBJ(bj_HEROSTAT_AGI,GetAttacker(),false))*(5.*I2R(GetHeroLevel(GetAttacker()))),ATTACK_TYPE_HERO,DAMAGE_TYPE_ENHANCED)
else
if GetHeroStatBJ(bj_HEROSTAT_AGI,Y9,false)>=700 then
call UnitDamagePointLoc(GetAttacker(),.1,220.,PW,I2R(GetHeroStatBJ(bj_HEROSTAT_AGI,GetAttacker(),false))*(3.5*I2R(GetHeroLevel(GetAttacker()))),ATTACK_TYPE_HERO,DAMAGE_TYPE_ENHANCED)
else
if GetHeroStatBJ(bj_HEROSTAT_AGI,Y9,false)>=500 then
call UnitDamagePointLoc(GetAttacker(),.1,220.,PW,I2R(GetHeroStatBJ(bj_HEROSTAT_AGI,GetAttacker(),false))*(2.5*I2R(GetHeroLevel(GetAttacker()))),ATTACK_TYPE_HERO,DAMAGE_TYPE_ENHANCED)
else
if GetHeroStatBJ(bj_HEROSTAT_AGI,Y9,false)>=300 then
call UnitDamagePointLoc(GetAttacker(),.1,220.,PW,I2R(GetHeroStatBJ(bj_HEROSTAT_AGI,GetAttacker(),false))*(2.*I2R(GetHeroLevel(GetAttacker()))),ATTACK_TYPE_HERO,DAMAGE_TYPE_ENHANCED)
else
if GetHeroStatBJ(bj_HEROSTAT_AGI,Y9,false)>=100 then
call UnitDamagePointLoc(GetAttacker(),.1,220.,PW,I2R(GetHeroStatBJ(bj_HEROSTAT_AGI,GetAttacker(),false))*(1.5*I2R(GetHeroLevel(GetAttacker()))),ATTACK_TYPE_HERO,DAMAGE_TYPE_ENHANCED)
else
call UnitDamagePointLoc(GetAttacker(),.1,220.,PW,I2R(GetHeroStatBJ(bj_HEROSTAT_AGI,GetAttacker(),false))*(1.*I2R(GetHeroLevel(GetAttacker()))),ATTACK_TYPE_HERO,DAMAGE_TYPE_ENHANCED)
endif
endif
endif
endif
endif
call CreateNUnitsAtLoc(1,$68646877,GetOwningPlayer(GetAttacker()),PW,bj_UNIT_FACING)
call SetUnitAbilityLevelSwapped($41636C66,GetLastCreatedUnit(),4)
