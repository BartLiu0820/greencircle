call SetTextTagVelocityBJ(GetLastCreatedTextTag(),80.,80.)
call SetTextTagFadepoint(GetLastCreatedTextTag(),1.)
call SetTextTagLifespan(GetLastCreatedTextTag(),1.)
else
if JN[4]==1 then
call UnitDamagePointLoc(Pp,.1,1000.,ZC,I2R(JS),ATTACK_TYPE_MAGIC,DAMAGE_TYPE_NORMAL)
call CreateTextTagUnitBJ("魔法"+I2S(JS),Pp,0,9.,100.,0.,0.,0)
