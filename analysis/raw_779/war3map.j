endfunction
function BQX takes nothing returns nothing
if GetUnitAbilityLevelSwapped($41305639,SN)<3 then
call IncUnitAbilityLevelSwapped($41305639,SN)
else
call SetUnitAbilityLevelSwapped($41305639,SN,1)
endif
if OT==1 then
call ModifyHeroStat(bj_HEROSTAT_STR,SN,bj_MODIFYMETHOD_SUB,OU/20)
else
if OT==2 then
call ModifyHeroStat(bj_HEROSTAT_AGI,SN,bj_MODIFYMETHOD_SUB,OU/20)
else
if OT==3 then
call ModifyHeroStat(bj_HEROSTAT_INT,SN,bj_MODIFYMETHOD_SUB,OU/20)
else
call DoNothing()
endif
endif
endif
if GetUnitAbilityLevelSwapped($41305639,SN)==1 then
call ModifyHeroStat(bj_HEROSTAT_STR,SN,bj_MODIFYMETHOD_ADD,OU/20)
set OT=1
else
if GetUnitAbilityLevelSwapped($41305639,SN)==2 then
call ModifyHeroStat(bj_HEROSTAT_AGI,SN,bj_MODIFYMETHOD_ADD,OU/20)
set OT=2
