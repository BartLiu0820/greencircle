function zq takes nothing returns nothing
set bj_forLoopAIndex=1
set bj_forLoopAIndexEnd=8
loop
exitwhen bj_forLoopAIndex>bj_forLoopAIndexEnd
set Nz[GetForLoopIndexA()]=jx(ConvertedPlayer(GetForLoopIndexA()),$6F766C6E)
set N0[GetForLoopIndexA()]=jy(ConvertedPlayer(GetForLoopIndexA()),Condition(function zn))
if CountUnitsInGroup(N0[GetForLoopIndexA()])>=1 then
call RemoveUnit(GroupPickRandomUnit(Nz[GetForLoopIndexA()]))
else
call DoNothing()
endif
call DestroyGroup(Nz[GetForLoopIndexA()])
call DestroyGroup(N0[GetForLoopIndexA()])
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
set JQ=JQ+1
set Np=Np+1
set Nr=Nr+1
if MM>=1 then
set MM=MM-1
else
call DoNothing()
endif
set bj_forLoopAIndex=1
set bj_forLoopAIndexEnd=8
loop
exitwhen bj_forLoopAIndex>bj_forLoopAIndexEnd
set Nc[GetForLoopIndexA()]=Nc[GetForLoopIndexA()]-1.
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
set JT=JT+1
set Mn=0+1+Mn
set JU=JU+1
set L1=L1+1
set ME=ME+1
set H2=jz($6E303142)
set Oe=GetUnitLoc(GroupPickRandomUnit(H2))
call IssuePointOrderLoc(FirstOfGroup(H2),"silence",Oe)
call RemoveLocation(Oe)
call DestroyGroup(H2)
set H2=jz($6E303239)
call IssueImmediateOrder(FirstOfGroup(H2),"howlofterror")
call DestroyGroup(H2)
set H2=jz($6E303241)
call IssueImmediateOrder(FirstOfGroup(H2),"stomp")
call DestroyGroup(H2)
set H2=jz($68303343)
call ForGroupBJ(H2,function zo)
call DestroyGroup(H2)
set H2=jz($68303344)
call ForGroupBJ(H2,function zp)
call DestroyGroup(H2)
set H2=jz($6E303636)
set Oe=GetUnitLoc(GroupPickRandomUnit(H2))
set VV=GetRandomDirectionDeg()
call IssuePointOrder(GroupPickRandomUnit(H2),"attack",GetLocationX(Oe)+CosBJ(VV)*256.,GetLocationY(Oe)+SinBJ(VV)*256.)
call RemoveLocation(Oe)
call DestroyGroup(H2)
endfunction
