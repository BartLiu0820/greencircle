function BIp takes nothing returns nothing
if GetPlayerState(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_GOLD)>=1500 and GetPlayerState(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_LUMBER)>=5 and GetPlayerState(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_FOOD_CAP)-GetPlayerState(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_FOOD_USED)>=4 then
if GetSpellAbilityId()==$41304446 and CountUnitsInGroup(jz($4870616C))==0 and CountUnitsInGroup(jz($68303146))==0 then
call RemoveUnit(GetTriggerUnit())
set Oe=GetUnitLoc(GetTriggerUnit())
call AddSpecialEffectLocBJ(Oe,"Abilities\\Spells\\Human\\Thunderclap\\ThunderClapCaster.mdl")
call DestroyEffect(GetLastCreatedEffectBJ())
call CreateNUnitsAtLoc(1,$68303146,GetTriggerPlayer(),Oe,bj_UNIT_FACING)
call CreateNUnitsAtLoc(1,$4870616C,GetTriggerPlayer(),OffsetLocation(Oe,15.,0),bj_UNIT_FACING)
set R6=GetLastCreatedUnit()
call RemoveLocation(Oe)
call ModifyHeroSkillPoints(GetLastCreatedUnit(),bj_MODIFYMETHOD_ADD,3)
set DR[GetConvertedPlayerId(GetTriggerPlayer())]=GetRandomInt(0,7)
set DS[GetConvertedPlayerId(GetTriggerPlayer())]=GetRandomInt(0,7-DR[GetConvertedPlayerId(GetTriggerPlayer())])
set DT[GetConvertedPlayerId(GetTriggerPlayer())]=7-(DR[GetConvertedPlayerId(GetTriggerPlayer())]+DS[GetConvertedPlayerId(GetTriggerPlayer())])
call DisplayTimedTextToPlayer(GetOwningPlayer(GetTriggerUnit()),0,0,5.,"|cff20c000英雄成长值(每次升级获得属性自动分配)|r:")
