call TriggerRegisterAnyUnitEventBJ(Z7,EVENT_PLAYER_UNIT_ATTACKED)
call TriggerAddCondition(Z7,Condition(function BLK))
call TriggerAddAction(Z7,function BLL)
endfunction
function BLN takes nothing returns boolean
return GetSpellAbilityId()==$41304545
endfunction
function BLO takes nothing returns nothing
set Oe=GetUnitLoc(GetTriggerUnit())
call CreateNUnitsAtLoc(1,$6E303350,GetOwningPlayer(GetTriggerUnit()),Oe,bj_UNIT_FACING)
call SetUnitAbilityLevelSwapped($41304538,GetLastCreatedUnit(),GetHeroStatBJ(bj_HEROSTAT_INT,R7,false)/28)
call UnitApplyTimedLifeBJ(5.,$42726169,GetLastCreatedUnit())
call IssuePointOrder(GetLastCreatedUnit(),"stampede",GetUnitX(GetTriggerUnit()),GetUnitY(GetTriggerUnit())+SinBJ(GetRandomDirectionDeg())*256.)
call RemoveLocation(Oe)
endfunction
function BLP takes nothing returns nothing
set Z8=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(Z8,EVENT_PLAYER_UNIT_SPELL_CAST)
call TriggerAddCondition(Z8,Condition(function BLN))
call TriggerAddAction(Z8,function BLO)
endfunction
function BLQ takes nothing returns boolean
return GetSpellAbilityId()==$41304549
endfunction
function BLR takes nothing returns boolean
return GetUnitStateSwap(UNIT_STATE_MAX_LIFE,GetFilterUnit())==119.
endfunction
function BLS takes nothing returns nothing
call SetUnitPosition(GetEnumUnit(),GetLocationX(GetUnitLoc(GetTriggerUnit()))+I2R(GetRandomInt(-50,50)),GetLocationY(GetUnitLoc(GetTriggerUnit()))+I2R(GetRandomInt(-50,50)))
if GetUnitMoveSpeed(GetEnumUnit())<100. then
call RemoveUnit(GetEnumUnit())
else
call DoNothing()
endif
endfunction
function BLT takes nothing returns nothing
set H2=jy(GetOwningPlayer(GetTriggerUnit()),Condition(function BLR))
call ForGroupBJ(H2,function BLS)
call DestroyGroup(H2)
endfunction
function BLU takes nothing returns nothing
set Z9=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(Z9,EVENT_PLAYER_UNIT_SPELL_CAST)
call TriggerAddCondition(Z9,Condition(function BLQ))
call TriggerAddAction(Z9,function BLT)
endfunction
function BLV takes nothing returns boolean
return GetSpellAbilityId()==$41304657
endfunction
function BLW takes nothing returns nothing
set W2=GetUnitLoc(GetTriggerUnit())
if GetHeroStatBJ(bj_HEROSTAT_INT,R7,false)>=400 then
call CreateNUnitsAtLoc(1,$6E303455,GetOwningPlayer(GetTriggerUnit()),W2,bj_UNIT_FACING)
call UnitApplyTimedLifeBJ(6.,$42726169,GetLastCreatedUnit())
else
if GetHeroStatBJ(bj_HEROSTAT_INT,R7,false)>=300 then
call CreateNUnitsAtLoc(1,$6E303456,GetOwningPlayer(GetTriggerUnit()),W2,bj_UNIT_FACING)
call UnitApplyTimedLifeBJ(6.,$42726169,GetLastCreatedUnit())
else
if GetHeroStatBJ(bj_HEROSTAT_INT,R7,false)>=200 then
call CreateNUnitsAtLoc(1,$6E303459,GetOwningPlayer(GetTriggerUnit()),W2,bj_UNIT_FACING)
call UnitApplyTimedLifeBJ(6.,$42726169,GetLastCreatedUnit())
else
if GetHeroStatBJ(bj_HEROSTAT_INT,R7,false)>=100 then
call CreateNUnitsAtLoc(1,$6E303458,GetOwningPlayer(GetTriggerUnit()),W2,bj_UNIT_FACING)
call UnitApplyTimedLifeBJ(6.,$42726169,GetLastCreatedUnit())
else
if GetHeroStatBJ(bj_HEROSTAT_INT,R7,false)<=99 then
call CreateNUnitsAtLoc(1,$6E303457,GetOwningPlayer(GetTriggerUnit()),W2,bj_UNIT_FACING)
call UnitApplyTimedLifeBJ(6.,$42726169,GetLastCreatedUnit())
else
call DoNothing()
endif
endif
endif
endif
endif
call RemoveLocation(W2)
call DestroyGroup(H2)
if GetUnitAbilityLevelSwapped($41304657,GetTriggerUnit())<GetHeroStatBJ(bj_HEROSTAT_INT,GetTriggerUnit(),false)/100+1 and GetUnitAbilityLevelSwapped($41304657,GetTriggerUnit())<5 then
call SetUnitAbilityLevelSwapped($41304657,GetTriggerUnit(),GetHeroStatBJ(bj_HEROSTAT_INT,GetTriggerUnit(),false)/100+1)
else
call DoNothing()
endif
endfunction
function BLX takes nothing returns nothing
set aB=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(aB,EVENT_PLAYER_UNIT_SPELL_CAST)
call TriggerAddCondition(aB,Condition(function BLV))
call TriggerAddAction(aB,function BLW)
endfunction
function BLY takes nothing returns boolean
return GetUnitTypeId(GetAttacker())==$4830345A
endfunction
function BLZ takes nothing returns nothing
if GetHeroStatBJ(bj_HEROSTAT_STR,GetAttacker(),false)>GetUnitAbilityLevelSwapped($41304547,GetAttacker())*35+34 and GetUnitAbilityLevelSwapped($41304547,GetAttacker())<10 then
call SetUnitAbilityLevelSwapped($41304547,GetAttacker(),GetHeroStatBJ(bj_HEROSTAT_STR,GetAttacker(),false)/35)
else
call DoNothing()
endif
if GetHeroStatBJ(bj_HEROSTAT_STR,GetAttacker(),false)>GetUnitAbilityLevelSwapped($41304549,GetAttacker())*30+29 and GetUnitAbilityLevelSwapped($41304549,GetAttacker())<6 then
call SetUnitAbilityLevelSwapped($41304549,GetAttacker(),GetHeroStatBJ(bj_HEROSTAT_STR,GetAttacker(),false)/30)
else
call DoNothing()
endif
endfunction
function BLa takes nothing returns nothing
set aC=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(aC,EVENT_PLAYER_UNIT_ATTACKED)
call TriggerAddCondition(aC,Condition(function BLY))
call TriggerAddAction(aC,function BLZ)
endfunction
function BLb takes nothing returns boolean
return GetUnitTypeId(GetConstructedStructure())==$68303530
endfunction
function BLc takes nothing returns nothing
if CountUnitsInGroup(jz($68303530))>1 or CountUnitsInGroup(jz($4830345A))>1 then
call RemoveUnit(GetConstructedStructure())
call SetPlayerStateBJ(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_GOLD)+1500)
call SetPlayerStateBJ(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_LUMBER,GetPlayerState(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_LUMBER)+5)
set XN=GetRandomLocInRect(s)
call CreateNUnitsAtLoc(1,$6F766C6E,GetTriggerPlayer(),XN,bj_UNIT_FACING)
call RemoveLocation(XN)
call DisplayTextToForce(jq(GetTriggerPlayer()),"|cffff0303全场只能建造一个|r")
else
if jp($6E303343,GetTriggerPlayer())>=1 or H4[GetConvertedPlayerId(GetTriggerPlayer())]>=10 then
call DoNothing()
else
call RemoveUnit(GetConstructedStructure())
endif
endif
endfunction
function BLd takes nothing returns nothing
set aD=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(aD,EVENT_PLAYER_UNIT_CONSTRUCT_FINISH)
call TriggerAddCondition(aD,Condition(function BLb))
call TriggerAddAction(aD,function BLc)
endfunction
function BLe takes nothing returns boolean
return GetUnitTypeId(GetConstructingStructure())==$68303530
endfunction
function BLf takes nothing returns nothing
if CountUnitsInGroup(jz($68303530))>1 or CountUnitsInGroup(jz($4830345A))>1 then
call DoNothing()
else
if jp($6E303343,GetTriggerPlayer())<1 and H4[GetConvertedPlayerId(GetTriggerPlayer())]<10 then
set XN=GetRandomLocInRect(s)
call CreateNUnitsAtLoc(1,$6F766C6E,GetTriggerPlayer(),XN,bj_UNIT_FACING)
call RemoveLocation(XN)
call SetPlayerStateBJ(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_GOLD)+1500)
call SetPlayerStateBJ(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_LUMBER,GetPlayerState(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_LUMBER)+5)
call DisplayTextToForce(jq(GetTriggerPlayer()),"|cffff0303需要10点成就|r")
else
endif
endif
endfunction
function BLg takes nothing returns nothing
set aE=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(aE,EVENT_PLAYER_UNIT_CONSTRUCT_START)
call TriggerAddCondition(aE,Condition(function BLe))
call TriggerAddAction(aE,function BLf)
endfunction
function BLh takes nothing returns nothing
if GetUnitTypeId(GetConstructedStructure())==$68303530 and CountUnitsInGroup(jz($68303530))<=1 and CountUnitsInGroup(jz($4830345A))<=1 and H4[GetConvertedPlayerId(GetTriggerPlayer())]>=10 or jp($6E303343,GetTriggerPlayer())>=1 then
if jp($6E303343,GetTriggerPlayer())>=1 then
set H4[GetConvertedPlayerId(GetOwningPlayer(GetDyingUnit()))]=H4[GetConvertedPlayerId(GetOwningPlayer(GetDyingUnit()))]+10
else
call DoNothing()
endif
set Oe=GetUnitLoc(GetTriggerUnit())
set H4[GetConvertedPlayerId(GetTriggerPlayer())]=H4[GetConvertedPlayerId(GetTriggerPlayer())]-10
call CreateNUnitsAtLoc(1,$4830345A,GetOwningPlayer(GetTriggerUnit()),Oe,bj_UNIT_FACING)
set R7=GetLastCreatedUnit()
if lo(GetTriggerPlayer(),"赞+7")>=1400 or IV[GetConvertedPlayerId(GetTriggerPlayer())]>=1 and Kl[GetConvertedPlayerId(GetTriggerPlayer())]==0 then
call SetUnitVertexColor(GetLastCreatedUnit(),0,0,0,255)
call UnitAddAbilityBJ($41303950,GetLastCreatedUnit())
else
call DoNothing()
endif
call SetUnitX(bj_lastCreatedUnit,GetUnitX(bj_lastCreatedUnit)+CosBJ(270.)*10.)
call RemoveLocation(Oe)
call ModifyHeroSkillPoints(GetLastCreatedUnit(),bj_MODIFYMETHOD_ADD,3)
set DR[GetConvertedPlayerId(GetTriggerPlayer())]=GetRandomInt(0,7)
set DS[GetConvertedPlayerId(GetTriggerPlayer())]=GetRandomInt(0,7-DR[GetConvertedPlayerId(GetTriggerPlayer())])
set DT[GetConvertedPlayerId(GetTriggerPlayer())]=7-(DR[GetConvertedPlayerId(GetTriggerPlayer())]+DS[GetConvertedPlayerId(GetTriggerPlayer())])
call DisplayTimedTextToPlayer(GetOwningPlayer(GetTriggerUnit()),0,0,5.,"|cff20c000英雄成长值(每次升级获得属性自动分配)|r:")
call DisplayTextToPlayer(GetTriggerPlayer(),0,0,"|cffff0303力量:     "+(I2S(DR[GetConvertedPlayerId(GetTriggerPlayer())]+1)+"|r"))
call DisplayTextToPlayer(GetTriggerPlayer(),0,0,"|c00fffc01敏捷:     "+(I2S(DS[GetConvertedPlayerId(GetTriggerPlayer())]+1)+"|r"))
call DisplayTextToPlayer(GetTriggerPlayer(),0,0,"|cff0042ff智力:     "+(I2S(DT[GetConvertedPlayerId(GetTriggerPlayer())]+1)+"|r"))
else
endif
endfunction
function BLi takes nothing returns nothing
set aF=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(aF,EVENT_PLAYER_UNIT_CONSTRUCT_FINISH)
call TriggerAddAction(aF,function BLh)
endfunction
function BLj takes nothing returns boolean
return DU[GetConvertedPlayerId(GetTriggerPlayer())]<4 and GetSpellAbilityId()==$41304542 or GetSpellAbilityId()==$41304541 or GetSpellAbilityId()==$41304548 or GetSpellAbilityId()==$4130454A or GetSpellAbilityId()==$41304656
endfunction
function BLk takes nothing returns nothing
if GetPlayerState(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_LUMBER)>=1*(DU[GetConvertedPlayerId(GetTriggerPlayer())]*18) and GetHeroStatBJ(bj_HEROSTAT_STR,GetTriggerUnit(),true)>=DU[GetConvertedPlayerId(GetTriggerPlayer())]*80 then
if GetSpellAbilityId()==$41304542 and GetUnitAbilityLevelSwapped($41304545,GetTriggerUnit())!=1 then
set Oe=GetUnitLoc(GetTriggerUnit())
call AddSpecialEffectLocBJ(Oe,"Abilities\\Spells\\Human\\Resurrect\\ResurrectTarget.mdl")
call DestroyEffect(GetLastCreatedEffectBJ())
call RemoveLocation(Oe)
call UnitAddAbilityBJ($41304545,GetTriggerUnit())
call SetPlayerStateBJ(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_LUMBER,GetPlayerState(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_LUMBER)-1*(DU[GetConvertedPlayerId(GetTriggerPlayer())]*18))
set DU[GetConvertedPlayerId(GetTriggerPlayer())]=DU[GetConvertedPlayerId(GetTriggerPlayer())]+1
else
if GetSpellAbilityId()==$41304541 and GetUnitAbilityLevelSwapped($41304544,GetTriggerUnit())!=1 then
set Oe=GetUnitLoc(GetTriggerUnit())
call AddSpecialEffectLocBJ(Oe,"Abilities\\Spells\\Human\\Resurrect\\ResurrectTarget.mdl")
call DestroyEffect(GetLastCreatedEffectBJ())
call RemoveLocation(Oe)
call UnitAddAbilityBJ($41304544,GetTriggerUnit())
call CreateNUnitsAtLoc(1,$68303458,GetOwningPlayer(GetTriggerUnit()),OffsetLocation(GetUnitLoc(GetTriggerUnit()),0.,0),bj_UNIT_FACING)
call SetPlayerStateBJ(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_LUMBER,GetPlayerState(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_LUMBER)-1*(DU[GetConvertedPlayerId(GetTriggerPlayer())]*18))
set DU[GetConvertedPlayerId(GetTriggerPlayer())]=DU[GetConvertedPlayerId(GetTriggerPlayer())]+1
else
if GetSpellAbilityId()==$41304548 and GetUnitAbilityLevelSwapped($41304547,GetTriggerUnit())<1 then
set Oe=GetUnitLoc(GetTriggerUnit())
call AddSpecialEffectLocBJ(Oe,"Abilities\\Spells\\Human\\Resurrect\\ResurrectTarget.mdl")
call DestroyEffect(GetLastCreatedEffectBJ())
call RemoveLocation(Oe)
call UnitAddAbilityBJ($41304547,GetTriggerUnit())
call SetPlayerStateBJ(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_LUMBER,GetPlayerState(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_LUMBER)-1*(DU[GetConvertedPlayerId(GetTriggerPlayer())]*18))
set DU[GetConvertedPlayerId(GetTriggerPlayer())]=DU[GetConvertedPlayerId(GetTriggerPlayer())]+1
else
if GetSpellAbilityId()==$4130454A and GetUnitAbilityLevelSwapped($41304549,GetTriggerUnit())<1 then
set Oe=GetUnitLoc(GetTriggerUnit())
call AddSpecialEffectLocBJ(Oe,"Abilities\\Spells\\Human\\Resurrect\\ResurrectTarget.mdl")
call DestroyEffect(GetLastCreatedEffectBJ())
call RemoveLocation(Oe)
call UnitAddAbilityBJ($41304549,GetTriggerUnit())
call SetPlayerStateBJ(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_LUMBER,GetPlayerState(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_LUMBER)-1*(DU[GetConvertedPlayerId(GetTriggerPlayer())]*18))
set DU[GetConvertedPlayerId(GetTriggerPlayer())]=DU[GetConvertedPlayerId(GetTriggerPlayer())]+1
else
if GetSpellAbilityId()==$41304656 and GetUnitAbilityLevelSwapped($41304657,GetTriggerUnit())<1 and GetUnitAbilityLevelSwapped($41304549,GetTriggerUnit())>=1 and GetHeroStatBJ(bj_HEROSTAT_STR,GetTriggerUnit(),false)>=180 then
set Oe=GetUnitLoc(GetTriggerUnit())
call AddSpecialEffectLocBJ(Oe,"Abilities\\Spells\\Human\\Resurrect\\ResurrectTarget.mdl")
call DestroyEffect(GetLastCreatedEffectBJ())
call RemoveLocation(Oe)
call UnitAddAbilityBJ($41304657,GetTriggerUnit())
call SetPlayerStateBJ(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_LUMBER,GetPlayerState(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_LUMBER)-1*(DU[GetConvertedPlayerId(GetTriggerPlayer())]*18))
set DU[GetConvertedPlayerId(GetTriggerPlayer())]=DU[GetConvertedPlayerId(GetTriggerPlayer())]+1
else
if GetSpellAbilityId()==$41304656 and GetUnitAbilityLevelSwapped($41304657,GetTriggerUnit())<1 and GetHeroStatBJ(bj_HEROSTAT_STR,GetTriggerUnit(),false)<180 or GetUnitAbilityLevelSwapped($41304549,GetTriggerUnit())<1 then
call DisplayTextToPlayer(GetOwningPlayer(GetSpellAbilityUnit()),0,0,"|cffff0303条件不足|r")
else
call DisplayTextToPlayer(GetOwningPlayer(GetSpellAbilityUnit()),0,0,"|cffff0303你已经学习了这个技能|r")
endif
endif
endif
endif
endif
endif
else
call DisplayTextToPlayer(GetOwningPlayer(GetSpellAbilityUnit()),0,0,"|cffff0303条件不足|r")
endif
endfunction
function BLl takes nothing returns nothing
