function gV takes nothing returns integer
local integer BR=Bb
if BR!=0 then
set Bb=Bc[BR]
else
set Bd=Bd+1
set BR=Bd
endif
if BR>8190 then
return 0
endif
set Be[BR]=1
set Bc[BR]=-1
return BR
endfunction
function gY takes nothing returns integer
local integer BR=Yh
if BR!=0 then
set Yh=Yi[BR]
else
set Yj=Yj+1
set BR=Yj
endif
if BR>1022 then
return 0
endif
set BW[BR]=(BR-1)*8
set BY[BR]=(BR-1)*8
set Yk[BR]=7
set Yi[BR]=-1
return BR
endfunction
function ga takes nothing returns integer
local integer BR=gV()
local integer Bf
if BR==0 then
return 0
endif
set Be[BR]=2
set Bf=BR
return BR
endfunction
function gb takes nothing returns nothing
set BQ=InitHashtable()
set Bh=InitHashtable()
endfunction
function gf takes unit BF,integer Vo,integer Vp,integer Vq returns string
return EXGetAbilityDataString(EXGetUnitAbility(BF,Vo),Vp,Vq)
endfunction
function gi takes unit BF,integer Vo,integer Vp,integer Vq,real Oq returns boolean
return EXSetAbilityDataReal(EXGetUnitAbility(BF,Vo),Vp,Vq,Oq)
endfunction
function gj takes unit BF,integer Vo,integer Vp,integer Vq,string Oq returns boolean
return EXSetAbilityDataString(EXGetUnitAbility(BF,Vo),Vp,Vq,Oq)
endfunction
function jP takes unit ef,unit B2 returns real
return bj_RADTODEG*Atan2(GetUnitY(B2)-GetUnitY(ef),GetUnitX(B2)-GetUnitX(ef))
endfunction
function jm takes nothing returns boolean
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,0,30,"|cFF1E90FF当前编辑器版本为： |r|cFF00FF00YDWE 1.32.12.200327")
return false
endfunction
function jn takes nothing returns nothing
local trigger Bn=CreateTrigger()
local integer BT=0
loop
exitwhen BT==12
call TriggerRegisterPlayerChatEvent(Bn,Player(BT),"YDWE Version",true)
set BT=BT+1
endloop
call TriggerAddCondition(Bn,Condition(function jm))
set Bn=null
endfunction
function jo takes nothing returns nothing
set BQ=InitHashtable()
set Bi=GetCameraBoundMinX()-GetCameraMargin(CAMERA_MARGIN_LEFT)
set Bj=GetCameraBoundMinY()-GetCameraMargin(CAMERA_MARGIN_BOTTOM)
set Bk=GetCameraBoundMaxX()+GetCameraMargin(CAMERA_MARGIN_RIGHT)
set Bl=GetCameraBoundMaxY()+GetCameraMargin(CAMERA_MARGIN_TOP)
set Bm[0]="|cFFFF0303"
set Bm[1]="|cFF0042FF"
set Bm[2]="|cFF1CE6B9"
set Bm[3]="|cFF540081"
set Bm[4]="|cFFFFFC01"
set Bm[5]="|cFFFE8A0E"
set Bm[6]="|cFF20C000"
set Bm[7]="|cFFE55BB0"
set Bm[8]="|cFF959697"
set Bm[9]="|cFF7EBFF1"
set Bm[10]="|cFF106246"
set Bm[11]="|cFF4E2A04"
set Bm[12]="|cFF282828"
set Bm[13]="|cFF282828"
set Bm[14]="|cFF282828"
set Bm[15]="|cFF282828"
call jn()
endfunction
function jp takes integer Ov,player Ow returns integer
local group Ox
local integer Oy
set Ox=CreateGroup()
set bj_livingPlayerUnitsTypeId=Ov
call GroupEnumUnitsOfPlayer(Ox,Ow,filterLivingPlayerUnitsOfTypeId)
set Oy=CountUnitsInGroup(Ox)
call DestroyGroup(Ox)
set Ox=null
return Oy
endfunction
function jq takes player Ow returns force
local force Bp=CreateForce()
call ForceAddPlayer(Bp,Ow)
set O2=Bp
set Bp=null
return O2
endfunction
function jr takes unit Pe,integer Pf returns item
local integer Ce=0
loop
set Pg=UnitItemInSlot(Pe,Ce)
if GetItemTypeId(Pg)==Pf then
return Pg
endif
set Ce=Ce+1
exitwhen Ce>=bj_MAX_INVENTORY
endloop
return null
endfunction
function js takes mapcontrol Oz returns force
local force Bp=CreateForce()
local integer O0
local player O1
set O0=0
loop
set O1=Player(O0)
if GetPlayerController(O1)==Oz then
call ForceAddPlayer(Bp,O1)
endif
set O0=O0+1
exitwhen O0==bj_MAX_PLAYER_SLOTS
endloop
set O1=null
set O2=Bp
set Bp=null
return O2
endfunction
function jt takes nothing returns nothing
if bj_randomSubGroupWant>0 then
if bj_randomSubGroupWant>=bj_randomSubGroupTotal or GetRandomInt(1,bj_randomSubGroupTotal)<=bj_randomSubGroupWant then
call GroupAddUnit(bj_randomSubGroupGroup,GetEnumUnit())
set bj_randomSubGroupWant=bj_randomSubGroupWant-1
endif
endif
set bj_randomSubGroupTotal=bj_randomSubGroupTotal-1
endfunction
function ju takes real aj,location ak,boolexpr PF returns group
local group Ox=CreateGroup()
call GroupEnumUnitsInRangeOfLoc(Ox,ak,aj,PF)
call DestroyBoolExpr(PF)
set O5=Ox
set Ox=null
return O5
endfunction
function jv takes rect O4,boolexpr PF returns group
local group Ox=CreateGroup()
call GroupEnumUnitsInRect(Ox,O4,PF)
call DestroyBoolExpr(PF)
set O5=Ox
set Ox=null
return O5
endfunction
function jw takes rect O4,player Ow returns group
local group Ox=CreateGroup()
set bj_groupEnumOwningPlayer=Ow
call GroupEnumUnitsInRect(Ox,O4,filterGetUnitsInRectOfPlayer)
set O5=Ox
set Ox=null
return O5
endfunction
function jx takes player Ow,integer PB returns group
local group Ox=CreateGroup()
set bj_groupEnumTypeId=PB
call GroupEnumUnitsOfPlayer(Ox,Ow,filterGetUnitsOfPlayerAndTypeId)
set O5=Ox
set Ox=null
return O5
endfunction
function jy takes player Ow,boolexpr PF returns group
local group Ox=CreateGroup()
call GroupEnumUnitsOfPlayer(Ox,Ow,PF)
call DestroyBoolExpr(PF)
set O5=Ox
set Ox=null
return O5
endfunction
function jz takes integer PB returns group
local group PC=CreateGroup()
local group Ox=CreateGroup()
local integer Ce
set Ce=0
loop
set bj_groupEnumTypeId=PB
call GroupClear(Ox)
call GroupEnumUnitsOfPlayer(Ox,Player(Ce),filterGetUnitsOfTypeIdAll)
call GroupAddGroup(Ox,PC)
set Ce=Ce+1
exitwhen Ce==bj_MAX_PLAYER_SLOTS
endloop
call DestroyGroup(Ox)
set Ox=null
set O5=PC
set PC=null
return O5
endfunction
function j0 takes boolean PP returns nothing
local integer Ce
local player O1
local group Ox
set bj_pauseAllUnitsFlag=PP
set Ox=CreateGroup()
set Ce=0
loop
set O1=Player(Ce)
if GetPlayerController(O1)==MAP_CONTROL_COMPUTER then
call PauseCompAI(O1,PP)
endif
call GroupEnumUnitsOfPlayer(Ox,O1,null)
call ForGroup(Ox,function PauseAllUnitsBJEnum)
call GroupClear(Ox)
set Ce=Ce+1
exitwhen Ce==bj_MAX_PLAYER_SLOTS
endloop
call DestroyGroup(Ox)
set Ox=null
endfunction
function j2 takes real O6 returns nothing
local timer Bn
local real O7
if O6>0 then
set Bn=CreateTimer()
call TimerStart(Bn,O6,false,null)
loop
set O7=TimerGetRemaining(Bn)
exitwhen O7<=0
if O7>bj_POLLED_WAIT_SKIP_THRESHOLD then
call TriggerSleepAction(.1*O7)
else
call TriggerSleepAction(bj_POLLED_WAIT_INTERVAL)
endif
endloop
call DestroyTimer(Bn)
endif
set Bn=null
endfunction
function j3 takes integer BT returns string
return SubString("ABCDEFGHIJKLMNOPQRSTUVWXYZ",BT,BT+1)
endfunction
function j4 takes integer Qe returns gamecache
if Qf[Qe]==null then
set Qf[Qe]=InitGameCache("11billing@"+j3(Qe))
endif
return Qf[Qe]
endfunction
function j5 takes player Om,string Op returns integer
return GetStoredInteger(j4(GetPlayerId(Om)),"状态",Op)
endfunction
function j6 takes player Om,string Op returns integer
return GetStoredInteger(j4(GetPlayerId(Om)),"道具",Op)
endfunction
function j7 takes player Om,string Op returns boolean
return HaveStoredInteger(j4(GetPlayerId(Om)),"状态",Op)
endfunction
function j9 takes unit Pe,integer Un,integer Uo returns unit
local unit Uq=Pe
local unit Ur
local boolean Up
local integer Ce
local item Ut
local real Us
if Pe==null then
set bj_lastReplacedUnit=Pe
return bj_lastReplacedUnit
endif
set Up=IsUnitHidden(Uq)
call ShowUnit(Uq,false)
if Un==$75676F6C then
set Ur=CreateBlightedGoldmine(GetOwningPlayer(Uq),GetUnitX(Uq),GetUnitY(Uq),GetUnitFacing(Uq))
else
set Ur=CreateUnit(GetOwningPlayer(Uq),Un,GetUnitX(Uq),GetUnitY(Uq),GetUnitFacing(Uq))
endif
if Uo==bj_UNIT_STATE_METHOD_RELATIVE then
if GetUnitState(Uq,UNIT_STATE_MAX_LIFE)>0 then
set Us=GetUnitState(Uq,UNIT_STATE_LIFE)/GetUnitState(Uq,UNIT_STATE_MAX_LIFE)
call SetUnitState(Ur,UNIT_STATE_LIFE,Us*GetUnitState(Ur,UNIT_STATE_MAX_LIFE))
endif
if GetUnitState(Uq,UNIT_STATE_MAX_MANA)>0 and GetUnitState(Ur,UNIT_STATE_MAX_MANA)>0 then
set Us=GetUnitState(Uq,UNIT_STATE_MANA)/GetUnitState(Uq,UNIT_STATE_MAX_MANA)
call SetUnitState(Ur,UNIT_STATE_MANA,Us*GetUnitState(Ur,UNIT_STATE_MAX_MANA))
endif
elseif Uo==bj_UNIT_STATE_METHOD_ABSOLUTE then
call SetUnitState(Ur,UNIT_STATE_LIFE,GetUnitState(Uq,UNIT_STATE_LIFE))
if GetUnitState(Ur,UNIT_STATE_MAX_MANA)>0 then
call SetUnitState(Ur,UNIT_STATE_MANA,GetUnitState(Uq,UNIT_STATE_MANA))
endif
elseif Uo==bj_UNIT_STATE_METHOD_DEFAULTS then
elseif Uo==bj_UNIT_STATE_METHOD_MAXIMUM then
call SetUnitState(Ur,UNIT_STATE_LIFE,GetUnitState(Ur,UNIT_STATE_MAX_LIFE))
call SetUnitState(Ur,UNIT_STATE_MANA,GetUnitState(Ur,UNIT_STATE_MAX_MANA))
else
endif
call SetResourceAmount(Ur,GetResourceAmount(Uq))
if IsUnitType(Uq,UNIT_TYPE_HERO) and IsUnitType(Ur,UNIT_TYPE_HERO) then
call SetHeroXP(Ur,GetHeroXP(Uq),false)
set Ce=0
loop
set Ut=UnitItemInSlot(Uq,Ce)
if Ut!=null then
call UnitRemoveItem(Uq,Ut)
call UnitAddItem(Ur,Ut)
endif
set Ce=Ce+1
exitwhen Ce>=bj_MAX_INVENTORY
endloop
endif
if Up then
call KillUnit(Uq)
call RemoveUnit(Uq)
else
call RemoveUnit(Uq)
endif
set bj_lastReplacedUnit=Ur
set Uq=null
set Ur=null
set Ut=null
return bj_lastReplacedUnit
endfunction
function kB takes player Om returns boolean
return GetPlayerSlotState(Om)==PLAYER_SLOT_STATE_PLAYING and GetPlayerController(Om)==MAP_CONTROL_USER
endfunction
function kC takes nothing returns player
local integer BT=0
loop
exitwhen kB(Player(BT)) or BT>=11
set BT=BT+1
endloop
return Player(BT)
endfunction
function kD takes string Os,string Op,integer Ot returns nothing
if not kB(Ou) then
set Ou=kC()
endif
call StoreInteger(Bo,Os,Op,Ot)
if GetLocalPlayer()==Ou then
call SyncStoredInteger(Bo,Os,Op)
endif
endfunction
function kF takes nothing returns nothing
call FlushGameCache(InitGameCache("11.x"))
set Bo=InitGameCache("11.x")
endfunction
function kG takes trigger Qu,rect O4 returns event
local region Qv=CreateRegion()
call RegionAddRect(Qv,O4)
set Qw=Qv
set Qv=null
return TriggerRegisterEnterRegion(Qu,Qw,null)
endfunction
function kH takes unit Pe,integer Pf returns boolean
local integer Ce=0
if Pf!=0 then
loop
if GetItemTypeId(UnitItemInSlot(Pe,Ce))==Pf then
return true
endif
set Ce=Ce+1
exitwhen Ce>=bj_MAX_INVENTORY
endloop
endif
return false
endfunction
function kI takes integer PU,group PV returns group
set bj_randomSubGroupGroup=CreateGroup()
set bj_randomSubGroupWant=PU
set bj_randomSubGroupTotal=CountUnitsInGroup(PV)
if bj_randomSubGroupWant<=0 or bj_randomSubGroupTotal<=0 then
return bj_randomSubGroupGroup
endif
call ForGroup(PV,function jt)
return bj_randomSubGroupGroup
endfunction
function kL takes integer BT returns string
return SubString("ABCDEFGHIJKLMNOPQRSTUVWXYZ",BT,BT+1)
endfunction
function kM takes player Om,string Op returns integer
return GetStoredInteger(Bo,kL(GetPlayerId(Om)),Op)
endfunction
function kN takes player Om,string Op,integer Oq returns nothing
call kD(kL(GetPlayerId(Om))+"=",Op,Oq)
endfunction
function kO takes player Om,string Op,integer Oq returns nothing
call kD(kL(GetPlayerId(Om))+"+",Op,Oq)
endfunction
function kn takes nothing returns nothing
local integer BT=0
loop
exitwhen BT>=CJ
if CK[BT]!=null and TriggerEvaluate(CK[BT]) and IsTriggerEnabled(CK[BT]) then
call TriggerExecute(CK[BT])
endif
set BT=BT+1
endloop
endfunction
function kv takes integer Oq,integer Yq returns string
local string Yr=I2S(Oq)
local integer Ys=StringLength(Yr)
loop
exitwhen Ys>=Yq
set Yr="0"+Yr
set Ys=Ys+1
endloop
return Yr
endfunction
function ky takes integer BR,integer B5 returns integer
local integer B6=Bs[BR]*B5+1
return S2I(SubString(Br[BR],B6,B6+Bs[BR]))
endfunction
function kz takes integer Yl returns integer
local integer BR=0
if Yl==null or Yl==0 then
return 0
endif
set BR=LoadInteger(BQ,StringHash("YDWEStringFormula."+I2S(Ba)),StringHash(I2S(Yl)))
if BR>0 then
return BR
endif
set BR=Ym
set CD[BR]=Yl
set Br[BR]=I2S(Yn)
set Bs[BR]=Yn
call SaveInteger(BQ,StringHash("YDWEStringFormula."+I2S(Ba)),StringHash(I2S(Yl)),BR)
set Ym=Ym+1
return BR
endfunction
function k0 takes integer BR,string Op returns nothing
set Br[BR]=Br[BR]+Op
endfunction
function k1 takes nothing returns nothing
set Ba=ga()
endfunction
function k3 takes integer BR,integer B5 returns integer
local integer B6=B9[BR]*B5+1
return S2I(SubString(B8[BR],B6,B6+B9[BR]))
endfunction
function k4 takes integer Yu,string Yv,integer Ye returns integer
local integer BR=0
if HaveSavedInteger(BQ,StringHash("YDWEStringFormula."+I2S(Bg)),StringHash(Yv)) then
return 0
endif
set BR=Yw
set B8[BR]=Yv+kv(Ye,Yn)
set B9[BR]=Yu
set CG[BR]=null
set CH[BR]=null
set CF[BR]=100
set CL[BR]=false
call SaveInteger(BQ,StringHash("YDWEStringFormula."+I2S(Bg)),StringHash(Yv),BR)
set Yw=Yw+1
return BR
endfunction
function k5 takes nothing returns nothing
set Bg=ga()
endfunction
function k6 takes integer BR returns nothing
local integer BT=0
loop
exitwhen BT==BU
set BV[BW[BR]+BT]=0
set BX[BY[BR]+BT]=0
set BT=BT+1
endloop
set BZ[BR]=""
endfunction
function k7 takes integer BR returns nothing
if BR==null then
return
elseif Yi[BR]!=-1 then
return
endif
call k6(BR)
set Yi[BR]=Yh
set Yh=BR
endfunction
function k8 takes integer YS,integer YT,integer YU,integer YV,integer YW,integer YX,integer YY,integer YZ,integer Ya,integer Yb,integer Yc,integer Yd,integer Yf,integer Yg returns integer
local integer BR=gY()
set BV[BW[BR]+1]=kz(YS)
set BV[BW[BR]+2]=kz(YU)
set BV[BW[BR]+3]=kz(YW)
set BV[BW[BR]+4]=kz(YY)
set BV[BW[BR]+5]=kz(Ya)
set BV[BW[BR]+6]=kz(Yc)
set BV[BW[BR]+7]=kz(Yf)
set BX[BY[BR]+1]=YT
set BX[BY[BR]+2]=YV
set BX[BY[BR]+3]=YX
set BX[BY[BR]+4]=YZ
set BX[BY[BR]+5]=Yb
set BX[BY[BR]+6]=Yd
set BX[BY[BR]+7]=Yg
return BR
endfunction
function k9 takes integer BR returns string
local integer BT=1
local integer CE
local integer Yp
set BZ[BR]=""
loop
exitwhen BT>Yk[BR]
if BV[BW[BR]+BT]==0 or BX[BY[BR]+BT]==0 then
set BV[BW[BR]+BT]=BV[BW[BR]+Yk[BR]]
set BX[BY[BR]+BT]=BX[BY[BR]+Yk[BR]]
set Yk[BR]=Yk[BR]-1
set BT=BT-1
else
set CE=BT+1
loop
exitwhen CE>Yk[BR]
if BV[BW[BR]+CE]==0 or BX[BY[BR]+CE]==0 then
set BV[BW[BR]+CE]=BV[BW[BR]+Yk[BR]]
set BX[BY[BR]+CE]=BX[BY[BR]+Yk[BR]]
set Yk[BR]=Yk[BR]-1
set CE=CE-1
elseif BV[BW[BR]+BT]>BV[BW[BR]+CE] then
set Yp=BV[BW[BR]+BT]
set BV[BW[BR]+BT]=BV[BW[BR]+CE]
set BV[BW[BR]+CE]=Yp
set Yp=BX[BY[BR]+BT]
set BX[BY[BR]+BT]=BX[BY[BR]+CE]
set BX[BY[BR]+CE]=Yp
elseif BV[BW[BR]+BT]==BV[BW[BR]+CE] then
set BX[BY[BR]+BT]=BX[BY[BR]+BT]+BX[BY[BR]+CE]
set BV[BW[BR]+CE]=0
set CE=CE-1
endif
set CE=CE+1
endloop
set CE=BX[BY[BR]+BT]
loop
exitwhen CE==0
set BZ[BR]=BZ[BR]+kv(BV[BW[BR]+BT],Yn)
set CE=CE-1
endloop
endif
set BT=BT+1
endloop
return BZ[BR]
endfunction
function lB takes nothing returns boolean
return true
endfunction
function lC takes nothing returns boolean
return HaveSavedInteger(BQ,StringHash("YDWEStringFormula."+I2S(Ba)),StringHash(I2S(GetItemTypeId(GetManipulatedItem()))))
endfunction
function lD takes item Bw returns integer
local integer B1=GetItemCharges(Bw)
if B1==0 then
set B1=1
endif
return B1
endfunction
function lE takes nothing returns nothing
local integer B4=0
local integer Bq=LoadInteger(BQ,StringHash("YDWEStringFormula."+I2S(Ba)),StringHash(I2S(GetItemTypeId(GetManipulatedItem()))))
local integer Bt=StringLength(Br[Bq])/Bs[Bq]
local integer B3=0
local integer B7=0
local integer By=0
local integer CC=0
local integer BT=0
local integer CE=0
local boolean B2=false
local item Bw=null
local item Bu=GetManipulatedItem()
local unit Bv=GetTriggerUnit()
local item array Bx
local integer array Bz
local integer array B0
local integer array CB
set BT=0
loop
exitwhen BT==6
set Bw=UnitItemInSlot(Bv,BT)
if Bw!=null then
set Bx[By]=Bw
set Bz[By]=GetItemTypeId(Bw)
set B0[By]=lD(Bw)
if Bw==Bu then
set B2=true
endif
set By=By+1
endif
set BT=BT+1
set Bw=null
endloop
if B2==false then
set Bx[By]=Bu
set Bz[By]=GetItemTypeId(Bu)
set B0[By]=1
set By=By+1
endif
loop
exitwhen B3==Bt
set B4=ky(Bq,B3)
set B7=StringLength(B8[B4])/B9[B4]-1
set BT=0
loop
exitwhen BT==By
set CB[BT]=B0[BT]
set BT=BT+1
endloop
set BT=0
loop
set CC=CD[k3(B4,BT)]
exitwhen BT==B7
set CE=0
loop
exitwhen CE==By
if Bz[CE]==CC and CB[CE]>0 then
set CB[CE]=CB[CE]-1
exitwhen true
endif
set CE=CE+1
endloop
exitwhen CE==By
set BT=BT+1
endloop
if BT==B7 then
if GetRandomInt(0,99)<CF[B4] then
if CG[B4]!=null then
call DestroyEffect(AddSpecialEffectTarget(CG[B4],Bv,"origin"))
endif
if CH[B4]!=null then
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,0,30,CH[B4])
endif
set BT=0
loop
exitwhen BT==By
if CB[BT]>0 and GetItemCharges(Bx[BT])>0 then
call SetItemCharges(Bx[BT],CB[BT])
elseif CB[BT]==0 then
call RemoveItem(Bx[BT])
endif
set BT=BT+1
endloop
set Bw=CreateItem(CC,GetUnitX(Bv),GetUnitY(Bv))
if GetItemCharges(Bw)>0 then
call SetItemCharges(Bw,1)
set BT=0
loop
exitwhen BT==By
if Bz[BT]==CC then
call RemoveItem(Bx[BT])
call SetItemCharges(Bw,CB[BT]+1)
endif
set BT=BT+1
endloop
endif
call UnitAddItem(Bv,Bw)
set CI=Bw
call kn()
elseif CL[B4] then
set BT=0
loop
exitwhen BT==By
if CB[BT]>0 and GetItemCharges(Bx[BT])>0 then
call SetItemCharges(Bx[BT],CB[BT])
elseif CB[BT]==0 then
call RemoveItem(Bx[BT])
endif
set BT=BT+1
endloop
endif
set Bw=null
exitwhen true
endif
set B3=B3+1
endloop
if B2==false then
call RemoveItem(Bu)
endif
set BT=0
loop
exitwhen BT==By
set Bx[BT]=null
set BT=BT+1
endloop
set Bu=null
set Bv=null
set Bw=null
endfunction
function lF takes nothing returns nothing
local filterfunc Bp=Filter(function lB)
local trigger Bn=CreateTrigger()
local integer BT=0
loop
exitwhen BT>15
call TriggerRegisterPlayerUnitEvent(Bn,Player(BT),EVENT_PLAYER_UNIT_PICKUP_ITEM,Bp)
set BT=BT+1
endloop
call TriggerAddCondition(Bn,Condition(function lC))
call TriggerAddAction(Bn,function lE)
call DestroyFilter(Bp)
set Bp=null
set Bn=null
endfunction
function lG takes integer YS,integer YT,integer YU,integer YV,integer YW,integer YX,integer YY,integer YZ,integer Ya,integer Yb,integer Yc,integer Yd,integer Ye returns nothing
local integer Yo=k8(YS,YT,YU,YV,YW,YX,YY,YZ,Ya,Yb,Yc,Yd,0,0)
local integer Bq=kz(Ye)
local string Bp=I2S(Yn)+k9(Yo)
local string Yx=""
local integer BT=0
set Yt=k4(Yn,Bp,Bq)
if Yt>0 then
set Yx=kv(Yt,Yn)
set BT=0
loop
exitwhen BT>Yk[Yo]
call k0(BV[BW[Yo]+BT],Yx)
set BT=BT+1
endloop
call k0(Bq,Yx)
endif
call k7(Yo)
set Bp=""
set Yx=""
endfunction
function lH takes nothing returns integer
local integer Cb=CR
if CR<0 then
if CS>=8000 then
return 8100
else
set CS=CS+1
return CS
endif
endif
set CR=CT[Cb]
return Cb
endfunction
function lI takes integer Ce returns nothing
set CT[Ce]=CR
set CR=Ce
endfunction
function lJ takes real Ok,trigger Ol returns integer
local integer Ce=lH()
local integer Cb=CP
local integer Bn=R2I(100.*Ok)+CO
local integer Om
set Cd[Ce]=Ol
set Cc[Ce]=Bn
loop
set Om=CQ[Cb]
if Om<0 or Cc[Om]>=Bn then
set CQ[Cb]=Ce
set CQ[Ce]=Om
return Ce
endif
set Cb=Om
endloop
return Ce
endfunction
function lM takes nothing returns nothing
call RemoveUnit(LoadUnitHandle(BQ,CN,Ca))
call RemoveSavedHandle(BQ,CN,Ca)
endfunction
function lN takes real Ok,unit BF returns nothing
