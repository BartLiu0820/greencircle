function BUZ takes nothing returns nothing
local integer eH
local trigger eG
if Md<=1 then
if Md==1 then
set Mv=GetRandomInt(1,4)
if Mu==Mv then
set eG=GetTriggeringTrigger()
set eH=GetHandleId(eG)*(LoadInteger(Bh,GetHandleId(eG),$CFDE6C76)+3)
call TriggerExecute(eG)
else
set Mu=Mv
set Md=Md+1
endif
else
if Md==0 then
set Mu=GetRandomInt(1,4)
set Md=Md+1
else
call DoNothing()
endif
endif
if Mu==1 then
call UnitAddAbilityBJ($4130544B,GetTriggerUnit())
set Mf[1]=1
else
if Mu==2 then
call UnitAddAbilityBJ($4130544C,GetTriggerUnit())
set Mf[2]=1
else
if Mu==3 then
call UnitAddAbilityBJ($4130544D,GetTriggerUnit())
set Mf[3]=1
else
if Mu==4 then
if true then
call UnitAddAbilityBJ($4130544E,GetTriggerUnit())
set Mf[4]=1
else
endif
else
call DoNothing()
endif
endif
endif
endif
else
if Mc>=1 then
if GetUnitStateSwap(UNIT_STATE_MANA,Ry)>=240. then
set Md=0
set Mc=0
call SetUnitManaBJ(Ry,GetUnitStateSwap(UNIT_STATE_MANA,Ry)-240.)
call DisplayTimedTextToPlayer(GetOwningPlayer(GetTriggerUnit()),0,0,5.,"|cffff0303全部技能已清除|r")
call UnitRemoveAbilityBJ($4130544E,Ry)
call UnitRemoveAbilityBJ($4130544B,Ry)
call UnitRemoveAbilityBJ($4130544D,Ry)
call UnitRemoveAbilityBJ($4130544C,Ry)
set Mf[1]=0
set Mf[2]=0
set Mf[3]=0
set Mf[4]=0
else
call DisplayTimedTextToPlayer(GetOwningPlayer(GetTriggerUnit()),0,0,5.,"|cffff0303魔法不足|r")
endif
else
call DisplayTimedTextToPlayer(GetOwningPlayer(GetTriggerUnit()),0,0,5.,"|cffff0303最大只能获得3个技能|r")
call DisplayTimedTextToPlayer(GetOwningPlayer(GetTriggerUnit()),0,0,5.,"|cff20c00010秒内再次随机会清除技能,消耗240魔法|r")
set Mc=10
endif
endif
set eG=null
endfunction
