call SetUnitAbilityLevelSwapped($41304A59,SJ,3)
call SetUnitPositionLoc(SJ,bR[5])
call j2(12.)
call SaveInteger(Bh,GetHandleId(GetTriggeringTrigger()),$ECE825E7,Oo)
call SetUnitAbilityLevelSwapped($41304A59,SJ,1)
call RemoveLocation(bR[5])
call FlushChildHashtable(Bh,GetHandleId(GetTriggeringTrigger())*Oo)
