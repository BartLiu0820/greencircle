function BRf takes nothing returns nothing
if JT>=15-GetUnitAbilityLevelSwapped($41304141,Pp)*2 and GetUnitTypeId(GetAttackedUnitBJ())!=$6E736362 and GetUnitTypeId(GetAttackedUnitBJ())!=$55646561 and GetUnitTypeId(GetAttackedUnitBJ())!=$75303030 and GetUnitTypeId(GetAttackedUnitBJ())!=$6E736F63 and GetUnitTypeId(GetAttackedUnitBJ())!=$6E736332 and GetUnitTypeId(GetAttackedUnitBJ())!=$6E6F7765 and IsUnitType(GetAttackedUnitBJ(),UNIT_TYPE_HERO)!=true and RectContainsUnit(I,GetAttackedUnitBJ())!=true and RectContainsUnit(p,GetAttackedUnitBJ())!=true and RectContainsUnit(m,GetAttackedUnitBJ())!=true and RectContainsUnit(o,GetAttackedUnitBJ())!=true and RectContainsUnit(r,GetAttackedUnitBJ())!=true and RectContainsUnit(q,GetAttackedUnitBJ())!=true and RectContainsUnit(n,GetAttackedUnitBJ())!=true and RectContainsUnit(u,GetAttackedUnitBJ())!=true then
set Oe=GetUnitLoc(GetAttackedUnitBJ())
call IssueImmediateOrder(GetAttacker(),"stop")
call AddSpecialEffectLocBJ(Oe,"Abilities\\Spells\\Human\\MassTeleport\\MassTeleportCaster.mdl")
call DestroyEffect(GetLastCreatedEffectBJ())
set JT=0
set ca=GetAttackedUnitBJ()
set Sb[1]=GetRectCenter(I)
set Sb[2]=GetRectCenter(p)
set Sb[3]=GetRectCenter(m)
set Sb[4]=GetRectCenter(o)
set Sb[5]=GetRectCenter(r)
set Sb[6]=GetRectCenter(q)
set Sb[7]=GetRectCenter(n)
set Sb[8]=GetRectCenter(u)
call SetUnitManaBJ(Pp,GetUnitStateSwap(UNIT_STATE_MANA,Pp)+I2R(GetUnitAbilityLevelSwapped($41304149,Pp))*2.)
call UnitDamageTargetBJ(Pp,ca,I2R(GetUnitAbilityLevelSwapped($41304142,Pp)*GetUnitAbilityLevelSwapped($41304142,Pp)*3000),ATTACK_TYPE_HERO,DAMAGE_TYPE_ENHANCED)
call SetUnitPositionLoc(ca,Sb[GetConvertedPlayerId(GetOwningPlayer(GetAttacker()))])
set bj_forLoopAIndex=1
set bj_forLoopAIndexEnd=8
loop
exitwhen bj_forLoopAIndex>bj_forLoopAIndexEnd
call RemoveLocation(Sb[GetForLoopIndexA()])
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
call RemoveLocation(Oe)
else
call DoNothing()
endif
endfunction
