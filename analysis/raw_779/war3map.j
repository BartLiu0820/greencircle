if GetSpellAbilityId()==$41305049 and GetUnitAbilityLevelSwapped($41305049,GetTriggerUnit())<GetHeroInt(J3,false)/20 and GetUnitAbilityLevelSwapped($41305049,GetTriggerUnit())<10+Nn then
