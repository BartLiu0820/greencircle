set Wr=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(Wr,EVENT_PLAYER_UNIT_DEATH)
call TriggerAddCondition(Wr,Condition(function BEd))
call TriggerAddAction(Wr,function BEe)
endfunction
function BEg takes nothing returns boolean
return GetUnitTypeId(GetSpellAbilityUnit())==$6E303639 or GetUnitTypeId(GetSpellAbilityUnit())==$6E303645 or GetUnitTypeId(GetSpellAbilityUnit())==$6E303643 or GetUnitTypeId(GetSpellAbilityUnit())==$6E303644
endfunction
function BEh takes nothing returns nothing
if GetSpellAbilityId()==$41304C36 and GetPlayerTechCountSimple($52303052,GetTriggerPlayer())<10 and GetPlayerState(GetOwningPlayer(GetTriggerUnit()),PLAYER_STATE_RESOURCE_GOLD)>=4000 then
call SetPlayerStateBJ(GetOwningPlayer(GetTriggerUnit()),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(GetOwningPlayer(GetTriggerUnit()),PLAYER_STATE_RESOURCE_GOLD)-4000)
call AddPlayerTechResearched(GetTriggerPlayer(),$52303052,1)
call AddPlayerTechResearched(GetTriggerPlayer(),$52303053,1)
if GetUnitAbilityLevelSwapped($41304B59,GetTriggerUnit())<20 then
call IncUnitAbilityLevelSwapped($41304B59,GetTriggerUnit())
else
call DoNothing()
endif
else
if GetSpellAbilityId()==$41304C36 and GetPlayerTechCountSimple($52303052,GetTriggerPlayer())>=10 then
call DisplayTextToPlayer(GetOwningPlayer(GetSpellAbilityUnit()),0,0,"|cffff0303已经是最高等级|r")
else
call DoNothing()
endif
endif
if GetSpellAbilityId()==$41304C34 then
if GetUnitAbilityLevelSwapped(GetSpellAbilityId(),GetTriggerUnit())>=4 then
call SetUnitAbilityLevelSwapped(GetSpellAbilityId(),GetTriggerUnit(),1)
else
call IncUnitAbilityLevelSwapped(GetSpellAbilityId(),GetTriggerUnit())
endif
else
call DoNothing()
endif
if GetSpellAbilityId()==$41304F52 then
set Oe=GetUnitLoc(GetTriggerUnit())
set Wt[GetConvertedPlayerId(GetTriggerPlayer())]=GetTriggerUnit()
call ShowUnitHide(GetTriggerUnit())
call AddSpecialEffectLocBJ(Oe,"Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl")
call CreateNUnitsAtLoc(1,$6E6D7368,GetTriggerPlayer(),Oe,bj_UNIT_FACING)
call UnitApplyTimedLifeBJ(10.,$4245666E,GetLastCreatedUnit())
call SetUnitAbilityLevelSwapped($41304B59,GetLastCreatedUnit(),Jj[GetConvertedPlayerId(GetOwningPlayer(GetLastCreatedUnit()))])
call DestroyEffect(GetLastCreatedEffectBJ())
call RemoveLocation(Oe)
else
call DoNothing()
endif
endfunction
