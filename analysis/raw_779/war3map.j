function Bbe takes nothing returns boolean
local integer BR=BP
call FlushChildHashtable(BQ,StringHash("YDWEStringFormula."+I2S(BR)))
return true
endfunction
function Bbf takes nothing returns boolean
local integer BR=BP
local integer BT=0
loop
exitwhen BT==BU
set BV[BW[BR]+BT]=0
set BX[BY[BR]+BT]=0
set BT=BT+1
endloop
set BZ[BR]=""
return true
endfunction
function Bbg takes nothing returns nothing
set BO[1]=CreateTrigger()
set BO[2]=BO[1]
call TriggerAddCondition(BO[1],Condition(function Bbe))
set BS=CreateTrigger()
call TriggerAddCondition(BS,Condition(function Bbf))
call ExecuteFunc("k1")
call ExecuteFunc("k5")
endfunction
