set I2[GetConvertedPlayerId(GetTriggerPlayer())]=I2[GetConvertedPlayerId(GetTriggerPlayer())]-1
set I3[GetConvertedPlayerId(GetTriggerPlayer())]=I3[GetConvertedPlayerId(GetTriggerPlayer())]+1
call kO(GetTriggerPlayer(),"k+5",1)
call DialogDisplayBJ(true,FD,Player(0))
call DialogDisplayBJ(true,FD,Player(1))
call DialogDisplayBJ(true,FD,Player(2))
call DialogDisplayBJ(true,FD,Player(3))
call DialogDisplayBJ(true,FD,Player(4))
call DialogDisplayBJ(true,FD,Player(5))
call DialogDisplayBJ(true,FD,Player(6))
call DialogDisplayBJ(true,FD,Player(7))
call TriggerExecute(QW)
call DisableTrigger(GetTriggeringTrigger())
