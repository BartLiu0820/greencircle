function BPP takes nothing returns nothing
set LB=GetRandomInt(30,60)
if GetUnitTypeId(GetSpellTargetUnit())==$68303432 and GetPlayerState(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_LUMBER)>=3 then
call ModifyHeroStat(bj_HEROSTAT_STR,GetTriggerUnit(),bj_MODIFYMETHOD_ADD,LB)
call SetPlayerStateBJ(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_LUMBER,GetPlayerState(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_LUMBER)-3)
call DisplayTextToPlayer(GetOwningPlayer(GetSpellAbilityUnit()),0,0,"|cffff0303献祭成功，增加"+I2S(LB)+"点力量|r")
set Oe=GetUnitLoc(GetSpellTargetUnit())
call AddSpecialEffectLocBJ(Oe,"Abilities\\Spells\\Human\\MassTeleport\\MassTeleportCaster.mdl")
call RemoveLocation(Oe)
call KillUnit(GetSpellTargetUnit())
set Oe=GetRandomLocInRect(s)
call CreateNUnitsAtLoc(1,$6E303252,GetOwningPlayer(GetSpellTargetUnit()),Oe,bj_UNIT_FACING)
call RemoveLocation(Oe)
else
call DoNothing()
endif
if GetUnitTypeId(GetSpellTargetUnit())==$68303453 and GetPlayerState(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_LUMBER)>=3 then
call ModifyHeroStat(bj_HEROSTAT_AGI,GetTriggerUnit(),bj_MODIFYMETHOD_ADD,LB)
call DisplayTextToPlayer(GetOwningPlayer(GetSpellAbilityUnit()),0,0,"|cffff0303献祭成功，增加"+I2S(LB)+"点敏捷|r")
call SetPlayerStateBJ(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_LUMBER,GetPlayerState(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_LUMBER)-3)
set Oe=GetUnitLoc(GetSpellTargetUnit())
call AddSpecialEffectLocBJ(Oe,"Abilities\\Spells\\Human\\MassTeleport\\MassTeleportCaster.mdl")
call DestroyEffect(bj_lastCreatedEffect)
call KillUnit(GetSpellTargetUnit())
call RemoveLocation(Oe)
set Oe=GetRandomLocInRect(s)
call CreateNUnitsAtLoc(1,$6E303252,GetOwningPlayer(GetSpellTargetUnit()),Oe,bj_UNIT_FACING)
call RemoveLocation(Oe)
else
call DoNothing()
endif
if GetUnitTypeId(GetSpellTargetUnit())==$68303056 then
if GetRandomInt(1,3)==1 then
call ModifyHeroStat(bj_HEROSTAT_AGI,GetTriggerUnit(),bj_MODIFYMETHOD_ADD,60)
