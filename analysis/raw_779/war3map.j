function lo takes player Om,string Op returns integer
local integer Ot
if Op=="至尊" then
set Op="至尊+8"
elseif Op=="战绩" then
set Op="战绩+30"
endif
set Ot=kM(Om,Op)
if Ot<=0 then
set Ot=kM(Om,Op+"备份")
endif
set Om=null
set Op=null
return Ot
endfunction
function lp takes player Om,string Op,integer P1 returns nothing
if Op=="至尊" then
set Op="至尊+8"
elseif Op=="战绩" then
set Op="战绩+30"
else
if Op=="成就" and P1-kM(Om,Op)>1000 then
return
elseif Op=="荣誉" and P1-kM(Om,Op)>1 then
return
endif
call kN(Om,Op,P1)
if lo(Om,Op)>0 then
call kN(Om,Op+"备份",P1)
endif
return
endif
call kO(Om,Op,P1-lo(Om,Op))
set Om=null
set Op=null
endfunction
