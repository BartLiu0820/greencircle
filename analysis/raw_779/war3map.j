call IssueTargetOrder(J6[5],"innerfire",J3)
call IssueImmediateOrder(J6[5],"lavamonster")
else
endif
if KB>=8 and GetUnitAbilityLevelSwapped($4130504A,J3)>=1 then
set KB=0
call IssueImmediateOrder(J6[1],"lavamonster")
call IssueImmediateOrder(J6[2],"lavamonster")
call IssueImmediateOrder(J6[3],"lavamonster")
call IssueImmediateOrder(J6[4],"lavamonster")
call IssueImmediateOrder(J6[5],"lavamonster")
else
endif
if GetUnitTypeId(GetAttacker())==$68303859 and UnitHasBuffBJ(J3,$42303247)==false and Nb>=4 then
set Nb=Nb-4
call IssueImmediateOrder(GetAttacker(),"roar")
else
if GetUnitTypeId(GetAttacker())==$68303859 and UnitHasBuffBJ(J3,$42303247)==false and Nb<4 then
set Nb=Nb+1
else
call DoNothing()
endif
endif
endfunction
