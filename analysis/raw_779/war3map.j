call SetTextTagLifespan(GetLastCreatedTextTag(),2.)
call SetTextTagFadepoint(GetLastCreatedTextTag(),2.)
set Ho=0
else
if GetRandomInt(1,150)<=6+Hz[3]*3 and GetUnitAbilityLevelSwapped($41304C45,GetAttacker())>=1 and Ho==1 then
if GetHeroStatBJ(bj_HEROSTAT_INT,SK,false)>=400 then
call UnitDamagePointLoc(GetAttacker(),.1,150.,Oe,I2R(GetHeroStatBJ(bj_HEROSTAT_INT,GetAttacker(),false))*I2R(GetHeroLevel(GetAttacker())*15),ATTACK_TYPE_CHAOS,DAMAGE_TYPE_ENHANCED)
call CreateTextTagUnitBJ("|cff7fffd4混乱+"+(I2S(GetHeroStatBJ(bj_HEROSTAT_INT,GetAttacker(),false)*(GetHeroLevel(GetAttacker())*15))+"！|r"),GetAttacker(),0,9.,0.,0.,100.,0)
else
call UnitDamagePointLoc(GetAttacker(),.1,150.,Oe,I2R(GetHeroStatBJ(bj_HEROSTAT_INT,GetAttacker(),false))*I2R(GetHeroLevel(GetAttacker())*10),ATTACK_TYPE_CHAOS,DAMAGE_TYPE_ENHANCED)
call CreateTextTagUnitBJ("|cff7fffd4混乱+"+(I2S(GetHeroStatBJ(bj_HEROSTAT_INT,GetAttacker(),false)*(GetHeroLevel(GetAttacker())*10))+"！|r"),GetAttacker(),0,9.,0.,0.,100.,0)
