function BLp takes nothing returns boolean
return GetUnitAbilityLevelSwapped($41304644,GetAttacker())>=1 and Ga[GetConvertedPlayerId(GetOwningPlayer(GetAttacker()))]!=1
endfunction
function BLq takes nothing returns nothing
set Oe=GetUnitLoc(GetAttacker())
if GB[GetConvertedPlayerId(GetOwningPlayer(GetAttacker()))]>5 then
call CreateNUnitsAtLoc(1,$6E303436,GetOwningPlayer(GetAttacker()),Oe,bj_UNIT_FACING)
call UnitApplyTimedLifeBJ(3.+I2R(GC[GetConvertedPlayerId(GetOwningPlayer(GetAttacker()))]),$42726169,GetLastCreatedUnit())
set GB[GetConvertedPlayerId(GetOwningPlayer(GetAttacker()))]=0
if GetHeroStatBJ(bj_HEROSTAT_AGI,GetAttacker(),false)>=250 then
call SetUnitAbilityLevelSwapped($41304643,GetLastCreatedUnit(),10)
else
call SetUnitAbilityLevelSwapped($41304643,GetLastCreatedUnit(),GetHeroStatBJ(bj_HEROSTAT_AGI,GetAttacker(),false)/25)
endif
else
call DoNothing()
endif
call RemoveLocation(Oe)
endfunction
function BLr takes nothing returns nothing
set aI=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(aI,EVENT_PLAYER_UNIT_ATTACKED)
call TriggerAddCondition(aI,Condition(function BLp))
call TriggerAddAction(aI,function BLq)
endfunction
function BLs takes nothing returns boolean
return GetUnitAbilityLevelSwapped($41304646,GetKillingUnitBJ())>=1 or GetUnitAbilityLevelSwapped($41304645,GetKillingUnitBJ())>=1 and Ga[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))]!=1
endfunction
function BLt takes nothing returns boolean
return GetUnitAbilityLevelSwapped($41304646,GetFilterUnit())>=1
endfunction
function BLu takes nothing returns boolean
return GetUnitAbilityLevelSwapped($41304641,GetFilterUnit())>=1
endfunction
function BLv takes nothing returns boolean
return GetUnitAbilityLevelSwapped($41304641,GetFilterUnit())>=1
endfunction
function BLw takes nothing returns boolean
return GetUnitAbilityLevelSwapped($41304641,GetFilterUnit())>=1
endfunction
function BLx takes nothing returns boolean
return GetUnitAbilityLevelSwapped($41304641,GetFilterUnit())>=1
endfunction
function BLy takes nothing returns nothing
set Oe=GetUnitLoc(GetTriggerUnit())
if CountUnitsInGroup(jy(GetOwningPlayer(GetKillingUnitBJ()),Condition(function BLt)))<4+1*GC[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))] then
if GetHeroStatBJ(bj_HEROSTAT_STR,GroupPickRandomUnit(jy(GetOwningPlayer(GetKillingUnitBJ()),Condition(function BLu))),false)>=240 then
call CreateNUnitsAtLoc(1,$6E303438,GetOwningPlayer(GetKillingUnitBJ()),Oe,bj_UNIT_FACING)
call UnitApplyTimedLifeBJ(5.,$42726169,GetLastCreatedUnit())
else
if GetHeroStatBJ(bj_HEROSTAT_STR,GroupPickRandomUnit(jy(GetOwningPlayer(GetKillingUnitBJ()),Condition(function BLv))),false)>=160 then
call CreateNUnitsAtLoc(1,$6E303441,GetOwningPlayer(GetKillingUnitBJ()),Oe,bj_UNIT_FACING)
call UnitApplyTimedLifeBJ(5.,$42726169,GetLastCreatedUnit())
else
if GetHeroStatBJ(bj_HEROSTAT_STR,GroupPickRandomUnit(jy(GetOwningPlayer(GetKillingUnitBJ()),Condition(function BLw))),false)>=80 then
call CreateNUnitsAtLoc(1,$6E303442,GetOwningPlayer(GetKillingUnitBJ()),Oe,bj_UNIT_FACING)
call UnitApplyTimedLifeBJ(5.,$42726169,GetLastCreatedUnit())
else
if GetHeroStatBJ(bj_HEROSTAT_STR,GroupPickRandomUnit(jy(GetOwningPlayer(GetKillingUnitBJ()),Condition(function BLx))),false)<80 then
call CreateNUnitsAtLoc(1,$6E303437,GetOwningPlayer(GetKillingUnitBJ()),Oe,bj_UNIT_FACING)
call UnitApplyTimedLifeBJ(5.,$42726169,GetLastCreatedUnit())
else
call DoNothing()
endif
endif
endif
endif
else
call DoNothing()
endif
call RemoveLocation(Oe)
endfunction
function BLz takes nothing returns nothing
set aJ=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(aJ,EVENT_PLAYER_UNIT_DEATH)
call TriggerAddCondition(aJ,Condition(function BLs))
call TriggerAddAction(aJ,function BLy)
endfunction
function BL0 takes nothing returns boolean
return GetUnitAbilityLevelSwapped($41304647,GetAttacker())>=1
endfunction
function BL1 takes nothing returns nothing
if IsTriggerEnabled(Sd)==true and GD<=0 then
set GD=4
call UnitDamageTargetBJ(GetAttacker(),GetAttackedUnitBJ(),100.+GetUnitStateSwap(UNIT_STATE_MAX_LIFE,GetAttackedUnitBJ()),ATTACK_TYPE_HERO,DAMAGE_TYPE_ENHANCED)
set Oe=GetUnitLoc(GetAttackedUnitBJ())
call AddSpecialEffectLocBJ(Oe,"Abilities\\Spells\\Human\\Flare\\FlareCaster.mdl")
call DestroyEffect(GetLastCreatedEffectBJ())
call RemoveLocation(Oe)
else
call DoNothing()
endif
endfunction
function BL2 takes nothing returns nothing
set aK=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(aK,EVENT_PLAYER_UNIT_ATTACKED)
call TriggerAddCondition(aK,Condition(function BL0))
call TriggerAddAction(aK,function BL1)
endfunction
function BL3 takes nothing returns boolean
return GetSpellAbilityId()==$41304747
endfunction
function BL4 takes nothing returns nothing
set W2=GetUnitLoc(GetTriggerUnit())
set Oe=PolarProjectionBJ(W2,150.,180.)
if KZ==1 then
call CreateNUnitsAtLoc(1,$6E303747,GetOwningPlayer(GetTriggerUnit()),Oe,bj_UNIT_FACING)
else
call CreateNUnitsAtLoc(1,$6E303531,GetOwningPlayer(GetTriggerUnit()),Oe,bj_UNIT_FACING)
