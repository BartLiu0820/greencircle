function BUc takes nothing returns nothing
set eJ=GetUnitLoc(GetConstructedStructure())
if DistanceBetweenPoints(eE,eJ)<=1000. then
set Mm=GetRandomInt(1,4)
if Mm==4 then
call SetUnitVertexColor(GetConstructedStructure(),255,0,0,255)
call SetUnitAbilityLevelSwapped($41305532,GetConstructedStructure(),4)
set Mh=Mh+1
call SetUnitUserData(GetTriggerUnit(),4)
else
if Mm==3 then
call SetUnitVertexColor(GetConstructedStructure(),255,55,255,255)
call SetUnitAbilityLevelSwapped($41305532,GetConstructedStructure(),3)
set Mj=Mj+1
call SetUnitUserData(GetTriggerUnit(),3)
else
if Mm==2 then
call SetUnitVertexColor(GetConstructedStructure(),250,120,100,255)
call SetUnitAbilityLevelSwapped($41305532,GetConstructedStructure(),2)
set Mi=Mi+1
call SetUnitUserData(GetTriggerUnit(),2)
else
if Mm==1 then
call UnitAddAbilityBJ($41305459,GetConstructedStructure())
call SetUnitVertexColor(GetConstructedStructure(),100,255,255,255)
call SetUnitAbilityLevelSwapped($41305532,GetConstructedStructure(),1)
set Mg=Mg+1
call SetUnitUserData(GetTriggerUnit(),1)
else
call DoNothing()
endif
endif
endif
endif
set Ml=GetRandomInt(1,6)
if Ml==1 then
call UnitAddAbilityBJ($41305456,GetConstructedStructure())
else
call DoNothing()
endif
if Ml==2 then
call UnitAddAbilityBJ($41305455,GetConstructedStructure())
else
call DoNothing()
endif
if Ml==3 then
call UnitAddAbilityBJ($41305458,GetConstructedStructure())
else
call DoNothing()
endif
if Ml==4 then
call UnitAddAbilityBJ($41305449,GetConstructedStructure())
else
call DoNothing()
endif
if Ml==5 then
call UnitAddAbilityBJ($4130545A,GetConstructedStructure())
else
call DoNothing()
endif
if Ml==6 then
call UnitAddAbilityBJ($41305530,GetConstructedStructure())
else
call DoNothing()
endif
else
call RemoveUnit(GetConstructedStructure())
call DisplayTimedTextToPlayer(GetOwningPlayer(GetTriggerUnit()),0,0,5.,"|cffff0303需要主塔1000范围以内建造|r")
endif
endfunction
