function BPu takes nothing returns boolean
return GetUnitTypeId(GetAttacker())==$4830354F
endfunction
function BPv takes nothing returns nothing
call IssueImmediateOrder(GetAttacker(),"roar")
call IssueImmediateOrder(GetAttacker(),"stomp")
if GetUnitAbilityLevelSwapped($41304C56,GetAttacker())==1 and GetRandomInt(1,10)==1 then
set bo=GetUnitLoc(GetAttacker())
call CreateNUnitsAtLoc(1,$6E616E62,GetOwningPlayer(GetAttacker()),bo,bj_UNIT_FACING)
call UnitApplyTimedLifeBJ(Hw+3.,$42544C46,GetLastCreatedUnit())
call RemoveLocation(bo)
else
call DoNothing()
endif
if GetUnitAbilityLevelSwapped($41304C56,GetAttacker())==1 and GetRandomInt(1,10)==1 then
set bo=GetUnitLoc(GetAttackedUnitBJ())
call UnitDamagePointLoc(GetAttacker(),.1,200.+Hx,bo,I2R(GetHeroStatBJ(bj_HEROSTAT_STR,GetAttacker(),false))*100.,ATTACK_TYPE_MELEE,DAMAGE_TYPE_NORMAL)
call RemoveLocation(bo)
