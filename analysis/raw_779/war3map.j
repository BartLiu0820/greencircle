function BPo takes nothing returns boolean
return GetSpellAbilityId()==$41304C50 or GetSpellAbilityId()==$41304C51 or GetSpellAbilityId()==$41304C54 or GetSpellAbilityId()==$41304B47 or GetSpellAbilityId()==$41305345
endfunction
function BPp takes nothing returns nothing
set Oe=GetUnitLoc(GetTriggerUnit())
if DU[GetConvertedPlayerId(GetTriggerPlayer())]<4 and GetPlayerState(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_LUMBER)>=1*(DU[GetConvertedPlayerId(GetTriggerPlayer())]*18) and GetHeroStatBJ(bj_HEROSTAT_STR,GetTriggerUnit(),true)>=DU[GetConvertedPlayerId(GetTriggerPlayer())]*80 then
if GetSpellAbilityId()==$41304C50 and GetUnitAbilityLevelSwapped($41304C56,GetTriggerUnit())!=1 then
call AddSpecialEffectLocBJ(Oe,"Abilities\\Spells\\Human\\Resurrect\\ResurrectTarget.mdl")
call DestroyEffect(GetLastCreatedEffectBJ())
call UnitAddAbilityBJ($41304C56,GetSpellAbilityUnit())
call SetPlayerStateBJ(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_LUMBER,GetPlayerState(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_LUMBER)-1*(DU[GetConvertedPlayerId(GetTriggerPlayer())]*18))
set DU[GetConvertedPlayerId(GetTriggerPlayer())]=DU[GetConvertedPlayerId(GetTriggerPlayer())]+1
else
if GetSpellAbilityId()==$41304C51 and GetUnitAbilityLevelSwapped($41304C55,GetTriggerUnit())!=1 then
call AddSpecialEffectLocBJ(Oe,"Abilities\\Spells\\Human\\Resurrect\\ResurrectTarget.mdl")
call DestroyEffect(GetLastCreatedEffectBJ())
call SetPlayerTechResearchedSwap($52303057,1,GetTriggerPlayer())
call UnitAddAbilityBJ($41304C55,GetSpellAbilityUnit())
call SetPlayerStateBJ(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_LUMBER,GetPlayerState(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_LUMBER)-1*(DU[GetConvertedPlayerId(GetTriggerPlayer())]*18))
set DU[GetConvertedPlayerId(GetTriggerPlayer())]=DU[GetConvertedPlayerId(GetTriggerPlayer())]+1
else
if GetSpellAbilityId()==$41304C54 and GetUnitAbilityLevelSwapped($41304C52,GetTriggerUnit())!=1 then
call AddSpecialEffectLocBJ(Oe,"Abilities\\Spells\\Human\\Resurrect\\ResurrectTarget.mdl")
call DestroyEffect(GetLastCreatedEffectBJ())
call UnitAddAbilityBJ($41304C52,GetSpellAbilityUnit())
set Hw=2.
call SetPlayerStateBJ(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_LUMBER,GetPlayerState(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_LUMBER)-1*(DU[GetConvertedPlayerId(GetTriggerPlayer())]*18))
set DU[GetConvertedPlayerId(GetTriggerPlayer())]=DU[GetConvertedPlayerId(GetTriggerPlayer())]+1
else
if GetSpellAbilityId()==$41304B47 and GetUnitAbilityLevelSwapped($41304C57,GetTriggerUnit())!=1 then
call AddSpecialEffectLocBJ(Oe,"Abilities\\Spells\\Human\\Resurrect\\ResurrectTarget.mdl")
call DestroyEffect(GetLastCreatedEffectBJ())
set L3=1
call UnitAddAbilityBJ($41304C57,GetSpellAbilityUnit())
call SetPlayerStateBJ(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_LUMBER,GetPlayerState(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_LUMBER)-1*(DU[GetConvertedPlayerId(GetTriggerPlayer())]*18))
set DU[GetConvertedPlayerId(GetTriggerPlayer())]=DU[GetConvertedPlayerId(GetTriggerPlayer())]+1
else
if GetSpellAbilityId()==$41305345 and GetUnitAbilityLevelSwapped($41305348,GetTriggerUnit())!=1 then
call AddSpecialEffectLocBJ(Oe,"Abilities\\Spells\\Human\\Resurrect\\ResurrectTarget.mdl")
call DestroyEffect(GetLastCreatedEffectBJ())
call UnitAddAbilityBJ($41305348,GetSpellAbilityUnit())
call SetPlayerTechResearchedSwap($52303058,1,GetTriggerPlayer())
call SetPlayerStateBJ(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_LUMBER,GetPlayerState(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_LUMBER)-1*(DU[GetConvertedPlayerId(GetTriggerPlayer())]*18))
set DU[GetConvertedPlayerId(GetTriggerPlayer())]=DU[GetConvertedPlayerId(GetTriggerPlayer())]+1
else
call DoNothing()
endif
endif
endif
endif
endif
else
call DoNothing()
endif
call RemoveLocation(Oe)
endfunction
