function BM7 takes nothing returns nothing
set Oe=GetUnitLoc(GetTriggerUnit())
set H2=ju(1000.,Oe,Condition(function BM6))
call RemoveLocation(Oe)
set Oe=GetUnitLoc(GroupPickRandomUnit(H2))
if GetRandomInt(1,2)==1 and NX[GetConvertedPlayerId(GetTriggerPlayer())]==1 then
call CreateNUnitsAtLoc(1,$6E303859,GetOwningPlayer(GetTriggerUnit()),Oe,bj_UNIT_FACING)
else
call CreateNUnitsAtLoc(1,$6E303535,GetOwningPlayer(GetTriggerUnit()),Oe,bj_UNIT_FACING)
endif
call DestroyGroup(H2)
call RemoveLocation(Oe)
call SetUnitAbilityLevelSwapped($4130475A,GetLastCreatedUnit(),GetUnitAbilityLevelSwapped($41304758,GetTriggerUnit())+1)
call SetUnitAbilityLevelSwapped($41304830,GetLastCreatedUnit(),GetUnitAbilityLevelSwapped($41304757,GetTriggerUnit())+1)
call UnitApplyTimedLifeBJ(16.,$42726169,GetLastCreatedUnit())
if jp($68303032,GetTriggerPlayer())==0 then
call SetUnitAbilityLevelSwapped($41304758,GetTriggerUnit(),1)
else
if jp($68303033,GetTriggerPlayer())==0 then
set Gk[GetConvertedPlayerId(GetTriggerPlayer())]=0
else
if jp($68303348,GetTriggerPlayer())==0 then
call SetUnitAbilityLevelSwapped($41304757,GetTriggerUnit(),1)
else
call DoNothing()
endif
endif
endif
endfunction
