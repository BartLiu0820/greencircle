function BEd takes nothing returns boolean
return GetUnitTypeId(GetKillingUnitBJ())==$6E303639 or GetUnitTypeId(GetKillingUnitBJ())==$6E303645 or GetUnitTypeId(GetKillingUnitBJ())==$6E303643 or GetUnitTypeId(GetKillingUnitBJ())==$6E303644
endfunction
function BEe takes nothing returns nothing
if HU[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))]>=17-GetUnitAbilityLevelSwapped($41304C33,GetKillingUnitBJ())*1 then
set HU[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))]=0
set Pb[10]=GetUnitLoc(GetDyingUnit())
call CreateNUnitsAtLocFacingLocBJ(1,$6E303641,GetOwningPlayer(GetKillingUnitBJ()),Pb[10],Pb[10])
call IssueImmediateOrder(GetLastCreatedUnit(),"howlofterror")
call RemoveLocation(Pb[10])
else
set HU[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))]=HU[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))]+1
endif
if GetUnitAbilityLevelSwapped($41304B59,GetKillingUnitBJ())<20 and GetUnitAbilityLevelSwapped($41304C34,GetKillingUnitBJ())==1 and GetUnitStateSwap(UNIT_STATE_MANA,GetKillingUnitBJ())>=100. then
call IncUnitAbilityLevelSwapped($41304B59,GetKillingUnitBJ())
call SetUnitManaBJ(GetKillingUnitBJ(),GetUnitStateSwap(UNIT_STATE_MANA,GetKillingUnitBJ())-100.)
else
if GetUnitAbilityLevelSwapped($41304B5A,GetKillingUnitBJ())<4 and GetUnitAbilityLevelSwapped($41304C34,GetKillingUnitBJ())==2 and GetUnitStateSwap(UNIT_STATE_MANA,GetKillingUnitBJ())>=50. and GetPlayerState(GetOwningPlayer(GetKillingUnitBJ()),PLAYER_STATE_RESOURCE_LUMBER)>=10 then
call SetUnitManaBJ(GetKillingUnitBJ(),GetUnitStateSwap(UNIT_STATE_MANA,GetKillingUnitBJ())-50.)
call SetPlayerStateBJ(GetOwningPlayer(GetKillingUnitBJ()),PLAYER_STATE_RESOURCE_LUMBER,GetPlayerState(GetOwningPlayer(GetKillingUnitBJ()),PLAYER_STATE_RESOURCE_LUMBER)-10)
call IncUnitAbilityLevelSwapped($41304B5A,GetKillingUnitBJ())
call AddPlayerTechResearched(GetOwningPlayer(GetKillingUnitBJ()),$52303053,3)
else
if GetUnitAbilityLevelSwapped($41304C31,GetKillingUnitBJ())<9 and GetUnitAbilityLevelSwapped($41304C34,GetKillingUnitBJ())==3 and GetUnitStateSwap(UNIT_STATE_MANA,GetKillingUnitBJ())>=150. and GetPlayerState(GetOwningPlayer(GetKillingUnitBJ()),PLAYER_STATE_RESOURCE_GOLD)>=1000 then
call SetPlayerStateBJ(GetOwningPlayer(GetKillingUnitBJ()),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(GetOwningPlayer(GetKillingUnitBJ()),PLAYER_STATE_RESOURCE_GOLD)-1000)
call SetUnitManaBJ(GetKillingUnitBJ(),GetUnitStateSwap(UNIT_STATE_MANA,GetKillingUnitBJ())-150.)
call IncUnitAbilityLevelSwapped($41304C31,GetKillingUnitBJ())
else
if GetUnitAbilityLevelSwapped($41304C33,GetKillingUnitBJ())<9 and GetUnitAbilityLevelSwapped($41304C34,GetKillingUnitBJ())==4 and GetUnitStateSwap(UNIT_STATE_MANA,GetKillingUnitBJ())>=250. then
call SetUnitManaBJ(GetKillingUnitBJ(),GetUnitStateSwap(UNIT_STATE_MANA,GetKillingUnitBJ())-200.)
call IncUnitAbilityLevelSwapped($41304C33,GetKillingUnitBJ())
else
call SetUnitManaBJ(GetKillingUnitBJ(),GetUnitStateSwap(UNIT_STATE_MANA,GetKillingUnitBJ())+1+(I2R(GetUnitAbilityLevelSwapped($41304C35,GetKillingUnitBJ()))-1.)*.2)
endif
endif
endif
endif
endfunction
