function BLC takes nothing returns nothing
if GetUnitTypeId(GetConstructedStructure())==$68303146 and CountUnitsInGroup(jz($68303146))<=1 and CountUnitsInGroup(jz($4870616C))<=1 and H4[GetConvertedPlayerId(GetTriggerPlayer())]>=10 or jp($6E303343,GetTriggerPlayer())>=1 then
if jp($6E303343,GetTriggerPlayer())>=1 then
set H4[GetConvertedPlayerId(GetTriggerPlayer())]=H4[GetConvertedPlayerId(GetTriggerPlayer())]+10
else
