function BTB takes nothing returns nothing
if Km>=100 and Kn>=1 then
set Km=Km-100
call SetUnitState(R9,ConvertUnitState(18),GetUnitStateSwap(ConvertUnitState(18),R9)+15.)
call CreateTextTagUnitBJ("+15",R9,50.,11.,0.,100.,100.,0)
call SetTextTagPermanent(GetLastCreatedTextTag(),false)
call SetTextTagVelocityBJ(GetLastCreatedTextTag(),100.,90.)
call SetTextTagFadepoint(GetLastCreatedTextTag(),1.)
call SetTextTagLifespan(GetLastCreatedTextTag(),1.)
else
if Km>=24-Nj*8 and Ko>=1 and GetUnitAbilityLevelSwapped($41305157,R9)==1 then
set Km=0
set Nm=18
call SetUnitState(R9,ConvertUnitState(18),GetUnitStateSwap(ConvertUnitState(18),R9)+3.)
call CreateTextTagUnitBJ("+3",R9,50.,11.,0.,100.,100.,0)
call SetTextTagPermanent(GetLastCreatedTextTag(),false)
call SetTextTagVelocityBJ(GetLastCreatedTextTag(),100.,90.)
call SetTextTagFadepoint(GetLastCreatedTextTag(),1.)
call SetTextTagLifespan(GetLastCreatedTextTag(),1.)
set dH=GetUnitLoc(GetAttackedUnitBJ())
call CreateNUnitsAtLoc(1,$68303746,GetOwningPlayer(GetAttacker()),dH,bj_UNIT_FACING)
call UnitApplyTimedLifeBJ(1.,$42544C46,GetLastCreatedUnit())
if GetHeroAgi(R9,false)>=210 then
call UnitDamagePointLoc(R9,.1,400.,dH,(GetUnitStateSwap(ConvertUnitState(18),R9)+GetUnitStateSwap(ConvertUnitState(19),R9))*12.+0,ATTACK_TYPE_HERO,DAMAGE_TYPE_NORMAL)
else
if GetHeroAgi(R9,false)>=140 then
call UnitDamagePointLoc(R9,.1,400.,dH,(GetUnitStateSwap(ConvertUnitState(18),R9)+GetUnitStateSwap(ConvertUnitState(19),R9))*8.+0,ATTACK_TYPE_HERO,DAMAGE_TYPE_NORMAL)
else
if GetHeroAgi(R9,false)>=70 then
call UnitDamagePointLoc(R9,.1,400.,dH,(GetUnitStateSwap(ConvertUnitState(18),R9)+GetUnitStateSwap(ConvertUnitState(19),R9))*5.+0,ATTACK_TYPE_HERO,DAMAGE_TYPE_NORMAL)
else
call UnitDamagePointLoc(R9,.1,400.,dH,(GetUnitStateSwap(ConvertUnitState(18),R9)+GetUnitStateSwap(ConvertUnitState(19),R9))*2.+0,ATTACK_TYPE_HERO,DAMAGE_TYPE_NORMAL)
endif
endif
endif
call RemoveLocation(dH)
else
if GetUnitAbilityLevelSwapped($4130514F,R9)!=1 then
set Km=Km+1
if true then
if Kq>=1. then
set Km=Km+1
set Kq=Kq-1.+I2R(Nk)*(I2R(GetHeroInt(R9,false))/(333.-I2R(Nj)*133.))
else
set Kq=Kq+I2R(Nk)*(I2R(GetHeroInt(R9,false))/500.)
endif
else
endif
call CreateTextTagUnitBJ(I2S(Km),R9,0,9.,100.,0.,0.,0)
call SetTextTagPermanent(GetLastCreatedTextTag(),false)
call SetTextTagVelocityBJ(GetLastCreatedTextTag(),100.,90.)
call SetTextTagFadepoint(GetLastCreatedTextTag(),1.)
call SetTextTagLifespan(GetLastCreatedTextTag(),1.)
else
endif
endif
endif
endfunction
