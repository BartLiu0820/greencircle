call IssueImmediateOrder(GetAttacker(),"thunderclap")
else
call DoNothing()
endif
if KF==1 then
call IssueImmediateOrder(GetAttacker(),"stomp")
else
call DoNothing()
endif
else
call DoNothing()
endif
if KG==1 then
call IssuePointOrderLoc(GetAttacker(),"ward",bo)
else
