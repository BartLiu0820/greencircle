function BPx takes nothing returns boolean
return L1>=16 and L3==1 and GetHeroStr(SL,false)+GetHeroAgi(SL,false)+GetHeroInt(SL,false)>=800 and GetAttacker()==SL
endfunction
function BPy takes nothing returns nothing
if L2>=7 then
set L2=0
set L1=0
else
set L2=L2+1
endif
set bo=GetUnitLoc(GetAttackedUnitBJ())
call UnitDamagePointLoc(GetAttacker(),.15,200.,bo,GetUnitStateSwap(ConvertUnitState(21),SL)*12.,ATTACK_TYPE_PIERCE,DAMAGE_TYPE_ENHANCED)
call AddSpecialEffectLocBJ(bo,"Abilities\\Spells\\Human\\Thunderclap\\ThunderClapCaster.mdl")
call DestroyEffect(GetLastCreatedEffectBJ())
call RemoveLocation(bo)
endfunction
function BPz takes nothing returns nothing
set bq=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(bq,EVENT_PLAYER_UNIT_ATTACKED)
call TriggerAddCondition(bq,Condition(function BPx))
call TriggerAddAction(bq,function BPy)
endfunction
function BP0 takes nothing returns boolean
return GetAttacker()==SL and UnitHasBuffBJ(GetAttackedUnitBJ(),$42637364)==true and GetUnitLifePercent(GetAttackedUnitBJ())>=50. and ME>=4
endfunction
function BP1 takes nothing returns nothing
set bo=GetUnitLoc(GetAttackedUnitBJ())
set ME=0
if GetHeroStatBJ(bj_HEROSTAT_INT,SL,false)>=400 then
call UnitDamagePointLoc(GetAttacker(),.15,200.,bo,GetUnitStateSwap(UNIT_STATE_MAX_LIFE,GetAttackedUnitBJ())/10.,ATTACK_TYPE_HERO,DAMAGE_TYPE_ENHANCED)
else
call UnitDamagePointLoc(GetAttacker(),.15,200.,bo,GetUnitStateSwap(UNIT_STATE_MAX_LIFE,GetAttackedUnitBJ())/20.,ATTACK_TYPE_HERO,DAMAGE_TYPE_ENHANCED)
endif
call AddSpecialEffectLocBJ(bo,"Abilities\\Spells\\Undead\\FreezingBreath\\FreezingBreathTargetArt.mdl")
call DestroyEffect(GetLastCreatedEffectBJ())
call RemoveLocation(bo)
endfunction
function BP2 takes nothing returns nothing
set br=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(br,EVENT_PLAYER_UNIT_ATTACKED)
call TriggerAddCondition(br,Condition(function BP0))
call TriggerAddAction(br,function BP1)
endfunction
function BP3 takes nothing returns boolean
return GetUnitTypeId(GetConstructedStructure())==$68303552
endfunction
function BP4 takes nothing returns nothing
if CountUnitsInGroup(jz($68303552))>1 or CountUnitsInGroup(jz($48303553))>1 or CountUnitsInGroup(jz($48303630))>1 or JW[GetConvertedPlayerId(GetTriggerPlayer())]==1 then
call RemoveUnit(GetConstructedStructure())
call SetPlayerStateBJ(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_GOLD)+1500)
call SetPlayerStateBJ(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_LUMBER,GetPlayerState(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_LUMBER)+5)
set XN=GetRandomLocInRect(s)
call CreateNUnitsAtLoc(1,$6F766C6E,GetTriggerPlayer(),XN,bj_UNIT_FACING)
call RemoveLocation(XN)
call DisplayTextToForce(jq(GetTriggerPlayer()),"|cffff0303全场只能建造一个|r")
else
if jp($6E303343,GetTriggerPlayer())>=1 or H4[GetConvertedPlayerId(GetTriggerPlayer())]>=10 then
call DoNothing()
else
call RemoveUnit(GetConstructedStructure())
endif
endif
endfunction
function BP5 takes nothing returns nothing
set bs=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(bs,EVENT_PLAYER_UNIT_CONSTRUCT_FINISH)
call TriggerAddCondition(bs,Condition(function BP3))
call TriggerAddAction(bs,function BP4)
endfunction
function BP6 takes nothing returns boolean
return GetUnitTypeId(GetConstructingStructure())==$68303552
endfunction
function BP7 takes nothing returns nothing
if CountUnitsInGroup(jz($68303552))>1 or CountUnitsInGroup(jz($48303553))>1 or CountUnitsInGroup(jz($48303630))>1 or JW[GetConvertedPlayerId(GetTriggerPlayer())]==1 then
call DoNothing()
else
if jp($6E303343,GetTriggerPlayer())<1 and H4[GetConvertedPlayerId(GetTriggerPlayer())]<10 then
set XN=GetRandomLocInRect(s)
call CreateNUnitsAtLoc(1,$6F766C6E,GetTriggerPlayer(),XN,bj_UNIT_FACING)
call RemoveLocation(XN)
call SetPlayerStateBJ(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_GOLD)+1500)
call SetPlayerStateBJ(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_LUMBER,GetPlayerState(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_LUMBER)+5)
call DisplayTextToForce(jq(GetTriggerPlayer()),"|cffff0303需要10点成就|r")
else
endif
endif
endfunction
function BP8 takes nothing returns nothing
set bt=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(bt,EVENT_PLAYER_UNIT_CONSTRUCT_START)
call TriggerAddCondition(bt,Condition(function BP6))
call TriggerAddAction(bt,function BP7)
endfunction
function BP9 takes nothing returns nothing
if GetUnitTypeId(GetConstructedStructure())==$68303552 and CountUnitsInGroup(jz($68303552))<=1 and CountUnitsInGroup(jz($48303553))<=1 and CountUnitsInGroup(jz($48303630))<=1 and jp($6E303343,GetTriggerPlayer())>=1 and JW[GetConvertedPlayerId(GetTriggerPlayer())]==0 then
if jp($6E303343,GetTriggerPlayer())>=1 then
set H4[GetConvertedPlayerId(GetTriggerPlayer())]=H4[GetConvertedPlayerId(GetTriggerPlayer())]+10
else
call DoNothing()
endif
if IV[GetConvertedPlayerId(GetTriggerPlayer())]>=1 or lo(GetTriggerPlayer(),"赞+7")>=1000 and Kl[GetConvertedPlayerId(GetTriggerPlayer())]==0 then
call CreateNUnitsAtLoc(1,$48303630,GetOwningPlayer(GetTriggerUnit()),OffsetLocation(GetUnitLoc(GetTriggerUnit()),10.,0),bj_UNIT_FACING)
else
call CreateNUnitsAtLoc(1,$48303553,GetOwningPlayer(GetTriggerUnit()),OffsetLocation(GetUnitLoc(GetTriggerUnit()),10.,0),bj_UNIT_FACING)
endif
set SF=GetLastCreatedUnit()
set ZB=GetUnitLoc(GetLastCreatedUnit())
set H4[GetConvertedPlayerId(GetTriggerPlayer())]=H4[GetConvertedPlayerId(GetTriggerPlayer())]-10
call ModifyHeroSkillPoints(GetLastCreatedUnit(),bj_MODIFYMETHOD_ADD,3)
set DR[GetConvertedPlayerId(GetTriggerPlayer())]=GetRandomInt(0,7)
set DS[GetConvertedPlayerId(GetTriggerPlayer())]=GetRandomInt(0,7-DR[GetConvertedPlayerId(GetTriggerPlayer())])
set DT[GetConvertedPlayerId(GetTriggerPlayer())]=7-(DR[GetConvertedPlayerId(GetTriggerPlayer())]+DS[GetConvertedPlayerId(GetTriggerPlayer())])
call DisplayTimedTextToPlayer(GetOwningPlayer(GetTriggerUnit()),0,0,5.,"|cff20c000英雄成长值(每次升级获得属性自动分配)|r:")
call DisplayTextToPlayer(GetTriggerPlayer(),0,0,"|cffff0303力量:     "+(I2S(DR[GetConvertedPlayerId(GetTriggerPlayer())]+1)+"|r"))
call DisplayTextToPlayer(GetTriggerPlayer(),0,0,"|c00fffc01敏捷:     "+(I2S(DS[GetConvertedPlayerId(GetTriggerPlayer())]+1)+"|r"))
call DisplayTextToPlayer(GetTriggerPlayer(),0,0,"|cff0042ff智力:     "+(I2S(DT[GetConvertedPlayerId(GetTriggerPlayer())]+1)+"|r"))
else
call DoNothing()
endif
endfunction
function BQB takes nothing returns nothing
set bu=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(bu,EVENT_PLAYER_UNIT_CONSTRUCT_FINISH)
call TriggerAddAction(bu,function BP9)
endfunction
function BQC takes nothing returns boolean
return GetSpellAbilityId()==$41304D38 or GetSpellAbilityId()==$41304D41 or GetSpellAbilityId()==$41304D39 or GetSpellAbilityId()==$41304D42 or GetSpellAbilityId()==$4130504C
endfunction
function BQD takes nothing returns nothing
set Oe=GetUnitLoc(GetTriggerUnit())
if GetSpellAbilityId()==$4130504C then
if KG==0 then
set KG=1
call SetUnitAbilityLevelSwapped($4130504D,GetTriggerUnit(),1)
else
set KG=0
call SetUnitAbilityLevelSwapped($4130504D,GetTriggerUnit(),2)
endif
else
call DoNothing()
endif
if DU[GetConvertedPlayerId(GetTriggerPlayer())]<4 and GetPlayerState(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_LUMBER)>=1*(DU[GetConvertedPlayerId(GetTriggerPlayer())]*18) and GetHeroStatBJ(bj_HEROSTAT_STR,GetTriggerUnit(),true)>=DU[GetConvertedPlayerId(GetTriggerPlayer())]*80 then
if GetSpellAbilityId()==$41304D38 and KE!=1 then
call AddSpecialEffectLocBJ(Oe,"Abilities\\Spells\\Human\\Resurrect\\ResurrectTarget.mdl")
call DestroyEffect(GetLastCreatedEffectBJ())
call UnitAddAbilityBJ($41304D44,GetSpellAbilityUnit())
if GetUnitAbilityLevelSwapped($41304D47,GetTriggerUnit())==1 then
call SetUnitAbilityLevelSwapped($41304D44,GetTriggerUnit(),2)
else
endif
call SetPlayerStateBJ(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_LUMBER,GetPlayerState(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_LUMBER)-1*(DU[GetConvertedPlayerId(GetTriggerPlayer())]*18))
set DU[GetConvertedPlayerId(GetTriggerPlayer())]=DU[GetConvertedPlayerId(GetTriggerPlayer())]+1
set KE=1
else
if GetSpellAbilityId()==$41304D41 and KF!=1 then
call AddSpecialEffectLocBJ(Oe,"Abilities\\Spells\\Human\\Resurrect\\ResurrectTarget.mdl")
call DestroyEffect(GetLastCreatedEffectBJ())
call UnitAddAbilityBJ($41304D45,GetSpellAbilityUnit())
if GetUnitAbilityLevelSwapped($41304D47,GetTriggerUnit())==1 then
call SetUnitAbilityLevelSwapped($41304D45,GetTriggerUnit(),2)
else
endif
call SetPlayerStateBJ(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_LUMBER,GetPlayerState(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_LUMBER)-1*(DU[GetConvertedPlayerId(GetTriggerPlayer())]*18))
set DU[GetConvertedPlayerId(GetTriggerPlayer())]=DU[GetConvertedPlayerId(GetTriggerPlayer())]+1
set KF=1
else
if GetSpellAbilityId()==$41304D39 and KJ!=1 then
call AddSpecialEffectLocBJ(Oe,"Abilities\\Spells\\Human\\Resurrect\\ResurrectTarget.mdl")
call DestroyEffect(GetLastCreatedEffectBJ())
set KH=1
call UnitAddAbilityBJ($41304D47,GetSpellAbilityUnit())
call SetPlayerStateBJ(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_LUMBER,GetPlayerState(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_LUMBER)-1*(DU[GetConvertedPlayerId(GetTriggerPlayer())]*18))
set DU[GetConvertedPlayerId(GetTriggerPlayer())]=DU[GetConvertedPlayerId(GetTriggerPlayer())]+1
set KJ=1
else
if GetSpellAbilityId()==$41304D42 and KI!=1 then
call AddSpecialEffectLocBJ(Oe,"Abilities\\Spells\\Human\\Resurrect\\ResurrectTarget.mdl")
call DestroyEffect(GetLastCreatedEffectBJ())
call UnitAddAbilityBJ($41304D48,GetSpellAbilityUnit())
call SetUnitAbilityLevelSwapped($41304D44,GetTriggerUnit(),2)
call SetUnitAbilityLevelSwapped($41304D45,GetTriggerUnit(),2)
call SetPlayerStateBJ(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_LUMBER,GetPlayerState(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_LUMBER)-1*(DU[GetConvertedPlayerId(GetTriggerPlayer())]*18))
set DU[GetConvertedPlayerId(GetTriggerPlayer())]=DU[GetConvertedPlayerId(GetTriggerPlayer())]+1
set KI=1
else
if GetSpellAbilityId()==$4130504C and KK!=1 then
call AddSpecialEffectLocBJ(Oe,"Abilities\\Spells\\Human\\Resurrect\\ResurrectTarget.mdl")
call DestroyEffect(GetLastCreatedEffectBJ())
call UnitAddAbilityBJ($4130504D,GetSpellAbilityUnit())
set KG=1
call SetPlayerStateBJ(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_LUMBER,GetPlayerState(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_LUMBER)-1*(DU[GetConvertedPlayerId(GetTriggerPlayer())]*18))
set DU[GetConvertedPlayerId(GetTriggerPlayer())]=DU[GetConvertedPlayerId(GetTriggerPlayer())]+1
set KK=1
else
endif
endif
endif
endif
endif
else
call DoNothing()
endif
call RemoveLocation(Oe)
endfunction
