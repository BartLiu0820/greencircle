if GetUnitAbilityLevelSwapped($41303634,GetAttacker())>=1 and GetUnitAbilityLevelSwapped($41303634,GetAttacker())!=(0+GetHeroAgi(GetAttacker(),false))/30 and GetUnitAbilityLevelSwapped($41303634,GetAttacker())<=9 then
