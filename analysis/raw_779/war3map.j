call SetPlayerStateBJ(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_GOLD)-5000)
else
if GetSpellAbilityId()==$41304A45 and HC[4]==1 and GetUnitStateSwap(UNIT_STATE_MANA,GetSpellAbilityUnit())>=500. and GetPlayerState(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_GOLD)>=5000 then
