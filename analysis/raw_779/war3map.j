function BR0 takes nothing returns nothing
if J9>=12 and GetUnitAbilityLevelSwapped($4130504A,J3)>=1 then
set J9=0
set KB=KB+5
call IssuePointOrderLoc(J6[5],"silence",ZE)
call IssuePointOrderLoc(J6[1],"silence",cg[1])
