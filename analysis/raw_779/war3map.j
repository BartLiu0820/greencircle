function BIM takes nothing returns nothing
set T4=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(T4,EVENT_PLAYER_UNIT_PICKUP_ITEM)
call TriggerAddCondition(T4,Condition(function BIK))
call TriggerAddAction(T4,function BIL)
endfunction
function BIN takes nothing returns boolean
return GetItemTypeId(GetManipulatedItem())==$49303157 and GetPlayerState(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_LUMBER)>=20
endfunction
function BIO takes nothing returns nothing
if FQ>0 then
if H4[GetConvertedPlayerId(GetTriggerPlayer())]>=5 then
set FQ=FQ-1
set H4[GetConvertedPlayerId(GetTriggerPlayer())]=H4[GetConvertedPlayerId(GetTriggerPlayer())]-5
call DisplayTimedTextToPlayer(GetOwningPlayer(GetTriggerUnit()),0,0,5.,"|c008000FF购买成功|r")
call UnitAddItemByIdSwapped($49303158,GetTriggerUnit())
call SetPlayerStateBJ(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_LUMBER,GetPlayerState(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_LUMBER)-20)
else
set KL=EXNetUseItem(GetTriggerPlayer(),"3012113",5)
if KL==true then
set FQ=FQ-1
call DisplayTimedTextToPlayer(GetOwningPlayer(GetTriggerUnit()),0,0,5.,"|c008000FF购买成功|r")
call UnitAddItemByIdSwapped($49303158,GetTriggerUnit())
call SetPlayerStateBJ(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_LUMBER,GetPlayerState(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_LUMBER)-20)
else
call DisplayTimedTextToPlayer(GetOwningPlayer(GetTriggerUnit()),0,0,5.,"|c008000FF成就不足|r")
endif
endif
else
call DisplayTimedTextToPlayer(GetOwningPlayer(GetTriggerUnit()),0,0,5.,"|c008000FF已无库存|r")
endif
endfunction
function BIP takes nothing returns nothing
set YQ=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(YQ,EVENT_PLAYER_UNIT_PICKUP_ITEM)
call TriggerAddCondition(YQ,Condition(function BIN))
call TriggerAddAction(YQ,function BIO)
endfunction
function BIQ takes nothing returns nothing
call lG($49303152,3,$63686573,0,$63686573,0,$63686573,0,$63686573,0,$63686573,0,$49303153)
endfunction
function BIR takes nothing returns nothing
set YR=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(YR,EVENT_PLAYER_UNIT_PICKUP_ITEM)
call TriggerAddAction(YR,function BIQ)
endfunction
