call RemoveSavedHandle(BQ,CN,Ca)
endfunction
function lQ takes nothing returns nothing
call RemoveItem(LoadItemHandle(BQ,CN,Ca))
call RemoveSavedHandle(BQ,CN,Ca)
endfunction
function lS takes nothing returns nothing
call DestroyEffect(LoadEffectHandle(BQ,CN,Ca))
call RemoveSavedHandle(BQ,CN,Ca)
endfunction
function lU takes nothing returns nothing
call DestroyLightning(LoadLightningHandle(BQ,CN,Ca))
call RemoveSavedHandle(BQ,CN,Ca)
endfunction
function lW takes nothing returns nothing
call TriggerExecute(LoadTriggerHandle(BQ,CN,Ca))
call RemoveSavedHandle(BQ,CN,Ca)
endfunction
function lZ takes nothing returns nothing
local integer Cb=CP
loop
set Ca=CQ[Cb]
exitwhen Ca<0 or CO<Cc[Ca]
call TriggerEvaluate(Cd[Ca])
call lI(Ca)
set CQ[Cb]=CQ[Ca]
endloop
set CO=CO+1
endfunction
function la takes nothing returns nothing
set CM=CreateTimer()
set CN=GetHandleId(CM)
set CO=0
set CP=0
set CQ[0]=-1
set CR=1
set CS=1
set CT[1]=-1
set CU=CreateTrigger()
set CV=CreateTrigger()
set CW=CreateTrigger()
set CX=CreateTrigger()
set CY=CreateTrigger()
set CZ=CreateTrigger()
call TriggerAddCondition(CU,Condition(function lM))
call TriggerAddCondition(CV,Condition(function lO))
call TriggerAddCondition(CW,Condition(function lQ))
call TriggerAddCondition(CX,Condition(function lS))
call TriggerAddCondition(CY,Condition(function lU))
call TriggerAddCondition(CZ,Condition(function lW))
call TimerStart(CM,.01,true,function lZ)
endfunction
