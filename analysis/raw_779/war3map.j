function BaJ takes nothing returns nothing
set fy=CreateTrigger()
call TriggerRegisterUnitEvent(fy,BN,EVENT_UNIT_DEATH)
call TriggerRegisterUnitEvent(fy,BG,EVENT_UNIT_DEATH)
call TriggerRegisterUnitEvent(fy,BL,EVENT_UNIT_DEATH)
call TriggerRegisterUnitEvent(fy,BJ,EVENT_UNIT_DEATH)
call TriggerRegisterUnitEvent(fy,BH,EVENT_UNIT_DEATH)
call TriggerRegisterUnitEvent(fy,BM,EVENT_UNIT_DEATH)
call TriggerRegisterUnitEvent(fy,BK,EVENT_UNIT_DEATH)
call TriggerRegisterUnitEvent(fy,BI,EVENT_UNIT_DEATH)
call TriggerAddAction(fy,function BaI)
endfunction
