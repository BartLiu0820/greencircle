set Gi[GetConvertedPlayerId(GetTriggerPlayer())]=1
set Oe=GetUnitLoc(GetTriggerUnit())
call AddSpecialEffectLocBJ(Oe,"Abilities\\Spells\\Human\\Resurrect\\ResurrectTarget.mdl")
call DestroyEffect(GetLastCreatedEffectBJ())
call RemoveLocation(Oe)
call UnitAddAbilityBJ($41304757,FirstOfGroup(jz($48303349)))
call SetPlayerStateBJ(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_LUMBER,GetPlayerState(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_LUMBER)-1*(DU[GetConvertedPlayerId(GetTriggerPlayer())]*18))
set DU[GetConvertedPlayerId(GetTriggerPlayer())]=DU[GetConvertedPlayerId(GetTriggerPlayer())]+1
else
if GetSpellAbilityId()==$41304834 and Gj[GetConvertedPlayerId(GetTriggerPlayer())]==0 then
set Gj[GetConvertedPlayerId(GetTriggerPlayer())]=1
set Oe=GetUnitLoc(GetTriggerUnit())
call AddSpecialEffectLocBJ(Oe,"Abilities\\Spells\\Human\\Resurrect\\ResurrectTarget.mdl")
call DestroyEffect(GetLastCreatedEffectBJ())
call RemoveLocation(Oe)
call UnitAddAbilityBJ($41304758,FirstOfGroup(jz($48303349)))
call SetPlayerStateBJ(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_LUMBER,GetPlayerState(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_LUMBER)-1*(DU[GetConvertedPlayerId(GetTriggerPlayer())]*18))
set DU[GetConvertedPlayerId(GetTriggerPlayer())]=DU[GetConvertedPlayerId(GetTriggerPlayer())]+1
else
if GetSpellAbilityId()==$41304832 and Gl[GetConvertedPlayerId(GetTriggerPlayer())]==0 then
set Gl[GetConvertedPlayerId(GetTriggerPlayer())]=1
set Oe=GetUnitLoc(GetTriggerUnit())
call AddSpecialEffectLocBJ(Oe,"Abilities\\Spells\\Human\\Resurrect\\ResurrectTarget.mdl")
call DestroyEffect(GetLastCreatedEffectBJ())
call RemoveLocation(Oe)
call UnitAddAbilityBJ($41304759,FirstOfGroup(jz($48303349)))
set GC[GetConvertedPlayerId(GetTriggerPlayer())]=2
call SetPlayerStateBJ(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_LUMBER,GetPlayerState(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_LUMBER)-1*(DU[GetConvertedPlayerId(GetTriggerPlayer())]*18))
set DU[GetConvertedPlayerId(GetTriggerPlayer())]=DU[GetConvertedPlayerId(GetTriggerPlayer())]+1
else
if GetSpellAbilityId()==$41305543 and NX[GetConvertedPlayerId(GetTriggerPlayer())]==0 then
set NX[GetConvertedPlayerId(GetTriggerPlayer())]=1
set Oe=GetUnitLoc(GetTriggerUnit())
call AddSpecialEffectLocBJ(Oe,"Abilities\\Spells\\Human\\Resurrect\\ResurrectTarget.mdl")
