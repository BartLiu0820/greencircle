else
call DoNothing()
endif
endif
endif
endif
endif
else
call DoNothing()
endif
if GetHeroLevel(GetTriggerUnit())>=15 then
if GetSpellAbilityId()==$41304A44 and HC[1]==1 and GetUnitStateSwap(UNIT_STATE_MANA,GetSpellAbilityUnit())>=500. and GetPlayerState(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_GOLD)>=5000 then
