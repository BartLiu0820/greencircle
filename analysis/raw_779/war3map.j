if GetSpellAbilityId()==$41305043 and GetUnitAbilityLevelSwapped($41305043,GetTriggerUnit())<GetHeroStr(J3,false)/32 and GetUnitAbilityLevelSwapped($41305043,GetTriggerUnit())<10 then
