else
endif
set Kf=2
else
call ModifyHeroStat(bj_HEROSTAT_INT,SV,bj_MODIFYMETHOD_ADD,Kg*30)
if IV[GetConvertedPlayerId(GetOwningPlayer(SV))]>=1 or lo(GetOwningPlayer(SV),"赞+7")>=700 then
call SetUnitVertexColor(SV,100,100,255,255)
else
endif
set Kf=3
endif
endif
endfunction
