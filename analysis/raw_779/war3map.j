call UnitDamagePointLoc(GetAttacker(),.1,250.,Oe,I2R(GetHeroStatBJ(bj_HEROSTAT_STR,GetAttacker(),false))*80.,ATTACK_TYPE_PIERCE,DAMAGE_TYPE_NORMAL)
call CreateTextTagUnitBJ("|cffff0303"+(I2S(GetHeroStatBJ(bj_HEROSTAT_STR,GetAttacker(),false)*80)+"！|r"),GetAttackedUnitBJ(),0,10.,100,0.,0.,0)
call SetTextTagPermanent(GetLastCreatedTextTag(),false)
