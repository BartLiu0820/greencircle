function BHE takes nothing returns nothing
set Ph=GetSpellTargetUnit()
if Ph!=SV and IsUnitType(GetSpellTargetUnit(),UNIT_TYPE_HERO)==true and GetOwningPlayer(Ph)!=Player(11) and GetHeroStatBJ(bj_HEROSTAT_STR,Ph,false)>=7 and GetHeroStatBJ(bj_HEROSTAT_AGI,Ph,false)>=7 and GetHeroStatBJ(bj_HEROSTAT_INT,Ph,false)>=7 then
call RemoveItem(jr(GetSpellAbilityUnit(),$49303050))
call ModifyHeroSkillPoints(Ph,bj_MODIFYMETHOD_ADD,3)
if GetUnitTypeId(GetSpellTargetUnit())==$4830354A then
if GetRandomInt(1,3)==1 then
call ModifyHeroStat(bj_HEROSTAT_STR,Ph,bj_MODIFYMETHOD_SUB,6)
call DisplayTextToPlayer(GetOwningPlayer(GetTriggerUnit()),0,0,"|cffff0303英雄重修力量6点|r")
else
if GetRandomInt(1,2)==1 then
call ModifyHeroStat(bj_HEROSTAT_AGI,Ph,bj_MODIFYMETHOD_SUB,6)
call DisplayTextToPlayer(GetOwningPlayer(GetTriggerUnit()),0,0,"|cffff0303英雄重修敏捷6点|r")
else
call DisplayTextToPlayer(GetOwningPlayer(GetTriggerUnit()),0,0,"|cffff0303英雄重修智力6点|r")
call ModifyHeroStat(bj_HEROSTAT_INT,Ph,bj_MODIFYMETHOD_SUB,6)
endif
endif
else
if GetUnitAbilityLevelSwapped($41304344,Ph)==1 then
call ModifyHeroStat(bj_HEROSTAT_STR,Ph,bj_MODIFYMETHOD_SUB,6)
call DisplayTextToPlayer(GetOwningPlayer(GetTriggerUnit()),0,0,"|cffff0303英雄重修力量6点|r")
else
if GetUnitAbilityLevelSwapped($41304344,Ph)==2 then
call ModifyHeroStat(bj_HEROSTAT_AGI,Ph,bj_MODIFYMETHOD_SUB,6)
call DisplayTextToPlayer(GetOwningPlayer(GetTriggerUnit()),0,0,"|cffff0303英雄重修敏捷6点|r")
else
if GetUnitAbilityLevelSwapped($41304344,Ph)==3 then
call ModifyHeroStat(bj_HEROSTAT_INT,Ph,bj_MODIFYMETHOD_SUB,6)
call DisplayTextToPlayer(GetOwningPlayer(GetTriggerUnit()),0,0,"|cffff0303英雄重修智力6点|r")
else
call DoNothing()
endif
endif
endif
endif
else
call DoNothing()
endif
endfunction
