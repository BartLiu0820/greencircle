function BRc takes nothing returns nothing
set JM=JO[1]*JO[2]*(JO[3]*JO[4])*(GetHeroStr(Pp,false)+GetHeroAgi(Pp,false)+GetHeroInt(Pp,false))/1
set JS=GetRandomInt(JM*(JR+LY*3)/100,JM)
