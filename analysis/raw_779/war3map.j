call SetUnitAbilityLevelSwapped($4130475A,GetLastCreatedUnit(),GetUnitAbilityLevelSwapped($41304758,GetAttacker())+1)
call SetUnitAbilityLevelSwapped($41304830,GetLastCreatedUnit(),GetUnitAbilityLevelSwapped($41304757,GetAttacker())+1)
call UnitApplyTimedLifeBJ(8.,$42726169,GetLastCreatedUnit())
