function BSR takes nothing returns boolean
return GetTriggerUnit()==SV and GetSpellAbilityId()==$41305131 or GetSpellAbilityId()==$4130505A or GetSpellAbilityId()==$41305132 or GetSpellAbilityId()==$41305130 or GetSpellAbilityId()==$41305133
endfunction
function BSS takes nothing returns nothing
if Ke==0 and GetSpellAbilityId()!=$41305133 then
call AddSpecialEffectLocBJ(ct,"Abilities\\Spells\\Undead\\DeathPact\\DeathPactTarget.mdl")
call DestroyEffect(GetLastCreatedEffectBJ())
set Ke=1
set Kc=0
set Kd=0
if GetSpellAbilityId()==$41305131 then
set Kb=1
else
if GetSpellAbilityId()==$4130505A then
set Kb=2
else
if GetSpellAbilityId()==$41305132 then
set Kb=3
else
if GetSpellAbilityId()==$41305130 then
set Kb=4
else
call DoNothing()
endif
endif
endif
endif
else
if GetSpellAbilityId()!=$41305133 and Kb>=0 and Kc==0 and Kd==0 then
if GetSpellAbilityId()==$41305131 then
set Kc=1
else
if GetSpellAbilityId()==$4130505A then
set Kc=2
else
if GetSpellAbilityId()==$41305132 then
set Kc=3
else
if GetSpellAbilityId()==$41305130 then
set Kc=4
else
call DoNothing()
endif
endif
endif
endif
else
if Kb>=0 and Kc>=0 and Kd==0 and GetSpellAbilityId()!=$41305133 then
call DisplayTimedTextToPlayer(GetOwningPlayer(GetTriggerUnit()),0,0,5.,"|cff20c000药水技能合成成功"+""+"|r")
set Ke=0
call AddSpecialEffectLocBJ(ct,"Abilities\\Spells\\Human\\MassTeleport\\MassTeleportCaster.mdl")
call DestroyEffect(GetLastCreatedEffectBJ())
if GetSpellAbilityId()==$41305131 then
set Kd=1
else
if GetSpellAbilityId()==$4130505A then
set Kd=2
else
if GetSpellAbilityId()==$41305132 then
set Kd=3
else
if GetSpellAbilityId()==$41305130 then
set Kd=4
else
call DoNothing()
endif
endif
endif
endif
else
endif
endif
endif
if GetSpellAbilityId()==$41305133 and GetPlayerState(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_LUMBER)>=10 and GetUnitAbilityLevelSwapped(GetSpellAbilityId(),GetTriggerUnit())<10 then
call IncUnitAbilityLevelSwapped(GetSpellAbilityId(),GetTriggerUnit())
call SetPlayerStateBJ(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_LUMBER,GetPlayerState(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_LUMBER)-10)
else
endif
endfunction
function BST takes nothing returns nothing
set cu=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(cu,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(cu,Condition(function BSR))
call TriggerAddAction(cu,function BSS)
endfunction
