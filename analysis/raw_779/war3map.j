call DestroyEffect(GetLastCreatedEffectBJ())
call IncUnitAbilityLevelSwapped($41304A47,GetTriggerUnit())
call SetPlayerTechResearchedSwap($5230304C,1,GetTriggerPlayer())
call SetUnitManaBJ(GetTriggerUnit(),GetUnitStateSwap(UNIT_STATE_MANA,GetTriggerUnit())-500.)
call SetPlayerStateBJ(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_GOLD)-5000)
else
if GetSpellAbilityId()==$41304A43 and HC[2]==1 and GetUnitStateSwap(UNIT_STATE_MANA,GetSpellAbilityUnit())>=500. and GetPlayerState(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_GOLD)>=5000 then
