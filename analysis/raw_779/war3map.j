set Km=Km-1
call CreateTextTagUnitBJ(I2S(Km),R9,0,9.,100.,100.,0.,0)
call SetTextTagPermanent(GetLastCreatedTextTag(),false)
call SetTextTagVelocityBJ(GetLastCreatedTextTag(),100.,270.)
call SetTextTagFadepoint(GetLastCreatedTextTag(),1.)
call SetTextTagLifespan(GetLastCreatedTextTag(),1.)
set dJ=OffsetLocation(ZF,GetRandomReal(-700.,700.),GetRandomReal(-700.,700.))
set dK=OffsetLocation(ZF,GetRandomReal(-700.,700.),GetRandomReal(-700.,700.))
set dL=OffsetLocation(ZF,GetRandomReal(-700.,700.),GetRandomReal(-700.,700.))
set dM=OffsetLocation(ZF,GetRandomReal(-700.,700.),GetRandomReal(-700.,700.))
