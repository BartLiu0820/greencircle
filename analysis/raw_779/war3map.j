set Oe=GetUnitLoc(GetTriggerUnit())
if DU[GetConvertedPlayerId(GetTriggerPlayer())]<4 and GetPlayerState(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_LUMBER)>=1*(DU[GetConvertedPlayerId(GetTriggerPlayer())]*18) and GetHeroStatBJ(bj_HEROSTAT_STR,GetTriggerUnit(),true)>=DU[GetConvertedPlayerId(GetTriggerPlayer())]*80 then
if GetSpellAbilityId()==$41304A52 and GetUnitAbilityLevelSwapped($41304B30,GetTriggerUnit())!=1 then
call AddSpecialEffectLocBJ(Oe,"Abilities\\Spells\\Human\\Resurrect\\ResurrectTarget.mdl")
call DestroyEffect(bj_lastCreatedEffect)
call CreateNUnitsAtLoc(1,$6E303637,GetOwningPlayer(GetTriggerUnit()),Oe,bj_UNIT_FACING)
set YC=GetLastCreatedUnit()
call SetUnitAbilityLevelSwapped($41304A50,GetLastCreatedUnit(),GetHeroStatBJ(bj_HEROSTAT_INT,GetTriggerUnit(),false)/25)
if GetUnitTypeId(GetTriggerUnit())==$48303545 then
else
call DoNothing()
endif
call DestroyEffect(GetLastCreatedEffectBJ())
call UnitAddAbilityBJ($41304B30,GetSpellAbilityUnit())
call SetPlayerStateBJ(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_LUMBER,GetPlayerState(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_LUMBER)-1*(DU[GetConvertedPlayerId(GetTriggerPlayer())]*18))
set DU[GetConvertedPlayerId(GetTriggerPlayer())]=DU[GetConvertedPlayerId(GetTriggerPlayer())]+1
else
if GetSpellAbilityId()==$41304A53 and GetUnitAbilityLevelSwapped($41304A5A,GetTriggerUnit())!=1 then
call CreateNUnitsAtLoc(3,$6E303636,GetOwningPlayer(GetTriggerUnit()),Oe,bj_UNIT_FACING)
call AddSpecialEffectLocBJ(Oe,"Abilities\\Spells\\Human\\Resurrect\\ResurrectTarget.mdl")
call DestroyEffect(GetLastCreatedEffectBJ())
call UnitAddAbilityBJ($41304A5A,GetSpellAbilityUnit())
call UnitAddAbilityBJ($41304A5A,FirstOfGroup(jz($68303546)))
call SetPlayerStateBJ(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_LUMBER,GetPlayerState(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_LUMBER)-1*(DU[GetConvertedPlayerId(GetTriggerPlayer())]*18))
set DU[GetConvertedPlayerId(GetTriggerPlayer())]=DU[GetConvertedPlayerId(GetTriggerPlayer())]+1
else
if GetSpellAbilityId()==$41304B32 and GetUnitAbilityLevelSwapped($41304A59,GetTriggerUnit())!=1 and GetUnitAbilityLevelSwapped($41304A59,GetTriggerUnit())!=2 and GetUnitAbilityLevelSwapped($41304A59,GetTriggerUnit())!=3 then
call AddSpecialEffectLocBJ(Oe,"Abilities\\Spells\\Human\\Resurrect\\ResurrectTarget.mdl")
call DestroyEffect(GetLastCreatedEffectBJ())
call UnitAddAbilityBJ($41304A59,GetSpellAbilityUnit())
call SetPlayerStateBJ(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_LUMBER,GetPlayerState(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_LUMBER)-1*(DU[GetConvertedPlayerId(GetTriggerPlayer())]*18))
set DU[GetConvertedPlayerId(GetTriggerPlayer())]=DU[GetConvertedPlayerId(GetTriggerPlayer())]+1
else
if GetSpellAbilityId()==$41304A54 and GetUnitAbilityLevelSwapped($41304B33,GetTriggerUnit())!=1 then
call AddSpecialEffectLocBJ(Oe,"Abilities\\Spells\\Human\\Resurrect\\ResurrectTarget.mdl")
call DestroyEffect(GetLastCreatedEffectBJ())
call UnitAddAbilityBJ($41304B33,GetSpellAbilityUnit())
call SetPlayerStateBJ(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_LUMBER,GetPlayerState(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_LUMBER)-1*(DU[GetConvertedPlayerId(GetTriggerPlayer())]*18))
set DU[GetConvertedPlayerId(GetTriggerPlayer())]=DU[GetConvertedPlayerId(GetTriggerPlayer())]+1
else
call DoNothing()
endif
endif
endif
endif
else
call DoNothing()
endif
if GetSpellAbilityId()==$41304B32 and GetUnitAbilityLevelSwapped($41304A59,GetTriggerUnit())>=1 then
if HJ==0 then
set HJ=1
else
set HJ=0
endif
else
call DoNothing()
endif
call RemoveLocation(Oe)
endfunction
