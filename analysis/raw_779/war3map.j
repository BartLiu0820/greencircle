if GetUnitAbilityLevelSwapped($41304759,GetAttacker())>=1 and GetPlayerTechCountSimple($52303042,GetOwningPlayer(GetAttacker()))!=GetHeroStatBJ(bj_HEROSTAT_INT,GetAttacker(),false)/40 then
