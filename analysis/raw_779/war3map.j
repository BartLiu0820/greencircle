function BV9 takes nothing returns nothing
if GetUnitTypeId(GetAttackedUnitBJ())==$6E6A6761 or GetUnitTypeId(GetAttackedUnitBJ())==$6E736B67 or GetUnitTypeId(GetAttackedUnitBJ())==$6E766467 or GetUnitTypeId(GetAttackedUnitBJ())==$6E656C62 or GetUnitTypeId(GetAttackedUnitBJ())==$6E636877 or GetUnitTypeId(GetAttackedUnitBJ())==$6E616E6D or GetUnitTypeId(GetAttackedUnitBJ())==$6E62616C or GetUnitTypeId(GetAttackedUnitBJ())==$6E6C6B6C or GetUnitTypeId(GetAttackedUnitBJ())==$6E6A6762 or GetUnitTypeId(GetAttackedUnitBJ())==$6E6A6731 or GetUnitTypeId(GetAttackedUnitBJ())==$6E736F63 or GetUnitTypeId(GetAttackedUnitBJ())==$6E736B6F or GetUnitTypeId(GetAttackedUnitBJ())==$6E736C6D or GetUnitTypeId(GetAttackedUnitBJ())==$6E736B6F or GetUnitTypeId(GetAttackedUnitBJ())==$6E303730 or GetUnitTypeId(GetAttackedUnitBJ())==$6E303731 or GetUnitTypeId(GetAttackedUnitBJ())==$6E303734 or GetUnitTypeId(GetAttackedUnitBJ())==$6E303733 or GetUnitTypeId(GetAttackedUnitBJ())==$6E303732 or GetUnitTypeId(GetAttackedUnitBJ())==$6E303735 or GetUnitTypeId(GetAttackedUnitBJ())==$6E647264 or GetUnitTypeId(GetAttackedUnitBJ())==$6E646D75 or GetUnitTypeId(GetAttackedUnitBJ())==$6E647268 or GetUnitTypeId(GetAttackedUnitBJ())==$6E736774 or GetUnitTypeId(GetAttackedUnitBJ())==$6E636867 or GetUnitTypeId(GetAttackedUnitBJ())==$6E736362 and JF[GetConvertedPlayerId(GetOwningPlayer(GetAttacker()))]>=12 then
set Xh=GetUnitLoc(GetAttackedUnitBJ())
set e4=GetUnitLoc(GetAttacker())
set JG=GetRandomInt(1,4)
call CreateNUnitsAtLoc(1,$6E303658,Player(11),Xh,bj_UNIT_FACING)
call UnitApplyTimedLifeBJ(1.5,$42544C46,GetLastCreatedUnit())
call SetUnitAbilityLevelSwapped($41304F4C,GetLastCreatedUnit(),JG)
call IssuePointOrderLoc(GetLastCreatedUnit(),"silence",e4)
if JG==1 then
call AddSpecialEffectLocBJ(Xh,"Abilities\\Spells\\Human\\Avatar\\AvatarCaster.mdl")
call DestroyEffect(GetLastCreatedEffectBJ())
else
if JG==2 then
call AddSpecialEffectLocBJ(Xh,"Abilities\\Spells\\Other\\Andt\\Andt.mdl")
call DestroyEffect(GetLastCreatedEffectBJ())
else
if JG==3 then
call AddSpecialEffectLocBJ(Xh,"Abilities\\Spells\\NightElf\\BattleRoar\\RoarCaster.mdl")
call DestroyEffect(GetLastCreatedEffectBJ())
else
if JG==4 then
call AddSpecialEffectLocBJ(Xh,"Abilities\\Spells\\Human\\Thunderclap\\ThunderClapCaster.mdl")
call DestroyEffect(GetLastCreatedEffectBJ())
else
call DoNothing()
endif
endif
endif
endif
set JF[GetConvertedPlayerId(GetOwningPlayer(GetAttacker()))]=0
call RemoveLocation(Xh)
call RemoveLocation(e4)
else
endif
if GetUnitAbilityLevelSwapped($41305237,GetAttacker())>=1 then
call IssueTargetOrder(GetAttacker(),"thunderbolt",GetAttackedUnitBJ())
if GetUnitAbilityLevelSwapped($41305237,GetAttacker())==1 then
call SetUnitAbilityLevelSwapped($41305237,GetAttacker(),2)
else
if GetUnitAbilityLevelSwapped($41305237,GetAttacker())==2 then
call SetUnitAbilityLevelSwapped($41305237,GetAttacker(),3)
else
if GetUnitAbilityLevelSwapped($41305237,GetAttacker())==3 then
call SetUnitAbilityLevelSwapped($41305237,GetAttacker(),1)
else
call DoNothing()
endif
endif
endif
else
call DoNothing()
endif
endfunction
