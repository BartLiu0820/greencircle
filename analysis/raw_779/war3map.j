call TriggerRegisterTimerEventPeriodic(b0,30.)
call TriggerAddAction(b0,function BQR)
endfunction
function BQT takes nothing returns boolean
return GetKillingUnitBJ()==SM or GetKillingUnitBJ()==SN and GetOwningPlayer(GetDyingUnit())==Player(11)
endfunction
function BQU takes nothing returns nothing
set OU=OU+1
set OV=R2I(I2R(OU)*.05)
if OV-OW>=1 then
set OW=OV
if GetUnitAbilityLevelSwapped($41305639,SN)==1 then
call ModifyHeroStat(bj_HEROSTAT_STR,SN,bj_MODIFYMETHOD_ADD,1)
set OT=1
else
if GetUnitAbilityLevelSwapped($41305639,SN)==2 then
call ModifyHeroStat(bj_HEROSTAT_AGI,SN,bj_MODIFYMETHOD_ADD,1)
set OT=2
else
if GetUnitAbilityLevelSwapped($41305639,SN)==3 then
call ModifyHeroStat(bj_HEROSTAT_INT,SN,bj_MODIFYMETHOD_ADD,1)
set OT=3
else
call DoNothing()
endif
endif
endif
else
call DoNothing()
endif
endfunction
