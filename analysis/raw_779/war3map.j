set H4[GetConvertedPlayerId(GetTriggerPlayer())]=H4[GetConvertedPlayerId(GetTriggerPlayer())]+10
else
call DoNothing()
endif
set H4[GetConvertedPlayerId(GetTriggerPlayer())]=H4[GetConvertedPlayerId(GetTriggerPlayer())]-10
if IV[GetConvertedPlayerId(GetTriggerPlayer())]>=1 or lo(GetTriggerPlayer(),"赞+7")>=2800 and Kl[GetConvertedPlayerId(GetTriggerPlayer())]==0 then
call CreateNUnitsAtLoc(1,$48303658,GetOwningPlayer(GetTriggerUnit()),XN,bj_UNIT_FACING)
set KY=1
