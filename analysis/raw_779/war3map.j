set KS=GetRandomInt(GetUnitAbilityLevelSwapped($41305053,GetTriggerUnit())*40+50,GetUnitAbilityLevelSwapped($41305053,GetTriggerUnit())*100+50)
endif
else
if GetRandomInt(1,10)<=2 then
set KT=GetRandomInt(GetUnitAbilityLevelSwapped($41305053,GetTriggerUnit())*65+30,GetUnitAbilityLevelSwapped($41305053,GetTriggerUnit())*90+30)
set KS=GetRandomInt(GetUnitAbilityLevelSwapped($41305053,GetTriggerUnit())*10+30,GetUnitAbilityLevelSwapped($41305053,GetTriggerUnit())*90+30)
else
if GetRandomInt(1,10)==3 then
set KS=GetRandomInt(GetUnitAbilityLevelSwapped($41305053,GetTriggerUnit())*70+50,GetUnitAbilityLevelSwapped($41305053,GetTriggerUnit())*120+50)
set KT=GetRandomInt(1,GetUnitAbilityLevelSwapped($41305053,GetTriggerUnit())*7+8)
else
if GetRandomInt(1,20)==5 then
set KT=GetRandomInt(GetUnitAbilityLevelSwapped($41305053,GetTriggerUnit())*70+60,GetUnitAbilityLevelSwapped($41305053,GetTriggerUnit())*90+60)
set KS=GetRandomInt(GetUnitAbilityLevelSwapped($41305053,GetTriggerUnit())*85+60,GetUnitAbilityLevelSwapped($41305053,GetTriggerUnit())*110+60)
else
set KT=GetRandomInt(GetUnitAbilityLevelSwapped($41305053,GetTriggerUnit())*10+50,GetUnitAbilityLevelSwapped($41305053,GetTriggerUnit())*65+50)
set KS=GetRandomInt(GetUnitAbilityLevelSwapped($41305053,GetTriggerUnit())*30+30,GetUnitAbilityLevelSwapped($41305053,GetTriggerUnit())*80+30)
endif
endif
endif
endif
call DisplayTextToPlayer(GetOwningPlayer(GetTriggerUnit()),0,0,"|cff20c000释魂攻击力:  |r|cffff0303"+(I2S(KT)+"-"+(I2S(KS)+"|r")))
else
call DoNothing()
endif
if GetSpellAbilityId()==$41305053 and KU==1 and GetUnitAbilityLevelSwapped($41305053,GetTriggerUnit())<21 and GetHeroStatBJ(bj_HEROSTAT_STR,GetTriggerUnit(),false)>=2 and GetUnitAbilityLevelSwapped($41305053,GetTriggerUnit())<=GetHeroLevel(GetTriggerUnit()) then
call IncUnitAbilityLevelSwapped($41305053,GetTriggerUnit())
call ModifyHeroStat(bj_HEROSTAT_STR,GetTriggerUnit(),bj_MODIFYMETHOD_SUB,1)
set KU=0
set KQ=KQ+KS
set KP=KP+KT
call DisplayTextToPlayer(GetOwningPlayer(GetTriggerUnit()),0,0,"|cff20c000当前攻击力:  |r|cffff0303"+(I2S(R2I(I2R(KP+GetHeroStatBJ(bj_HEROSTAT_INT,GetTriggerUnit(),false)*4)*(1.+KW[GetConvertedPlayerId(GetTriggerPlayer())]+I2R(GetUnitAbilityLevelSwapped($41305051,GetTriggerUnit()))*.05)))+"-"+(I2S(KQ+GetHeroStatBJ(bj_HEROSTAT_AGI,GetTriggerUnit(),false)*2)+"|r")))
else
call DoNothing()
endif
if GetSpellAbilityId()==$41305051 and GetPlayerState(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_LUMBER)>=GetUnitAbilityLevelSwapped($41305051,GetTriggerUnit())+6 and GetUnitAbilityLevelSwapped($41305051,GetTriggerUnit())<10 and GetUnitStateSwap(UNIT_STATE_MANA,GetTriggerUnit())>=I2R(GetUnitAbilityLevelSwapped($41305051,GetTriggerUnit()))*100. then
call SetUnitManaBJ(GetTriggerUnit(),GetUnitStateSwap(UNIT_STATE_MANA,GetTriggerUnit())-I2R(GetUnitAbilityLevelSwapped($41305051,GetTriggerUnit()))*100.)
call SetPlayerStateBJ(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_LUMBER,GetPlayerState(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_LUMBER)-(GetUnitAbilityLevelSwapped($41305051,GetTriggerUnit())+6))
call IncUnitAbilityLevelSwapped($41305051,GetTriggerUnit())
call DisplayTextToPlayer(GetOwningPlayer(GetTriggerUnit()),0,0,"|cff20c000当前攻击力:  |r|cffff0303"+(I2S(R2I(I2R(KP+GetHeroStatBJ(bj_HEROSTAT_INT,GetTriggerUnit(),false)*4)*(1.+KW[GetConvertedPlayerId(GetTriggerPlayer())]+I2R(GetUnitAbilityLevelSwapped($41305051,GetTriggerUnit()))*.05)))+"-"+(I2S(KQ+GetHeroStatBJ(bj_HEROSTAT_AGI,GetTriggerUnit(),false)*2)+"|r")))
else
call DoNothing()
endif
if GetSpellAbilityId()==$41305050 and GetHeroStatBJ(bj_HEROSTAT_STR,GetTriggerUnit(),false)>=GetUnitAbilityLevelSwapped($41305050,GetTriggerUnit())+4 and GetUnitAbilityLevelSwapped($41305050,GetTriggerUnit())<10 and GetUnitStateSwap(UNIT_STATE_MANA,GetTriggerUnit())>=I2R(GetUnitAbilityLevelSwapped($41305050,GetTriggerUnit()))*50. then
call SetUnitManaBJ(GetTriggerUnit(),GetUnitStateSwap(UNIT_STATE_MANA,GetTriggerUnit())-I2R(GetUnitAbilityLevelSwapped($41305050,GetTriggerUnit()))*50.)
call ModifyHeroStat(bj_HEROSTAT_STR,GetTriggerUnit(),bj_MODIFYMETHOD_SUB,GetUnitAbilityLevelSwapped($41305050,GetTriggerUnit())+3)
call IncUnitAbilityLevelSwapped($41305050,GetTriggerUnit())
else
call DoNothing()
endif
if GetSpellAbilityId()==$41305052 and GetUnitAbilityLevelSwapped($41305052,GetTriggerUnit())>=20 and GetUnitAbilityLevelSwapped($41305052,GetTriggerUnit())<30 and GetPlayerState(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_GOLD)>=GetUnitAbilityLevelSwapped($41305052,GetTriggerUnit())*100 and GetHeroStatBJ(bj_HEROSTAT_STR,GetTriggerUnit(),false)>=6 then
call SetPlayerStateBJ(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_GOLD)-GetUnitAbilityLevelSwapped($41305052,GetTriggerUnit())*100)
set KQ=KQ+GetUnitAbilityLevelSwapped($41305052,GetTriggerUnit())*20
call IncUnitAbilityLevelSwapped($41305052,GetTriggerUnit())
call ModifyHeroStat(bj_HEROSTAT_STR,GetTriggerUnit(),bj_MODIFYMETHOD_SUB,5)
call DisplayTextToPlayer(GetOwningPlayer(GetTriggerUnit()),0,0,"|cff20c000当前攻击力:  |r|cffff0303"+(I2S(R2I(I2R(KP+GetHeroStatBJ(bj_HEROSTAT_INT,GetTriggerUnit(),false)*4)*(1.+KW[GetConvertedPlayerId(GetTriggerPlayer())]+I2R(GetUnitAbilityLevelSwapped($41305051,GetTriggerUnit()))*.05)))+"-"+(I2S(KQ+GetHeroStatBJ(bj_HEROSTAT_AGI,GetTriggerUnit(),false)*2)+"|r")))
else
if GetSpellAbilityId()==$41305052 and GetUnitAbilityLevelSwapped($41305052,GetTriggerUnit())>=10 and GetUnitAbilityLevelSwapped($41305052,GetTriggerUnit())<20 and GetPlayerState(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_GOLD)>=GetUnitAbilityLevelSwapped($41305052,GetTriggerUnit())*100 and GetHeroStatBJ(bj_HEROSTAT_STR,GetTriggerUnit(),false)>=5 then
call SetPlayerStateBJ(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_GOLD)-GetUnitAbilityLevelSwapped($41305052,GetTriggerUnit())*100)
set KQ=KQ+GetUnitAbilityLevelSwapped($41305052,GetTriggerUnit())*20
