return GetUnitTypeId(GetTriggerUnit())==$6E303147 or GetUnitTypeId(GetTriggerUnit())==$6E303245 or GetUnitTypeId(GetTriggerUnit())==$6E30314A or GetUnitTypeId(GetTriggerUnit())==$6E30314E or GetUnitTypeId(GetTriggerUnit())==$6830314A or GetUnitTypeId(GetTriggerUnit())==$68303139 or GetUnitTypeId(GetTriggerUnit())==$68303154 or GetUnitTypeId(GetTriggerUnit())==$6830304B
endfunction
