function BVE takes nothing returns boolean
return GetTriggerUnit()==R4 and GetSpellAbilityId()==$41305553 or GetSpellAbilityId()==$41305555 or GetSpellAbilityId()==$41305552 or GetSpellAbilityId()==$41305554 or GetSpellAbilityId()==$41305556
endfunction
function BVF takes nothing returns nothing
set Oe=GetUnitLoc(GetTriggerUnit())
if GetSpellAbilityId()==$41305553 and Nu>=1 and Nu<10 and GetHeroLevel(GetTriggerUnit())>=Nu*3+0 and GetUnitStateSwap(UNIT_STATE_MANA,GetSpellAbilityUnit())>=I2R(GetHeroStatBJ(bj_HEROSTAT_INT,R4,false)) and GetPlayerState(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_GOLD)>=1000/(OC[12]+1) then
call SetUnitManaBJ(GetTriggerUnit(),GetUnitStateSwap(UNIT_STATE_MANA,GetTriggerUnit())-I2R(GetHeroStatBJ(bj_HEROSTAT_INT,R4,false)))
call SetPlayerStateBJ(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_GOLD)-1000/(OC[12]+1))
set Nu=Nu+1
call AddSpecialEffectLocBJ(Oe,"Abilities\\Spells\\Human\\Resurrect\\ResurrectTarget.mdl")
call DestroyEffect(GetLastCreatedEffectBJ())
call IncUnitAbilityLevelSwapped($41305559,GetTriggerUnit())
else
if GetSpellAbilityId()==$41305555 and Nw>=1 and Nw<10 and GetHeroLevel(GetTriggerUnit())>=Nw*3+0 and GetPlayerState(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_GOLD)>=Nw*200/(OC[12]+1) and GetUnitStateSwap(UNIT_STATE_MANA,GetSpellAbilityUnit())>=I2R(Nw)*20. or OC[9]>=1 then
if OC[9]>=1 then
call DoNothing()
else
call SetUnitManaBJ(GetTriggerUnit(),GetUnitStateSwap(UNIT_STATE_MANA,GetTriggerUnit())-I2R(Nw)*20.)
endif
call SetPlayerStateBJ(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_GOLD)-Nw*200/(OC[12]+1))
set Nw=Nw+1
call AddSpecialEffectLocBJ(Oe,"Abilities\\Spells\\Human\\Resurrect\\ResurrectTarget.mdl")
call DestroyEffect(GetLastCreatedEffectBJ())
call IncUnitAbilityLevelSwapped($41305557,GetTriggerUnit())
else
if GetSpellAbilityId()==$41305552 and Nx>=1 and Nx<10 and GetHeroLevel(GetTriggerUnit())>=Nx*3+0 and (GetUnitStateSwap(UNIT_STATE_MANA,GetSpellAbilityUnit())>=I2R(Nx)*50. and OC[19]==0) or (GetPlayerState(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_GOLD)>=Nx*500/(OC[12]+1) and OC[19]==1) then
if OC[19]==1 then
call SetPlayerStateBJ(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_GOLD)-Nx*500/(OC[12]+1))
else
call SetUnitManaBJ(GetTriggerUnit(),GetUnitStateSwap(UNIT_STATE_MANA,GetTriggerUnit())-I2R(Nx)*50.)
endif
set Nx=Nx+1
call AddSpecialEffectLocBJ(Oe,"Abilities\\Spells\\Human\\Resurrect\\ResurrectTarget.mdl")
call DestroyEffect(GetLastCreatedEffectBJ())
call IncUnitAbilityLevelSwapped($41305558,GetTriggerUnit())
else
if GetSpellAbilityId()==$41305554 and Nv>=1 and Nv<10 and GetHeroLevel(GetTriggerUnit())>=Nv*3+0 and GetPlayerState(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_GOLD)>=Nv*300 and GetUnitStateSwap(UNIT_STATE_MANA,GetSpellAbilityUnit())>=I2R(GetHeroStatBJ(bj_HEROSTAT_INT,R4,false)*OC[14]) then
call SetUnitManaBJ(GetTriggerUnit(),GetUnitStateSwap(UNIT_STATE_MANA,GetTriggerUnit())-I2R(GetHeroStatBJ(bj_HEROSTAT_INT,R4,false)*OC[14]))
call SetPlayerStateBJ(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_GOLD)-Nv*300)
set Nv=Nv+1
call AddSpecialEffectLocBJ(Oe,"Abilities\\Spells\\Human\\Resurrect\\ResurrectTarget.mdl")
call DestroyEffect(GetLastCreatedEffectBJ())
call IncUnitAbilityLevelSwapped($4130555A,GetTriggerUnit())
else
if GetSpellAbilityId()==$41305556 and Ny>=1 and Ny<10 and GetHeroLevel(GetTriggerUnit())>=Ny*3+0 and GetPlayerState(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_GOLD)>=Ny*500/(OC[12]+1) then
call SetPlayerStateBJ(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_GOLD)-Ny*500/(OC[12]+1))
set Ny=Ny+1
call AddSpecialEffectLocBJ(Oe,"Abilities\\Spells\\Human\\Resurrect\\ResurrectTarget.mdl")
call DestroyEffect(GetLastCreatedEffectBJ())
call IncUnitAbilityLevelSwapped($41305550,GetTriggerUnit())
else
if DU[GetConvertedPlayerId(GetTriggerPlayer())]<3 and GetPlayerState(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_LUMBER)>=1*(DU[GetConvertedPlayerId(GetTriggerPlayer())]*18) and GetHeroStatBJ(bj_HEROSTAT_STR,GetTriggerUnit(),true)>=DU[GetConvertedPlayerId(GetTriggerPlayer())]*80 then
if GetSpellAbilityId()==$41305553 and Nu==0 then
set Nu=1
call AddSpecialEffectLocBJ(Oe,"Abilities\\Spells\\Human\\Resurrect\\ResurrectTarget.mdl")
call DestroyEffect(GetLastCreatedEffectBJ())
call UnitAddAbilityBJ($41305559,GetSpellAbilityUnit())
call SetPlayerStateBJ(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_LUMBER,GetPlayerState(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_LUMBER)-1*(DU[GetConvertedPlayerId(GetTriggerPlayer())]*18))
set DU[GetConvertedPlayerId(GetTriggerPlayer())]=DU[GetConvertedPlayerId(GetTriggerPlayer())]+1
else
if GetSpellAbilityId()==$41305555 and Nw==0 then
set Nw=1
call AddSpecialEffectLocBJ(Oe,"Abilities\\Spells\\Human\\Resurrect\\ResurrectTarget.mdl")
call DestroyEffect(GetLastCreatedEffectBJ())
call UnitAddAbilityBJ($41305557,GetSpellAbilityUnit())
call SetPlayerStateBJ(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_LUMBER,GetPlayerState(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_LUMBER)-1*(DU[GetConvertedPlayerId(GetTriggerPlayer())]*18))
set DU[GetConvertedPlayerId(GetTriggerPlayer())]=DU[GetConvertedPlayerId(GetTriggerPlayer())]+1
else
if GetSpellAbilityId()==$41305552 and Nx==0 then
set Nx=1
call AddSpecialEffectLocBJ(Oe,"Abilities\\Spells\\Human\\Resurrect\\ResurrectTarget.mdl")
call DestroyEffect(GetLastCreatedEffectBJ())
call UnitAddAbilityBJ($41305558,GetSpellAbilityUnit())
call CreateNUnitsAtLoc(1,$68303934,GetOwningPlayer(GetTriggerUnit()),ZH,bj_UNIT_FACING)
set ea=GetLastCreatedUnit()
call SetPlayerStateBJ(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_LUMBER,GetPlayerState(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_LUMBER)-1*(DU[GetConvertedPlayerId(GetTriggerPlayer())]*18))
set DU[GetConvertedPlayerId(GetTriggerPlayer())]=DU[GetConvertedPlayerId(GetTriggerPlayer())]+1
else
if GetSpellAbilityId()==$41305554 and Nv==0 then
set Nv=1
call AddSpecialEffectLocBJ(Oe,"Abilities\\Spells\\Human\\Resurrect\\ResurrectTarget.mdl")
call DestroyEffect(GetLastCreatedEffectBJ())
call UnitAddAbilityBJ($4130555A,GetSpellAbilityUnit())
call SetPlayerStateBJ(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_LUMBER,GetPlayerState(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_LUMBER)-1*(DU[GetConvertedPlayerId(GetTriggerPlayer())]*18))
set DU[GetConvertedPlayerId(GetTriggerPlayer())]=DU[GetConvertedPlayerId(GetTriggerPlayer())]+1
else
if GetSpellAbilityId()==$41305556 and Ny==0 then
set Ny=1
call AddSpecialEffectLocBJ(Oe,"Abilities\\Spells\\Human\\Resurrect\\ResurrectTarget.mdl")
call DestroyEffect(GetLastCreatedEffectBJ())
call UnitAddAbilityBJ($41305550,GetSpellAbilityUnit())
call SetPlayerStateBJ(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_LUMBER,GetPlayerState(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_LUMBER)-1*(DU[GetConvertedPlayerId(GetTriggerPlayer())]*18))
set DU[GetConvertedPlayerId(GetTriggerPlayer())]=DU[GetConvertedPlayerId(GetTriggerPlayer())]+1
else
call DoNothing()
endif
endif
endif
endif
endif
else
endif
endif
endif
endif
endif
endif
call RemoveLocation(Oe)
endfunction
