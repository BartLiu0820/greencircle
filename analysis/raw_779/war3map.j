call UnitDamagePointLoc(GetTriggerUnit(),.1,600.,ck,I2R(GetHeroAgi(J3,false))*280.+0,ATTACK_TYPE_HERO,DAMAGE_TYPE_NORMAL)
else
call UnitDamagePointLoc(GetTriggerUnit(),.1,600.,ck,I2R(GetHeroAgi(J3,false))*140.+0,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_NORMAL)
endif
call RemoveLocation(ck)
