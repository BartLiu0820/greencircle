function BHU takes nothing returns nothing
set T3=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(T3,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(T3,Condition(function BHS))
call TriggerAddAction(T3,function BHT)
endfunction
function BHV takes nothing returns nothing
if kH(GetTriggerUnit(),$49303034)==true and kH(GetTriggerUnit(),$49303036)==true and kH(GetTriggerUnit(),$49303037)==true and kH(GetTriggerUnit(),$49303035)==true then
call RemoveItem(jr(GetTriggerUnit(),$49303034))
call RemoveItem(jr(GetTriggerUnit(),$49303036))
call RemoveItem(jr(GetTriggerUnit(),$49303037))
call RemoveItem(jr(GetTriggerUnit(),$49303035))
call AdjustPlayerStateBJ(8000,GetOwningPlayer(GetTriggerUnit()),PLAYER_STATE_RESOURCE_GOLD)
call DisplayTimedTextToForce(GetPlayersAll(),15.,"【"+(GetPlayerName(GetTriggerPlayer())+"】集齐了|cffffcc00马上有钱|r获得|cff5400818000金币|r|r"))
else
if kH(GetTriggerUnit(),$49303034)==true and kH(GetTriggerUnit(),$49303036)==true and kH(GetTriggerUnit(),$49303037)==true and kH(GetTriggerUnit(),$49303038)==true then
call RemoveItem(jr(GetTriggerUnit(),$49303034))
call RemoveItem(jr(GetTriggerUnit(),$49303036))
call RemoveItem(jr(GetTriggerUnit(),$49303037))
call RemoveItem(jr(GetTriggerUnit(),$49303038))
call AdjustPlayerStateBJ(20,GetOwningPlayer(GetTriggerUnit()),PLAYER_STATE_RESOURCE_LUMBER)
call DisplayTimedTextToForce(GetPlayersAll(),15.,"【"+(GetPlayerName(GetTriggerPlayer())+"】集齐了|cffffcc00马上有木|r获得|cff54008120木材|r|r"))
else
call DoNothing()
endif
endif
endfunction
function BHW takes nothing returns nothing
set X7=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(X7,EVENT_PLAYER_UNIT_PICKUP_ITEM)
call TriggerAddAction(X7,function BHV)
endfunction
function BHX takes nothing returns boolean
return GetItemTypeId(GetManipulatedItem())==$49303149 and GetPlayerState(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_GOLD)>=2500
endfunction
function BHY takes nothing returns nothing
if H4[GetConvertedPlayerId(GetTriggerPlayer())]>=1 then
call DisplayTimedTextToPlayer(GetOwningPlayer(GetTriggerUnit()),0,0,5.,"|c008000FF购买成功|r")
set H4[GetConvertedPlayerId(GetTriggerPlayer())]=H4[GetConvertedPlayerId(GetTriggerPlayer())]-1
call SetPlayerStateBJ(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_GOLD)-2500)
call AdjustPlayerStateBJ(5,GetTriggerPlayer(),PLAYER_STATE_RESOURCE_LUMBER)
else
set KL=EXNetUseItem(GetTriggerPlayer(),"3012113",1)
if KL==true then
call DisplayTimedTextToPlayer(GetOwningPlayer(GetTriggerUnit()),0,0,5.,"|c008000FF购买成功|r")
call SetPlayerStateBJ(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_GOLD)-2500)
call AdjustPlayerStateBJ(5,GetTriggerPlayer(),PLAYER_STATE_RESOURCE_LUMBER)
else
call DisplayTimedTextToPlayer(GetOwningPlayer(GetTriggerUnit()),0,0,5.,"|c008000FF成就不足|r")
endif
endif
endfunction
