call IssueTargetOrder(J6[2],"innerfire",J3)
call IssueImmediateOrder(J6[5],"lavamonster")
else
endif
if GetRandomInt(1,10)<=2 and GetUnitAbilityLevelSwapped($41305045,J3)>=1 and GetAttacker()==J5[3] then
call IssueTargetOrder(J6[3],"innerfire",J3)
call IssueImmediateOrder(J6[5],"lavamonster")
else
endif
