call TriggerRegisterAnyUnitEventBJ(b1,EVENT_PLAYER_UNIT_DEATH)
call TriggerAddCondition(b1,Condition(function BQT))
call TriggerAddAction(b1,function BQU)
endfunction
function BQW takes nothing returns boolean
