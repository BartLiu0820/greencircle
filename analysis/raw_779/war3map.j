set ZS=GetUnitLoc(R0)
call UnitDamagePointLoc(R0,.15,900.,ZS,I2R(GetUnitAbilityLevelSwapped($41304235,R0)*GetUnitAbilityLevelSwapped($41304235,R0))*100.,ATTACK_TYPE_MELEE,DAMAGE_TYPE_NORMAL)
else
