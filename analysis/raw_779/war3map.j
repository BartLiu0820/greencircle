call ModifyHeroStat(bj_HEROSTAT_STR,Ph,bj_MODIFYMETHOD_ADD,Gw)
call DisplayTextToPlayer(GetOwningPlayer(GetTriggerUnit()),0,0,"|cffff0303英雄增加力量"+(I2S(Gw)+"|r"))
else
if GetUnitAbilityLevelSwapped($41304344,Ph)==2 or GetUnitAbilityLevelSwapped($41305639,Ph)==2 then
call ModifyHeroStat(bj_HEROSTAT_AGI,Ph,bj_MODIFYMETHOD_ADD,Gw)
call DisplayTextToPlayer(GetOwningPlayer(GetTriggerUnit()),0,0,"|cffff0303英雄增加敏捷"+(I2S(Gw)+"|r"))
else
if GetUnitAbilityLevelSwapped($41304344,Ph)==3 or GetUnitAbilityLevelSwapped($41305639,Ph)==3 then
call ModifyHeroStat(bj_HEROSTAT_INT,Ph,bj_MODIFYMETHOD_ADD,Gw)
call DisplayTextToPlayer(GetOwningPlayer(GetTriggerUnit()),0,0,"|cffff0303英雄增加智力"+(I2S(Gw)+"|r"))
else
call DoNothing()
endif
endif
endif
endif
else
call DoNothing()
endif
endfunction
