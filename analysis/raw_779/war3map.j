call DestroyEffect(GetLastCreatedEffectBJ())
call AddSpecialEffectLocBJ(dK,"Abilities\\Spells\\Other\\Doom\\DoomDeath.mdl")
call DestroyEffect(GetLastCreatedEffectBJ())
call AddSpecialEffectLocBJ(dL,"Abilities\\Spells\\Other\\Doom\\DoomDeath.mdl")
call DestroyEffect(GetLastCreatedEffectBJ())
call AddSpecialEffectLocBJ(dM,"Abilities\\Spells\\Other\\Doom\\DoomDeath.mdl")
call DestroyEffect(GetLastCreatedEffectBJ())
call UnitDamagePointLoc(R9,.1,150.,dJ,GetUnitStateSwap(ConvertUnitState(21),R9)*(18.+I2R(Kp)*3.),ATTACK_TYPE_CHAOS,DAMAGE_TYPE_NORMAL)
call UnitDamagePointLoc(R9,.1,150.,dK,GetUnitStateSwap(ConvertUnitState(21),R9)*(18.+I2R(Kp)*3.),ATTACK_TYPE_CHAOS,DAMAGE_TYPE_NORMAL)
call UnitDamagePointLoc(R9,.1,150.,dL,GetUnitStateSwap(ConvertUnitState(21),R9)*(18.+I2R(Kp)*3.),ATTACK_TYPE_CHAOS,DAMAGE_TYPE_NORMAL)
call UnitDamagePointLoc(R9,.1,150.,dM,GetUnitStateSwap(ConvertUnitState(21),R9)*(18.+I2R(Kp)*3.),ATTACK_TYPE_CHAOS,DAMAGE_TYPE_NORMAL)
call RemoveLocation(dJ)
call RemoveLocation(dK)
call RemoveLocation(dL)
call RemoveLocation(dM)
if GetUnitAbilityLevelSwapped($41305157,R9)==2 and Nj==1 then
set dN=OffsetLocation(ZF,GetRandomReal(-700.,700.),GetRandomReal(-700.,700.))
call AddSpecialEffectLocBJ(dN,"Abilities\\Spells\\Demon\\DarkPortal\\DarkPortalTarget.mdl")
if GetHeroAgi(R9,false)>=210 then
call UnitDamagePointLoc(R9,.1,200.,dN,GetUnitStateSwap(ConvertUnitState(21),R9)*12.+0,ATTACK_TYPE_HERO,DAMAGE_TYPE_NORMAL)
else
if GetHeroAgi(R9,false)>=140 then
call UnitDamagePointLoc(R9,.1,200.,dN,GetUnitStateSwap(ConvertUnitState(21),R9)*8.+0,ATTACK_TYPE_HERO,DAMAGE_TYPE_NORMAL)
else
if GetHeroAgi(R9,false)>=70 then
call UnitDamagePointLoc(R9,.1,200.,dN,GetUnitStateSwap(ConvertUnitState(21),R9)*5.+0,ATTACK_TYPE_HERO,DAMAGE_TYPE_NORMAL)
else
call UnitDamagePointLoc(R9,.1,200.,dN,GetUnitStateSwap(ConvertUnitState(21),R9)*2.+0,ATTACK_TYPE_HERO,DAMAGE_TYPE_NORMAL)
endif
endif
endif
call DestroyEffect(GetLastCreatedEffectBJ())
else
call DoNothing()
endif
if GetUnitAbilityLevelSwapped($41305157,R9)==2 and Nj==0 then
set dN=OffsetLocation(ZF,GetRandomReal(-700.,700.),GetRandomReal(-700.,700.))
call AddSpecialEffectLocBJ(dN,"Abilities\\Spells\\Demon\\DarkPortal\\DarkPortalTarget.mdl")
if GetHeroAgi(R9,false)>=210 then
call UnitDamagePointLoc(R9,.1,200.,dN,GetUnitStateSwap(ConvertUnitState(21),R9)*4.+0,ATTACK_TYPE_HERO,DAMAGE_TYPE_NORMAL)
else
if GetHeroAgi(R9,false)>=140 then
call UnitDamagePointLoc(R9,.1,200.,dN,GetUnitStateSwap(ConvertUnitState(21),R9)*2.66+0,ATTACK_TYPE_HERO,DAMAGE_TYPE_NORMAL)
else
if GetHeroAgi(R9,false)>=70 then
call UnitDamagePointLoc(R9,.1,200.,dN,GetUnitStateSwap(ConvertUnitState(21),R9)*1.66+0,ATTACK_TYPE_HERO,DAMAGE_TYPE_NORMAL)
else
call UnitDamagePointLoc(R9,.1,200.,dN,GetUnitStateSwap(ConvertUnitState(21),R9)*.66+0,ATTACK_TYPE_HERO,DAMAGE_TYPE_NORMAL)
endif
endif
endif
call DestroyEffect(GetLastCreatedEffectBJ())
else
call DoNothing()
endif
else
if Km<2 then
call SetUnitAbilityLevelSwapped($4130514F,R9,2)
else
endif
endif
