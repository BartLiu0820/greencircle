function BJY takes nothing returns nothing
local boolean B2
set B2=true
if CountUnitsInGroup(jz($6830344F))>1 then
call RemoveUnit(GetConstructedStructure())
call SetPlayerStateBJ(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_GOLD)+1500)
call SetPlayerStateBJ(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_LUMBER,GetPlayerState(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_LUMBER)+5)
set XN=GetRandomLocInRect(s)
call CreateNUnitsAtLoc(1,$6F766C6E,GetTriggerPlayer(),XN,bj_UNIT_FACING)
call RemoveLocation(XN)
call DisplayTextToForce(jq(GetTriggerPlayer()),"|cffff0303全场只能建造一个|r")
else
if H4[GetConvertedPlayerId(GetTriggerPlayer())]>=10 or jp($6E303343,GetTriggerPlayer())>=1 then
if jp($6E303343,GetTriggerPlayer())>=1 then
set H4[GetConvertedPlayerId(GetTriggerPlayer())]=H4[GetConvertedPlayerId(GetTriggerPlayer())]+10
else
call DoNothing()
endif
set Oe=GetUnitLoc(GetTriggerUnit())
set H4[GetConvertedPlayerId(GetTriggerPlayer())]=H4[GetConvertedPlayerId(GetTriggerPlayer())]-10
set XN=OffsetLocation(Oe,15.,0)
if lo(GetTriggerPlayer(),"赞+7")>=1600 or IV[GetConvertedPlayerId(GetTriggerPlayer())]>=1 and Kl[GetConvertedPlayerId(GetTriggerPlayer())]==0 then
call CreateNUnitsAtLoc(1,$48303645,GetOwningPlayer(GetTriggerUnit()),XN,bj_UNIT_FACING)
else
call CreateNUnitsAtLoc(1,$486D6B67,GetOwningPlayer(GetTriggerUnit()),XN,bj_UNIT_FACING)
endif
set R1=GetLastCreatedUnit()
call RemoveLocation(Oe)
call RemoveLocation(XN)
call ModifyHeroSkillPoints(GetLastCreatedUnit(),bj_MODIFYMETHOD_ADD,3)
set DR[GetConvertedPlayerId(GetTriggerPlayer())]=GetRandomInt(0,7)
set DS[GetConvertedPlayerId(GetTriggerPlayer())]=GetRandomInt(0,7-DR[GetConvertedPlayerId(GetTriggerPlayer())])
set DT[GetConvertedPlayerId(GetTriggerPlayer())]=7-(DR[GetConvertedPlayerId(GetTriggerPlayer())]+DS[GetConvertedPlayerId(GetTriggerPlayer())])
call DisplayTimedTextToPlayer(GetOwningPlayer(GetTriggerUnit()),0,0,5.,"|cff20c000英雄成长值(每次升级获得属性自动分配)|r:")
call DisplayTextToPlayer(GetTriggerPlayer(),0,0,"|cffff0303力量:     "+(I2S(DR[GetConvertedPlayerId(GetTriggerPlayer())]+1)+"|r"))
call DisplayTextToPlayer(GetTriggerPlayer(),0,0,"|c00fffc01敏捷:     "+(I2S(DS[GetConvertedPlayerId(GetTriggerPlayer())]+1)+"|r"))
call DisplayTextToPlayer(GetTriggerPlayer(),0,0,"|cff0042ff智力:     "+(I2S(DT[GetConvertedPlayerId(GetTriggerPlayer())]+1)+"|r"))
else
if B2 then
set Oe=GetUnitLoc(GetTriggerUnit())
set H4[GetConvertedPlayerId(GetTriggerPlayer())]=H4[GetConvertedPlayerId(GetTriggerPlayer())]-10
set XN=OffsetLocation(Oe,15.,0)
if lo(GetTriggerPlayer(),"赞+7")>=1600 or IV[GetConvertedPlayerId(GetTriggerPlayer())]>=1 and Kl[GetConvertedPlayerId(GetTriggerPlayer())]==0 then
call CreateNUnitsAtLoc(1,$48303645,GetOwningPlayer(GetTriggerUnit()),XN,bj_UNIT_FACING)
else
call CreateNUnitsAtLoc(1,$486D6B67,GetOwningPlayer(GetTriggerUnit()),XN,bj_UNIT_FACING)
endif
set R1=GetLastCreatedUnit()
call RemoveLocation(Oe)
call RemoveLocation(XN)
call ModifyHeroSkillPoints(GetLastCreatedUnit(),bj_MODIFYMETHOD_ADD,3)
set DR[GetConvertedPlayerId(GetTriggerPlayer())]=GetRandomInt(0,7)
set DS[GetConvertedPlayerId(GetTriggerPlayer())]=GetRandomInt(0,7-DR[GetConvertedPlayerId(GetTriggerPlayer())])
set DT[GetConvertedPlayerId(GetTriggerPlayer())]=7-(DR[GetConvertedPlayerId(GetTriggerPlayer())]+DS[GetConvertedPlayerId(GetTriggerPlayer())])
call DisplayTimedTextToPlayer(GetOwningPlayer(GetTriggerUnit()),0,0,5.,"|cff20c000英雄成长值(每次升级获得属性自动分配)|r:")
call DisplayTextToPlayer(GetTriggerPlayer(),0,0,"|cffff0303力量:     "+(I2S(DR[GetConvertedPlayerId(GetTriggerPlayer())]+1)+"|r"))
call DisplayTextToPlayer(GetTriggerPlayer(),0,0,"|c00fffc01敏捷:     "+(I2S(DS[GetConvertedPlayerId(GetTriggerPlayer())]+1)+"|r"))
call DisplayTextToPlayer(GetTriggerPlayer(),0,0,"|cff0042ff智力:     "+(I2S(DT[GetConvertedPlayerId(GetTriggerPlayer())]+1)+"|r"))
else
set KL=EXNetUseItem(GetTriggerPlayer(),"3012113",10)
if KL==true then
set Oe=GetUnitLoc(GetTriggerUnit())
set H4[GetConvertedPlayerId(GetTriggerPlayer())]=H4[GetConvertedPlayerId(GetTriggerPlayer())]-10
set XN=OffsetLocation(Oe,15.,0)
if lo(GetTriggerPlayer(),"赞+7")>=1600 or IV[GetConvertedPlayerId(GetTriggerPlayer())]>=1 then
call CreateNUnitsAtLoc(1,$48303645,GetOwningPlayer(GetTriggerUnit()),XN,bj_UNIT_FACING)
else
call CreateNUnitsAtLoc(1,$486D6B67,GetOwningPlayer(GetTriggerUnit()),XN,bj_UNIT_FACING)
endif
set R1=GetLastCreatedUnit()
call RemoveLocation(Oe)
call RemoveLocation(XN)
call ModifyHeroSkillPoints(GetLastCreatedUnit(),bj_MODIFYMETHOD_ADD,3)
set DR[GetConvertedPlayerId(GetTriggerPlayer())]=GetRandomInt(0,7)
set DS[GetConvertedPlayerId(GetTriggerPlayer())]=GetRandomInt(0,7-DR[GetConvertedPlayerId(GetTriggerPlayer())])
set DT[GetConvertedPlayerId(GetTriggerPlayer())]=7-(DR[GetConvertedPlayerId(GetTriggerPlayer())]+DS[GetConvertedPlayerId(GetTriggerPlayer())])
call DisplayTimedTextToPlayer(GetOwningPlayer(GetTriggerUnit()),0,0,5.,"|cff20c000英雄成长值(每次升级获得属性自动分配)|r:")
call DisplayTextToPlayer(GetTriggerPlayer(),0,0,"|cffff0303力量:     "+(I2S(DR[GetConvertedPlayerId(GetTriggerPlayer())]+1)+"|r"))
call DisplayTextToPlayer(GetTriggerPlayer(),0,0,"|c00fffc01敏捷:     "+(I2S(DS[GetConvertedPlayerId(GetTriggerPlayer())]+1)+"|r"))
call DisplayTextToPlayer(GetTriggerPlayer(),0,0,"|cff0042ff智力:     "+(I2S(DT[GetConvertedPlayerId(GetTriggerPlayer())]+1)+"|r"))
else
call RemoveUnit(GetConstructedStructure())
endif
endif
endif
endif
endfunction
