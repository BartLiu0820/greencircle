endfunction
function BQM takes nothing returns nothing
set bo=GetUnitLoc(GetAttackedUnitBJ())
if GetUnitTypeId(GetAttacker())==$48303630 or GetUnitTypeId(GetAttacker())==$48303553 then
call IssueImmediateOrder(GetAttacker(),"stomp")
call IssueImmediateOrder(GetAttacker(),"thunderclap")
else
