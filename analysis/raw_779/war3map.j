function BPa takes nothing returns boolean
return GetUnitTypeId(GetAttacker())==$4830354B or GetUnitTypeId(GetAttacker())==$48303554
endfunction
function BPb takes nothing returns nothing
if GetUnitTypeId(GetAttacker())==$48303554 then
call SetUnitAnimation(GetAttacker(),"stand alternate (1.334 s)")
else
endif
if GetRandomInt(1,100)<=Nf+3 then
call CreateTextTagUnitBJ("|cff7fffd4火焰*10|r",GetAttacker(),0,9.,100.,0.,0.,0)
call SetTextTagPermanent(GetLastCreatedTextTag(),false)
call SetTextTagVelocityBJ(GetLastCreatedTextTag(),40.,90)
call SetTextTagLifespan(GetLastCreatedTextTag(),2.)
call SetTextTagFadepoint(GetLastCreatedTextTag(),2.)
if GetHeroInt(GetAttacker(),false)<=300 then
call SetUnitAbilityLevelSwapped($41304C4B,YD,GetHeroInt(GetAttacker(),false)/30+10)
else
call SetUnitAbilityLevelSwapped($41304C4B,YD,20)
endif
else
if GetHeroInt(GetAttacker(),false)<=300 then
call SetUnitAbilityLevelSwapped($41304C4B,YD,GetHeroStatBJ(bj_HEROSTAT_INT,GetAttacker(),false)/30)
else
call SetUnitAbilityLevelSwapped($41304C4B,YD,10)
endif
endif
set H2=jx(GetOwningPlayer(GetAttacker()),$6E303641)
call IssuePointOrder(FirstOfGroup(H2),"shockwave",GetUnitX(GetAttacker())-15.,GetUnitY(GetAttacker())-200.)
call DestroyGroup(H2)
set H2=jx(GetOwningPlayer(GetAttacker()),$48303554)
call IssuePointOrder(FirstOfGroup(H2),"shockwave",GetUnitX(GetAttacker())-15.,GetUnitY(GetAttacker())-200.)
call DestroyGroup(H2)
set Oe=GetUnitLoc(GetTriggerUnit())
if GetUnitAbilityLevelSwapped($41304C43,GetAttacker())>=1 then
call UnitDamagePointLoc(GetAttacker(),0,150.,Oe,GetUnitStateSwap(UNIT_STATE_MANA,SK)*2.,ATTACK_TYPE_PIERCE,DAMAGE_TYPE_NORMAL)
else
endif
if GetRandomInt(1,150)<=0+Hz[1]*3 and GetUnitAbilityLevelSwapped($41304C43,GetAttacker())>=1 then
call UnitDamagePointLoc(GetAttacker(),.1,150.,Oe,I2R(GetHeroStatBJ(bj_HEROSTAT_STR,GetAttacker(),false))*I2R(GetHeroLevel(GetAttacker())),ATTACK_TYPE_PIERCE,DAMAGE_TYPE_NORMAL)
call CreateTextTagUnitBJ("|cffff0000穿刺+"+(I2S(GetHeroStatBJ(bj_HEROSTAT_STR,GetAttacker(),false)*GetHeroLevel(GetAttacker()))+"！|r"),GetAttacker(),0,9.,100.,0.,0.,0)
call SetTextTagPermanent(GetLastCreatedTextTag(),false)
call SetTextTagVelocityBJ(GetLastCreatedTextTag(),40.,90)
call SetTextTagLifespan(GetLastCreatedTextTag(),2.)
call SetTextTagFadepoint(GetLastCreatedTextTag(),2.)
set Hn=1
else
if GetRandomInt(1,150)<=3+Hz[2]*3 and GetUnitAbilityLevelSwapped($41304C42,GetAttacker())>=1 then
call UnitDamagePointLoc(GetAttacker(),.1,150.,Oe,I2R(GetHeroStatBJ(bj_HEROSTAT_AGI,GetAttacker(),false))*I2R(GetHeroLevel(GetAttacker())),ATTACK_TYPE_MAGIC,DAMAGE_TYPE_NORMAL)
call CreateTextTagUnitBJ("|cffff0000魔法+"+(I2S(GetHeroStatBJ(bj_HEROSTAT_AGI,GetAttacker(),false)*GetHeroLevel(GetAttacker()))+"！|r"),GetAttacker(),0,9.,0.,100.,0.,0)
call SetTextTagPermanent(GetLastCreatedTextTag(),false)
call SetTextTagVelocityBJ(GetLastCreatedTextTag(),40.,90)
call SetTextTagLifespan(GetLastCreatedTextTag(),2.)
call SetTextTagFadepoint(GetLastCreatedTextTag(),2.)
set Hp=1
else
if GetRandomInt(1,100)<=0+Hz[4]*3 and GetUnitAbilityLevelSwapped($41304C44,GetAttacker())>=1 then
call UnitDamageTargetBJ(GetAttacker(),GetAttackedUnitBJ(),I2R(GetHeroLevel(GetAttacker()))*3000.,ATTACK_TYPE_HERO,DAMAGE_TYPE_ENHANCED)
call CreateTextTagUnitBJ("|cffff0000通用+*****",GetAttacker(),0,9.,0.,0.,100.,0)
call SetTextTagPermanent(GetLastCreatedTextTag(),false)
call SetTextTagVelocityBJ(GetLastCreatedTextTag(),40.,90)
call SetTextTagLifespan(GetLastCreatedTextTag(),2.)
call SetTextTagFadepoint(GetLastCreatedTextTag(),2.)
else
if GetRandomInt(1,150)<=6+Hz[3]*3 and GetUnitAbilityLevelSwapped($41304C45,GetAttacker())>=1 then
call UnitDamagePointLoc(GetAttacker(),.1,150.,Oe,I2R(GetHeroStatBJ(bj_HEROSTAT_INT,GetAttacker(),false))*I2R(GetHeroLevel(GetAttacker())),ATTACK_TYPE_CHAOS,DAMAGE_TYPE_NORMAL)
call CreateTextTagUnitBJ("|cffff0000混乱+"+(I2S(GetHeroStatBJ(bj_HEROSTAT_INT,GetAttacker(),false)*GetHeroLevel(GetAttacker()))+"！|r"),GetAttacker(),0,9.,0.,0.,100.,0)
call SetTextTagPermanent(GetLastCreatedTextTag(),false)
call SetTextTagVelocityBJ(GetLastCreatedTextTag(),40.,90)
call SetTextTagLifespan(GetLastCreatedTextTag(),2.)
call SetTextTagFadepoint(GetLastCreatedTextTag(),2.)
set Ho=1
else
call DoNothing()
endif
endif
endif
endif
call RemoveLocation(Oe)
endfunction
