set Ws=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(Ws,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(Ws,Condition(function BEg))
call TriggerAddAction(Ws,function BEh)
endfunction
