if GetRandomInt(1,10)==6 then
if GetHeroStatBJ(bj_HEROSTAT_INT,GetAttacker(),false)>=320 then
call CreateNUnitsAtLoc(1,$6E303447,GetOwningPlayer(GetAttacker()),Oe,bj_UNIT_FACING)
call SetUnitX(bj_lastCreatedUnit,GetUnitX(GetAttacker())+CosBJ(270.)*20.)
call UnitApplyTimedLifeBJ(3.+I2R(GC[GetConvertedPlayerId(GetOwningPlayer(GetAttacker()))]),$42726169,GetLastCreatedUnit())
else
if GetHeroStatBJ(bj_HEROSTAT_INT,GetAttacker(),false)>=260 then
call CreateNUnitsAtLoc(1,$6E303444,GetOwningPlayer(GetAttacker()),Oe,bj_UNIT_FACING)
call SetUnitX(bj_lastCreatedUnit,GetUnitX(GetAttacker())+CosBJ(270.)*20.)
call UnitApplyTimedLifeBJ(3.+I2R(GC[GetConvertedPlayerId(GetOwningPlayer(GetAttacker()))]),$42726169,GetLastCreatedUnit())
else
if GetHeroStatBJ(bj_HEROSTAT_INT,GetAttacker(),false)>=220 then
call CreateNUnitsAtLoc(1,$6E303448,GetOwningPlayer(GetAttacker()),Oe,bj_UNIT_FACING)
call SetUnitX(bj_lastCreatedUnit,GetUnitX(GetTriggerUnit())+CosBJ(270.)*20.)
call UnitApplyTimedLifeBJ(3.+I2R(GC[GetConvertedPlayerId(GetOwningPlayer(GetAttacker()))]),$42726169,GetLastCreatedUnit())
else
if GetHeroStatBJ(bj_HEROSTAT_INT,GetAttacker(),false)>=180 then
call CreateNUnitsAtLoc(1,$6E303443,GetOwningPlayer(GetAttacker()),Oe,bj_UNIT_FACING)
call SetUnitX(bj_lastCreatedUnit,GetUnitX(GetAttacker())+CosBJ(270.)*20.)
call UnitApplyTimedLifeBJ(3.+I2R(GC[GetConvertedPlayerId(GetOwningPlayer(GetAttacker()))]),$42726169,GetLastCreatedUnit())
else
if GetHeroStatBJ(bj_HEROSTAT_INT,GetAttacker(),false)>=140 then
call CreateNUnitsAtLoc(1,$6E303446,GetOwningPlayer(GetAttacker()),Oe,bj_UNIT_FACING)
call SetUnitX(bj_lastCreatedUnit,GetUnitX(GetAttacker())+CosBJ(270.)*20.)
call UnitApplyTimedLifeBJ(3.+I2R(GC[GetConvertedPlayerId(GetOwningPlayer(GetAttacker()))]),$42726169,GetLastCreatedUnit())
else
if GetHeroStatBJ(bj_HEROSTAT_INT,GetAttacker(),false)>=80 then
call CreateNUnitsAtLoc(1,$6E303445,GetOwningPlayer(GetAttacker()),Oe,bj_UNIT_FACING)
call SetUnitX(bj_lastCreatedUnit,GetUnitX(GetAttacker())+CosBJ(270.)*20.)
call UnitApplyTimedLifeBJ(3.+I2R(GC[GetConvertedPlayerId(GetOwningPlayer(GetAttacker()))]),$42726169,GetLastCreatedUnit())
else
if GetHeroStatBJ(bj_HEROSTAT_INT,GetAttacker(),false)<80 then
call CreateNUnitsAtLoc(1,$6E303433,GetOwningPlayer(GetAttacker()),Oe,bj_UNIT_FACING)
call SetUnitX(bj_lastCreatedUnit,GetUnitX(GetAttacker())+CosBJ(270.)*20.)
call UnitApplyTimedLifeBJ(3.+I2R(GC[GetConvertedPlayerId(GetOwningPlayer(GetAttacker()))]),$42726169,GetLastCreatedUnit())
else
call DoNothing()
endif
endif
endif
endif
endif
endif
endif
else
call DoNothing()
endif
call RemoveLocation(Oe)
endfunction
function BLo takes nothing returns nothing
set aH=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(aH,EVENT_PLAYER_UNIT_ATTACKED)
call TriggerAddCondition(aH,Condition(function BLm))
