function BHB takes nothing returns nothing
if GetSpellAbilityId()==$4130334B then
if GetUnitAbilityLevelSwapped(GetSpellAbilityId(),GetTriggerUnit())==1 then
call SetUnitAbilityLevelSwapped(GetSpellAbilityId(),GetTriggerUnit(),2)
else
call SetUnitAbilityLevelSwapped(GetSpellAbilityId(),GetTriggerUnit(),1)
endif
else
endif
if GetSpellAbilityId()==$41303439 and GetOwningPlayer(GetTriggerUnit())!=GetOwningPlayer(GetSpellTargetUnit()) then
if GetUnitAbilityLevelSwapped($4130334B,GetSpellTargetUnit())>=2 then
if GetUnitStateSwap(UNIT_STATE_MAX_MANA,GetSpellTargetUnit())==8. and GetPlayerState(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_GOLD)>=10000 then
call SetPlayerStateBJ(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(GetOwningPlayer(GetTriggerUnit()),PLAYER_STATE_RESOURCE_GOLD)-10000)
call SetPlayerStateBJ(GetOwningPlayer(GetSpellTargetUnit()),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(GetOwningPlayer(GetSpellTargetUnit()),PLAYER_STATE_RESOURCE_GOLD)+10000)
call SetPlayerStateBJ(GetOwningPlayer(GetSpellTargetUnit()),PLAYER_STATE_RESOURCE_LUMBER,GetPlayerState(GetOwningPlayer(GetSpellTargetUnit()),PLAYER_STATE_RESOURCE_LUMBER)+4)
call DisplayTextToPlayer(GetOwningPlayer(GetTriggerUnit()),0,0,"|cffff0303收购成功|r")
call DisplayTextToPlayer(GetOwningPlayer(GetSpellTargetUnit()),0,0,"|cffff0303被收购成功，获得10000金币、3木|r")
call SetUnitOwner(GetSpellTargetUnit(),GetOwningPlayer(GetSpellAbilityUnit()),true)
call UnitRemoveAbilityBJ($4130334B,GetSpellTargetUnit())
call RemoveItem(jr(GetSpellAbilityUnit(),$49303042))
else
call SetPlayerStateBJ(GetOwningPlayer(GetSpellTargetUnit()),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(GetOwningPlayer(GetSpellTargetUnit()),PLAYER_STATE_RESOURCE_GOLD)+1500)
call DisplayTextToPlayer(GetOwningPlayer(GetTriggerUnit()),0,0,"|cffff0303收购成功|r")
call DisplayTextToPlayer(GetOwningPlayer(GetSpellTargetUnit()),0,0,"|cffff0303被收购成功，获得1500金币|r")
call SetUnitOwner(GetSpellTargetUnit(),GetOwningPlayer(GetSpellAbilityUnit()),true)
call UnitRemoveAbilityBJ($4130334B,GetSpellTargetUnit())
call RemoveItem(jr(GetSpellAbilityUnit(),$49303042))
endif
else
call DisplayTextToPlayer(GetOwningPlayer(GetTriggerUnit()),0,0,"|cffff0303收购失败|r")
endif
else
call DoNothing()
endif
endfunction
function BHC takes nothing returns nothing
set X0=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(X0,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddAction(X0,function BHB)
endfunction
