function BQI takes nothing returns boolean
return GetSpellAbilityId()==$41304D44 or GetSpellAbilityId()==$41304D45
endfunction
function BQJ takes nothing returns nothing
set bo=GetUnitLoc(GetTriggerUnit())
set KM[GetConvertedPlayerId(GetTriggerPlayer())]=IF[GetConvertedPlayerId(GetTriggerPlayer())]
set KN[GetConvertedPlayerId(GetTriggerPlayer())]=FF[GetConvertedPlayerId(GetTriggerPlayer())]
if KM[GetConvertedPlayerId(GetTriggerPlayer())]>=10 then
set KM[GetConvertedPlayerId(GetTriggerPlayer())]=10
else
endif
if KN[GetConvertedPlayerId(GetTriggerPlayer())]>=10 then
set KN[GetConvertedPlayerId(GetTriggerPlayer())]=10.
else
endif
if GetUnitTypeId(GetTriggerUnit())==$48303553 or GetUnitTypeId(GetTriggerUnit())==$48303630 then
set IH[GetConvertedPlayerId(GetTriggerPlayer())]=I2R(GetHeroStatBJ(bj_HEROSTAT_AGI,GetTriggerUnit(),false)+IG[GetConvertedPlayerId(GetTriggerPlayer())])*40.*I2R(KM[GetConvertedPlayerId(GetTriggerPlayer())])+100.
set II[GetConvertedPlayerId(GetTriggerPlayer())]=I2R(GetHeroStatBJ(bj_HEROSTAT_INT,GetTriggerUnit(),false)+IG[GetConvertedPlayerId(GetTriggerPlayer())])*210.*KN[GetConvertedPlayerId(GetTriggerPlayer())]+200.
set IJ[GetConvertedPlayerId(GetTriggerPlayer())]=GetRandomReal(IH[GetConvertedPlayerId(GetTriggerPlayer())]/2.,IH[GetConvertedPlayerId(GetTriggerPlayer())])
set IK[GetConvertedPlayerId(GetTriggerPlayer())]=GetRandomReal(1.,II[GetConvertedPlayerId(GetTriggerPlayer())])
else
call DoNothing()
endif
if GetSpellAbilityId()==$41304D44 then
if GetUnitTypeId(GetTriggerUnit())==$6E303744 and DistanceBetweenPoints(bo,ZB)>=1000. then
if GetRandomInt(1,100)<=15 then
call UnitDamagePointLoc(GetTriggerUnit(),.2,900.,bo,IH[GetConvertedPlayerId(GetTriggerPlayer())]*4.,ATTACK_TYPE_HERO,DAMAGE_TYPE_ENHANCED)
call CreateTextTagUnitBJ("|cffff0303"+(I2S(R2I(IH[GetConvertedPlayerId(GetTriggerPlayer())]*6.))+"！|r"),GetTriggerUnit(),0,10.,100,60.,20.,0)
call SetTextTagPermanent(GetLastCreatedTextTag(),false)
call SetTextTagVelocityBJ(GetLastCreatedTextTag(),40.,60.)
call SetTextTagFadepoint(GetLastCreatedTextTag(),1.5)
call SetTextTagLifespan(GetLastCreatedTextTag(),1.5)
else
call UnitDamagePointLoc(GetTriggerUnit(),.2,900.,bo,IJ[GetConvertedPlayerId(GetTriggerPlayer())]/3.,ATTACK_TYPE_HERO,DAMAGE_TYPE_ENHANCED)
call CreateTextTagUnitBJ("|cffff0303"+(I2S(R2I(IJ[GetConvertedPlayerId(GetTriggerPlayer())]/2.))+"！|r"),GetTriggerUnit(),0,10.,100,0.,20.,0)
call SetTextTagPermanent(GetLastCreatedTextTag(),false)
call SetTextTagVelocityBJ(GetLastCreatedTextTag(),40.,60.)
call SetTextTagFadepoint(GetLastCreatedTextTag(),1.5)
call SetTextTagLifespan(GetLastCreatedTextTag(),1.5)
endif
else
if GetRandomInt(1,100)<=15 then
call UnitDamagePointLoc(GetTriggerUnit(),.2,900.,bo,IH[GetConvertedPlayerId(GetTriggerPlayer())]*12.,ATTACK_TYPE_HERO,DAMAGE_TYPE_ENHANCED)
call CreateTextTagUnitBJ("|cffff0303"+(I2S(R2I(IH[GetConvertedPlayerId(GetTriggerPlayer())]*12.))+"！|r"),GetTriggerUnit(),0,10.,100,60.,0.,0)
call SetTextTagPermanent(GetLastCreatedTextTag(),false)
call SetTextTagVelocityBJ(GetLastCreatedTextTag(),40.,60.)
call SetTextTagFadepoint(GetLastCreatedTextTag(),1.5)
call SetTextTagLifespan(GetLastCreatedTextTag(),1.5)
else
call UnitDamagePointLoc(GetTriggerUnit(),.2,900.,bo,IJ[GetConvertedPlayerId(GetTriggerPlayer())],ATTACK_TYPE_HERO,DAMAGE_TYPE_ENHANCED)
call CreateTextTagUnitBJ("|cffff0303"+(I2S(R2I(IJ[GetConvertedPlayerId(GetTriggerPlayer())]))+"！|r"),GetTriggerUnit(),0,10.,100,0.,0.,0)
call SetTextTagPermanent(GetLastCreatedTextTag(),false)
call SetTextTagVelocityBJ(GetLastCreatedTextTag(),40.,60.)
call SetTextTagFadepoint(GetLastCreatedTextTag(),1.5)
call SetTextTagLifespan(GetLastCreatedTextTag(),1.5)
endif
endif
else
call DoNothing()
endif
if GetSpellAbilityId()==$41304D45 then
if GetUnitTypeId(GetTriggerUnit())==$6E303744 and DistanceBetweenPoints(bo,ZB)>=1000. then
call UnitDamagePointLoc(GetTriggerUnit(),.2,900.,bo,IK[GetConvertedPlayerId(GetTriggerPlayer())]/3.,ATTACK_TYPE_HERO,DAMAGE_TYPE_NORMAL)
call CreateTextTagUnitBJ("|cffff0303"+(I2S(R2I(IK[GetConvertedPlayerId(GetTriggerPlayer())]/2.))+"！|r"),GetTriggerUnit(),0,10.,100,0.,20.,0)
call SetTextTagPermanent(GetLastCreatedTextTag(),false)
call SetTextTagVelocityBJ(GetLastCreatedTextTag(),40.,120.)
call SetTextTagFadepoint(GetLastCreatedTextTag(),1.5)
call SetTextTagLifespan(GetLastCreatedTextTag(),1.5)
else
call UnitDamagePointLoc(GetTriggerUnit(),.2,900.,bo,IK[GetConvertedPlayerId(GetTriggerPlayer())],ATTACK_TYPE_HERO,DAMAGE_TYPE_NORMAL)
call CreateTextTagUnitBJ("|cffff0303"+(I2S(R2I(IK[GetConvertedPlayerId(GetTriggerPlayer())]))+"！|r"),GetTriggerUnit(),0,10.,100,0.,0.,0)
call SetTextTagPermanent(GetLastCreatedTextTag(),false)
call SetTextTagVelocityBJ(GetLastCreatedTextTag(),40.,120.)
call SetTextTagFadepoint(GetLastCreatedTextTag(),1.5)
call SetTextTagLifespan(GetLastCreatedTextTag(),1.5)
endif
else
call DoNothing()
endif
call RemoveLocation(bo)
if GetUnitAbilityLevelSwapped($41304D48,GetTriggerUnit())==1 then
set IG[GetConvertedPlayerId(GetTriggerPlayer())]=GetHeroStatBJ(bj_HEROSTAT_STR,GetTriggerUnit(),false)
else
call DoNothing()
endif
if KH==1 and GetRandomInt(1,10)<=4 then
call UnitResetCooldown(GetTriggerUnit())
else
call DoNothing()
endif
endfunction
function BQK takes nothing returns nothing
