function BSW takes nothing returns nothing
set cv=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(cv,EVENT_PLAYER_UNIT_ATTACKED)
call TriggerAddCondition(cv,Condition(function BSU))
call TriggerAddAction(cv,function BSV)
endfunction
function BSX takes nothing returns nothing
call AddSpecialEffectLocBJ(ct,"Objects\\Spawnmodels\\Undead\\UndeadDissipate\\UndeadDissipate.mdl")
call DestroyEffect(GetLastCreatedEffectBJ())
if Kf==1 then
call ModifyHeroStat(bj_HEROSTAT_STR,SV,bj_MODIFYMETHOD_SUB,Kg*30)
else
if Kf==2 then
call ModifyHeroStat(bj_HEROSTAT_AGI,SV,bj_MODIFYMETHOD_SUB,Kg*30)
else
if Kf==3 then
call ModifyHeroStat(bj_HEROSTAT_INT,SV,bj_MODIFYMETHOD_SUB,Kg*30)
else
endif
endif
endif
set Kg=GetUnitAbilityLevelSwapped($41305133,SV)
if GetRandomInt(1,3)==1 then
call ModifyHeroStat(bj_HEROSTAT_STR,SV,bj_MODIFYMETHOD_ADD,Kg*30)
if IV[GetConvertedPlayerId(GetOwningPlayer(SV))]>=1 or lo(GetOwningPlayer(SV),"赞+7")>=700 then
call SetUnitVertexColor(SV,255,100,0,255)
else
endif
set Kf=1
else
