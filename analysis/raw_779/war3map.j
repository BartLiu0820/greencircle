function BSJ takes nothing returns nothing
set cq=GetUnitLoc(GetAttackedUnitBJ())
if KV>=6+400/GetHeroStatBJ(bj_HEROSTAT_AGI,GetAttacker(),false) then
call CreateNUnitsAtLoc(1,$68303655,GetOwningPlayer(GetAttacker()),cq,bj_UNIT_FACING)
call UnitApplyTimedLifeBJ(2.,$42487765,GetLastCreatedUnit())
call IssueTargetOrder(GetLastCreatedUnit(),"bloodlust",GetAttacker())
set KV=0
else
call DoNothing()
endif
if GetRandomInt(1,100)<=GetUnitAbilityLevelSwapped($41305050,GetAttacker())*(6+Ky[GetConvertedPlayerId(GetTriggerPlayer())]) then
set KR=KQ+GetHeroStatBJ(bj_HEROSTAT_AGI,GetAttacker(),false)*2
call CreateTextTagUnitBJ(I2S(KR),GetAttacker(),0,11.,100.,50.,0.,0)
call SetTextTagPermanent(GetLastCreatedTextTag(),false)
call SetTextTagVelocityBJ(GetLastCreatedTextTag(),100.,90.)
call SetTextTagFadepoint(GetLastCreatedTextTag(),1.)
call SetTextTagLifespan(GetLastCreatedTextTag(),1.)
call UnitDamagePointLoc(GetAttacker(),.25,100.,cq,I2R(KR),ATTACK_TYPE_HERO,DAMAGE_TYPE_ENHANCED)
else
if R2I(I2R(KP+GetHeroStatBJ(bj_HEROSTAT_INT,GetAttacker(),false)*5)*(1.+KW[GetConvertedPlayerId(GetOwningPlayer(GetAttacker()))]+I2R(GetUnitAbilityLevelSwapped($41305051,GetAttacker()))*.05))>KQ+GetHeroStatBJ(bj_HEROSTAT_AGI,GetAttacker(),false)*2 then
set KR=R2I(I2R(KP+GetHeroStatBJ(bj_HEROSTAT_INT,GetAttacker(),false)*5)*(1.+KW[GetConvertedPlayerId(GetOwningPlayer(GetAttacker()))]+I2R(GetUnitAbilityLevelSwapped($41305051,GetAttacker()))*.05))
call CreateTextTagUnitBJ(I2S(KR),GetAttacker(),0,11.,100.,0.,0.,0)
call SetTextTagPermanent(GetLastCreatedTextTag(),false)
call SetTextTagVelocityBJ(GetLastCreatedTextTag(),100.,90.)
call SetTextTagFadepoint(GetLastCreatedTextTag(),1.)
call SetTextTagLifespan(GetLastCreatedTextTag(),1.)
call UnitDamagePointLoc(GetAttacker(),.25,100.,cq,I2R(KR),ATTACK_TYPE_HERO,DAMAGE_TYPE_ENHANCED)
else
set KR=GetRandomInt(R2I(I2R(KP+GetHeroStatBJ(bj_HEROSTAT_INT,GetAttacker(),false)*5)*(1.+KW[GetConvertedPlayerId(GetOwningPlayer(GetAttacker()))]+I2R(GetUnitAbilityLevelSwapped($41305051,GetAttacker()))*.05)),KQ+GetHeroStatBJ(bj_HEROSTAT_AGI,GetAttacker(),false)*2)
call CreateTextTagUnitBJ(I2S(KR),GetAttacker(),0,11.,100.,0.,0.,0)
