function BSM takes nothing returns nothing
if GetSpellAbilityId()==$41305054 then
set KU=1
call UnitDamageTargetBJ(GetTriggerUnit(),GetSpellTargetUnit(),I2R(KQ+GetHeroStatBJ(bj_HEROSTAT_AGI,GetTriggerUnit(),false)*2)*5.,ATTACK_TYPE_HERO,DAMAGE_TYPE_ENHANCED)
call CreateTextTagUnitBJ(I2S((KQ+GetHeroStatBJ(bj_HEROSTAT_AGI,GetTriggerUnit(),false)*2)*5),GetSpellTargetUnit(),0,11.,100.,0.,0.,0)
call SetTextTagPermanent(GetLastCreatedTextTag(),false)
call SetTextTagVelocityBJ(GetLastCreatedTextTag(),100.,90.)
call SetTextTagFadepoint(GetLastCreatedTextTag(),1.)
call SetTextTagLifespan(GetLastCreatedTextTag(),1.)
if GetUnitAbilityLevelSwapped($41303431,GetSpellTargetUnit())>=1 or GetUnitAbilityLevelSwapped($41303430,GetSpellTargetUnit())>=1 or GetUnitAbilityLevelSwapped($41303432,GetSpellTargetUnit())>=1 or GetUnitAbilityLevelSwapped($41303434,GetSpellTargetUnit())>=1 or GetUnitAbilityLevelSwapped($41303433,GetSpellTargetUnit())>=1 then
if GetRandomInt(1,20)==3 then
set KT=GetRandomInt(GetUnitAbilityLevelSwapped($41305053,GetTriggerUnit())*130+100,GetUnitAbilityLevelSwapped($41305053,GetTriggerUnit())*130+100)
set KS=GetRandomInt(GetUnitAbilityLevelSwapped($41305053,GetTriggerUnit())*130+100,GetUnitAbilityLevelSwapped($41305053,GetTriggerUnit())*130+100)
else
