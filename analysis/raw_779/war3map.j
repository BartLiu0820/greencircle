function BUl takes nothing returns nothing
if GetUnitAbilityLevelSwapped(GetSpellAbilityId(),GetTriggerUnit())<6 then
if GetHeroLevel(GetTriggerUnit())>=GetUnitAbilityLevelSwapped(GetSpellAbilityId(),GetTriggerUnit())*6+0 then
if GetPlayerState(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_GOLD)>=GetUnitAbilityLevelSwapped(GetSpellAbilityId(),GetTriggerUnit())*1000+3000 then
call SetPlayerStateBJ(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(GetTriggerPlayer(),PLAYER_STATE_RESOURCE_GOLD)-(GetUnitAbilityLevelSwapped(GetSpellAbilityId(),GetTriggerUnit())*1000+3000))
call IncUnitAbilityLevelSwapped(GetSpellAbilityId(),GetTriggerUnit())
call SetPlayerTechMaxAllowedSwap($6830384F,0,GetTriggerPlayer())
set Mk[GetConvertedPlayerId(GetTriggerPlayer())]=Mk[GetConvertedPlayerId(GetTriggerPlayer())]+1
call SetPlayerTechMaxAllowedSwap($68303851,Mk[GetConvertedPlayerId(GetTriggerPlayer())],GetTriggerPlayer())
call DisplayTimedTextToPlayer(GetOwningPlayer(GetTriggerUnit()),0,0,5.,"|cffff0303成功提升|r")
else
call DisplayTimedTextToPlayer(GetOwningPlayer(GetTriggerUnit()),0,0,5.,"|cffff0303金币不足|r")
endif
else
call DisplayTimedTextToPlayer(GetOwningPlayer(GetTriggerUnit()),0,0,5.,"|cffff0303等级不足|r")
endif
else
call DisplayTimedTextToPlayer(GetOwningPlayer(GetTriggerUnit()),0,0,5.,"|cffff0303已提升最大个数|r")
endif
endfunction
